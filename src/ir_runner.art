; ir_runner.art — run a program file as compiled IR in its own
; process: emit -> fold -> runIR. Stdout is the program's stdout.
import ./"ir.art"
import ./"modules.art"

go: function [][
    if 0 < size args\values [
        src: resolveImportsFromFile args\values\0
        ir: foldIR (compileToIR src)
        runIR ir
    ]
]
go
