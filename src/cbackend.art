;=======================================================
; cbackend.art — the C backend (real fix)
;
; v2: compileToIR + fold -> emit C source that rebuilds the
; IR tree with the native runtime's builders and runs it.
; The per-program step is `gcc -c` + link against the
; prebuilt runtime.a -> instant, standalone native binary.
;=======================================================

import ./"ir.art"

; escape a string for a C double-quoted literal: backslash first,
; then the double-quote. `replace` scans left to right, so escaping
; the backslash first keeps the freshly-added \" pairs from doubling.
escapeC: function [s][
    s: replace s "\\" "\\\\"
    s: replace s "\"" "\\\""
    s: replace s "\n" "\\n"
    s: replace s "\t" "\\t"
    s: replace s "\r" "\\r"
    s
]
quoteC: function [s][ "\"" ++ (escapeC s) ++ "\"" ]

; A null VALUE is a leaf constant. It must be emitted directly and NEVER passed
; to an emitter function: on this host, calling an imported function with a null
; argument corrupts the value stack — the call returns the function object
; instead of its result (and the corruption propagates up through the whole
; emission). So every cNode/cValue call site guards null first, emitting the
; constant inline. This is why null is absent from cNode's cases below.
cNullConst: "ir_const(v_null())"

; render an Arturo constant as a C runtime expression.
cValue: function [v][
    t: type v
    case t [
        :integer -> "v_int(" ++ (to :string v) ++ ")"
        :floating -> "v_float(" ++ (to :string v) ++ ")"
        :logical -> "v_bool(" ++ (to :string (to :integer v)) ++ ")"
        :char    -> "v_char('" ++ (to :string v) ++ "')"
        :string  -> "v_str(" ++ (quoteC v) ++ ")"
        :word    -> "v_str(" ++ (quoteC (to :string v)) ++ ")"
        :label   -> "v_str(" ++ (quoteC (to :string v)) ++ ")"
        :literal -> "v_str(" ++ (quoteC (to :string v)) ++ ")"
        :symbol  -> "v_str(" ++ (quoteC (to :string v)) ++ ")"
        :pathliteral -> cPath v
        :type    -> "v_str(" ++ (quoteC (":" ++ (to :string v))) ++ ")"
        :null    -> "v_null()"
    ]
]

; a path literal `'c\stack` -> a C v_path() carrying its segments as strings.
cPath: function [v][
    parts: map (to :block v) [seg][ quoteC (to :string seg) ]
    segc: joinWith parts ", "
    "v_path((char*[]){" ++ segc ++ "}, " ++ (to :string (size (to :block v))) ++ ")"
]

; a dynamic path expression (`spec\arity` read, `res\[k]` write) is NOT a
; constant and CANNOT be resolved at block-build time (loop params are not yet
; bound). It emits as a v_path VALUE whose segments are tagged: "@DYN" marks it
; dynamic (vs a pathliteral which is data), a bare name is a variable segment,
; and a ":"-prefixed name is a literal key. The runtime's block-as-code
; evaluator resolves it lazily, per iteration — as a read in expression position
; or a write when it heads a statement.
cPathSegKey: function [seg][
    ts: type seg
    if :literal = ts [ return quoteC (":" ++ (to :string seg)) ]
    if :label = ts   [ return quoteC (":" ++ (to :string seg)) ]
    if :block = ts   [ return cPathSegKey (first seg) ]
    quoteC (to :string seg)   ; a word → bare variable name
]
cPathNode: function [v][
    blk: to :block v
    tail: blk\1
    tailSegs: @[tail]
    if :block = type tail [ tailSegs: tail ]
    basec: quoteC (to :string blk\0)
    segc: map tailSegs [seg][ cPathSegKey seg ]
    all: @[quoteC "@DYN" basec]
    loop segc [s][ all: all ++ @[s] ]
    joined: joinWith all ", "
    ; wrapped in ir_const so it is an IR node inside a block, resolving to the
    ; V_PATH value (unresolved) when the block value is built.
    "ir_const(v_path((char*[]){" ++ joined ++ "}, " ++ (to :string (size all)) ++ "))"
]

; ---- recursive emitter -----------------------------------------------------

; a raw seq (Arturo block of IR nodes) -> an internal __seq node.
; NB `map`/`joinWith` over an empty block yield a phantom null in this host,
; so every list must be size-guarded before joining.
cSeq: function [items][
    if 0 = size items [ return "ir_seq((IR*[]){}, 0)" ]
    parts: map items [st][
        r: cNullConst
        if not? :null = type st [ r: cNode st ]
        r
    ]
    bodyc: joinWith parts ", "
    "ir_seq((IR*[]){" ++ bodyc ++ "}, " ++ (to :string (size items)) ++ ")"
]

; an item inside a block VALUE (op:"block"): a nested raw `:block` is DATA (a
; value), so it emits as a block VALUE — NOT a statement sequence. Everything
; else defers to cNode.
cBlockItem: function [st][
    if :null = type st [ return cNullConst ]
    if :block = type st [ return cBlock st ]
    if :inline = type st [ return cBlock (to :block st) ]
    cNode st
]

; an evaluated block VALUE (op:"block"): items become a V_BLOCK
cBlock: function [items][
    if 0 = size items [ return "ir_block((IR*[]){}, 0)" ]
    parts: map items [st][
        r: cNullConst
        if not? :null = type st [ r: cBlockItem st ]
        r
    ]
    bodyc: joinWith parts ", "
    "ir_block((IR*[]){" ++ bodyc ++ "}, " ++ (to :string (size items)) ++ ")"
]

; a call node
; an intrinsic used as a CALL CALLEE: bare ir_intrinsic, so the runtime's call
; handler (callIntrinsic) dispatches it by name. (In VALUE position an intrinsic
; must be a zero-arity call, not this marker — see cNode's intrinsic arm.)
cCallee: function [fn][
    if :dictionary = type fn [
        if fn\op = "intrinsic" [
            return "ir_intrinsic(" ++ (quoteC (to :string fn\name)) ++ ")"
        ]
    ]
    cNode fn
]
; the mutating builtins take a REFERENCE as arg 0 (`insert 'c ...`, `append
; 'c\stack`, `pop 'box\list`). A `[op:passthrough src:<:literal>]` receiver is a
; single quoted word `'x` — a write-back reference to a variable. Elsewhere a
; `:literal` is a plain string (a dict key, e.g. `get args "values"`), so the
; reference must be decided here, by the callee, not in the generic passthrough
; arm. A `:pathliteral` receiver (`'a\b`) already emits as a real v_path.
cMutating?: function [fn][
    if :dictionary = type fn [
        if fn\op = "intrinsic" [
            nm: to :string fn\name
            ; Mutation metadata is generated from Arturo's declared
            ; PathLiteral arguments. Keeping a second hand-written list here
            ; silently dropped every newly implemented mutator.
            return mutatesThroughRef? nm
        ]
    ]
    false
]
cRefNode: function [a][
    if :dictionary = type a [
        if a\op = "passthrough" [
            if :literal = type a\src [
                return "ir_passthrough(v_path((char*[]){" ++ (quoteC (to :string a\src)) ++ "}, 1))"
            ]
        ]
    ]
    cNode a
]
cCall: function [n][
    args: n\args
    fnc: cCallee n\fn
    mut?: cMutating? n\fn
    ; a bare word in VALUE position arrives as a 0-arity call whose callee is an
    ; intrinsic (`env`, `arity`, `node`, `define` are all in the intrinsics table
    ; yet bound as params/functions in the compiler source). Emit `ir_word`, whose
    ; runtime load-if-bound returns the VALUE without applying it — `ir_intrinsic`
    ; here would APPLY the bound function with 0 args (callIntrinsic resolves
    ; bound-first) and crash on `define`'s env-set.
    if 0 = size args [
        if :dictionary = type n\fn [
            if "intrinsic" = n\fn\op [
                return "ir_word(" ++ (quoteC (to :string n\fn\name)) ++ ")"
            ]
        ]
        return "ir_call(" ++ fnc ++ ", (IR*[]){}, 0)"
    ]
    ; build each arg as a bound temp before accumulating: a deep cNode result
    ; (a nested call, a block) built through a long `++` chain leaks the host
    ; value stack if it is inlined or mapped inline, corrupting siblings.
    parts: @[]
    argi: 0
    loop args [a][
        if :null = type a [ parts: parts ++ @[cNullConst] ]
        if not? :null = type a [
            pa: cNode a
            ; only arg 0 of a mutating builtin is the reference receiver; the
            ; later args (e.g. `set`'s key, `insert`'s value) are plain values.
            if and? mut? 0 = argi [ pa: cRefNode a ]
            parts: parts ++ @[pa]
        ]
        argi: argi + 1
    ]
    argc: joinWith parts ", "
    copen: "ir_call(" ++ fnc ++ ", (IR*[]){"
    cclose: "}, " ++ (to :string (size args)) ++ ")"
    copen ++ argc ++ cclose
]

; a function node: args = [params, bodySeq]
cFunction: function [n][
    args: n\args
    params: args\0
    body: args\1
    if 0 = size params [
        if 0 = size body [ return "ir_fn(ir_block((IR*[]){}, 0), (IR*[]){}, 0)" ]
        parts: map body [st][
            r: cNullConst
            if not? :null = type st [ r: cNode st ]
            r
        ]
        bodyc: joinWith parts ", "
        return "ir_fn(ir_block((IR*[]){}, 0), (IR*[]){" ++ bodyc ++ "}, " ++ (to :string (size body)) ++ ")"
    ]
    parts: map params [w][ "ir_load(" ++ (quoteC (to :string w)) ++ ")" ]
    paramc: joinWith parts ", "
    paramsIR: "ir_block((IR*[]){" ++ paramc ++ "}, " ++ (to :string (size params)) ++ ")"
    parts: map body [st][
        r: cNullConst
        if not? :null = type st [ r: cNode st ]
        r
    ]
    bodyc: joinWith parts ", "
    "ir_fn(" ++ paramsIR ++ ", (IR*[]){" ++ bodyc ++ "}, " ++ (to :string (size body)) ++ ")"
]

; an if node: args = [cond, yesSeq, maybeElseOrNull]
cIf: function [n][
    args: n\args
    condc: cNode args\0
    yesc: cNode args\1
    if 2 < size args [
        elsev: args\2
        if :null = type elsev [
            return "ir_op(\"if\", (IR*[]){" ++ condc ++ ", " ++ yesc ++ "}, 2)"
        ]
        elsec: cNode elsev
        return "ir_op(\"if\", (IR*[]){" ++ condc ++ ", " ++ yesc ++ ", " ++ elsec ++ "}, 3)"
    ]
    "ir_op(\"if\", (IR*[]){" ++ condc ++ ", " ++ yesc ++ "}, 2)"
]
cUnless: function [n][
    condc: cNode n\args\0
    actionc: cNode n\args\1
    "ir_op(\"unless\", (IR*[]){" ++ condc ++ ", " ++ actionc ++ "}, 2)"
]
cSwitch: function [n][
    condc: cNode n\args\0
    yesc: cNode n\args\1
    noc: cNode n\args\2
    "ir_op(\"switch\", (IR*[]){" ++ condc ++ ", " ++ yesc ++ ", " ++ noc ++ "}, 3)"
]
cWhen: function [n][
    parts: @[]
    loop n\args [a][ addItem parts (cNode a) ]
    "ir_op(\"when\", (IR*[]){" ++ (joinWith parts ", ") ++ "}, " ++ (to :string (size n\args)) ++ ")"
]
cUsing: function [n][
    valuec: cNode n\args\0
    bodyc: cNode n\args\1
    "ir_op(\"using\", (IR*[]){" ++ valuec ++ ", " ++ bodyc ++ "}, 2)"
]
cTry: function [n][
    bodyc: cNode n\args\0
    "ir_op(\"try\", (IR*[]){" ++ bodyc ++ "}, 1)"
]
cThrows: function [n][
    bodyc: cNode n\args\0
    "ir_op(\"throws?\", (IR*[]){" ++ bodyc ++ "}, 1)"
]
cEnsure: function [n][
    bodyc: cNode n\args\0
    "ir_op(\"ensure\", (IR*[]){" ++ bodyc ++ "}, 1)"
]

; ---- complex (computed-key) paths -----------------------------------------
; A dynamic path with a simple key (`\[k]`, `spec\arity`) emits as a flat
; v_path value and the runtime's path_read/path_write resolves it. A key that
; must be evaluated at run time (`\[spec\alias]`, `\[c\i + 1]`) CANNOT be a flat
; string: the runtime's block-as-code evaluator must compute it. Such a path
; emits as a get/set call-BLOCK that the evaluator runs. Reads become
; `[get, base, [key...]]`; writes `[set, base, [key...]]` (value follows).

; a segment that is a static key (literal/label, or a plain word, or a block of
; one of those) needs no runtime evaluation → it can stay a flat path segment.
cPathSimpleSeg?: function [seg][
    ts: type seg
    if or? (= :literal ts) (= :label ts) [ return true ]
    if :word = ts [ return true ]
    if :block = ts [
        ; a `\[k]` key is simple (a bare variable word); a `\[i + 1]` or
        ; `\[c\i]` key is an EXPRESSION and must be evaluated at run time.
        if 1 <> size seg [ return false ]
        return cPathSimpleSeg? (first seg)
    ]
    false
]
cPathAllSimple: function [v][
    blk: to :block v
    loop 1..dec (size blk) [j][
        if not? cPathSimpleSeg? blk\[j] [ return false ]
    ]
    true
]

; a path segment → an ir_block whose tokens evaluate to the key string at run
; time (used as the get/set key argument).
cPathKeyBlock: function [seg][
    if :null = type seg [ return cNullConst ]
    if :block = type seg [
        toks: to :block seg
        if 0 = size toks [ return "ir_block((IR*[]){}, 0)" ]
        parts: map toks [tk][
            r: cNullConst
            if not? :null = type tk [ r: cNode tk ]
            r
        ]
        return "ir_block((IR*[]){" ++ (joinWith parts ", ") ++ "}, " ++ (to :string (size toks)) ++ ")"
    ]
    "ir_block((IR*[]){" ++ (cNode seg) ++ "}, 1)"
]

; `base\[k1]\[k2]` (read) → `[get, [get, base, [k1]], [k2]]`, a block value the
; evaluator runs to produce the read.
cPathComplexRead: function [v][
    blk: to :block v
    baseName: to :string blk\0
    expr: "ir_const(v_str(" ++ (quoteC baseName) ++ "))"
    loop 1..dec (size blk) [j][
        kb: cPathKeyBlock blk\[j]
        expr: "ir_block((IR*[]){ir_const(v_str(\"get\")), " ++ expr ++ ", " ++ kb ++ "}, 3)"
    ]
    expr
]

; `base\[key]: val` (write) → a block value `[set, base, [key]]`; the runtime's
; evalSeq consumes the following token as the value.
cPathComplexWrite: function [v][
    blk: to :block v
    baseName: to :string blk\0
    kb: cPathKeyBlock blk\1
    "ir_block((IR*[]){ir_const(v_str(\"set\")), ir_const(v_str(" ++ (quoteC baseName) ++ ")), " ++ kb ++ "}, 3)"
]

; a path SEGMENT used as a `get` key (for a passthrough path read). A numeric
; literal (`\0`) is an int (block index); a named literal (`\foo`) is a string
; (dict key); a word is a variable read; a `[...]` block is a computed key.
; true iff every char of s is a decimal digit (a numeric path segment).
; Written with only runtime builtins (no regex, no `in?`): the C runtime
; iterates a string as chars and `contains?` does a substring test.
isAllDigits: function [s][
    if 0 = size s [ return false ]
    ok: true
    loop s [ch][
        if not? contains? "0123456789" ch [ ok: false ]
    ]
    ok
]
cPathKeyNode: function [seg][
    ts: type seg
    if :block = ts [ return cPathKeyBlock seg ]
    if :word = ts [ return cNode seg ]
    if :label = ts [ return "ir_const(v_str(" ++ (quoteC (to :string seg)) ++ "))" ]
    if :literal = ts [
        s: to :string seg
        if isAllDigits s [ return "ir_const(v_int(" ++ s ++ "))" ]
        return "ir_const(v_str(" ++ (quoteC s) ++ "))"
    ]
    cNode seg
]

; a dynamic path read in VALUE position (the `src` of a passthrough, e.g. a
; dict value `params: argv\0`): the ART backend renders this as `get argv 0`,
; so emit the same get-CALL — runNode resolves it to the read value. Nested
; segments (`a\0\1`) become nested gets.
cPathReadCall: function [v][
    blk: to :block v
    baseName: to :string blk\0
    expr: "ir_load(" ++ (quoteC baseName) ++ ")"
    loop 1..dec (size blk) [j][
        kc: cPathKeyNode blk\[j]
        expr: "ir_call(ir_intrinsic(\"get\"), (IR*[]){" ++ expr ++ ", " ++ kc ++ "}, 2)"
    ]
    expr
]

cNode: function [n][
    ; A null VALUE must never reach here: every caller guards first (passing a
    ; null arg to this imported function would corrupt the host and return the
    ; function object). This guard is a final backstop only.
    if :null = type n [ return cNullConst ]
    ; a raw `:block` VALUE is a STATEMENT SEQUENCE (a `do` body, a `while`/`if`
    ; body or condition): its items are evaluated in order and the last is the
    ; result. (Nested block VALUES inside it are op:"block" DICTS, handled by the
    ; `case op "block"` arm, and stay DATA.) A raw `:block` nested as a data item
    ; inside an action-body block VALUE reaches cNode via the block-value item
    ; emitter cBlockItem (below), which treats it as data, so it never arrives
    ; here as the statement-sequence case.
    if :block = type n [ return cSeq n ]
    ; an inline (parenthesized) block like `(size n)` in an action: emit it as a
    ; block VALUE so the runtime's block-as-code evaluator evaluates it as a
    ; sub-expression (it sees the words as code, not data).
    if :inline = type n [ return cBlock (to :block n) ]
    t: type n
    ; a dynamic path (rvalue `spec\arity` or lvalue `res\[k]`) resolves at run
    ; time, not as a constant. `:pathliteral` (`'c\stack`) is data and stays const.
    if or? (= :path t) (= :pathlabel t) [
        if cPathAllSimple n [ return cPathNode n ]
        if :path = t [ return cPathComplexRead n ]
        return cPathComplexWrite n
    ]
    ; a label heads a define (`x: val`) inside a block-as-code action body; it is
    ; tagged so the runtime's interpreter can tell it from a variable read.
    if :label = t [ return "ir_const(v_str(" ++ (quoteC ("@LBL:" ++ (to :string n))) ++ "))" ]
    ; a raw primitive (integer, string, word, ...) is a constant node. The null
    ; case was handled above; cValue is never handed a null.
    if not? :dictionary = t [ return "ir_const(" ++ (cValue n) ++ ")" ]
    op: n\op
    ; HOST QUIRK: a deep cNode result passed INLINE into a `++` corrupts sibling
    ; block items (the value-stack leak), so the deep-call arms live in helper
    ; functions that bind the result to a name before concatenating. Likewise a
    ; null constant value (a `const`/`passthrough` node holding null) is emitted
    ; inline rather than through cValue. (A `case` arm whose RHS is a literal
    ; block would return the block as DATA, so these null checks are early
    ; returns, not case arms.)
    if op = "const" [
        if :null = type n\value [ return cNullConst ]
        return "ir_const(" ++ (cValue n\value) ++ ")"
    ]
    if op = "passthrough" [
        if :null = type n\src [ return "ir_passthrough(v_null())" ]
        ts: type n\src
        ; a dynamic path read in value position (`params: argv\0`) resolves as a
        ; get-call, exactly as the ART backend renders it. A `:pathliteral`
        ; (`'c\stack`) is data and stays a passthrough carrying a v_path value.
        if :path = ts [ return cPathReadCall n\src ]
        if :pathlabel = ts [ return cPathReadCall n\src ]
        return "ir_passthrough(" ++ (cValue n\src) ++ ")"
    ]
    case op [
        "load"         -> "ir_load(" ++ (quoteC (to :string n\name)) ++ ")"
        ; an intrinsic in VALUE position is a bare word: resolve var-first, else
        ; call a zero-arity builtin (`args`, `break`), else a builtin function
        ; value. `ir_word` does this at runtime; a bound param named like a
        ; construct (`arity`, `env`) loads its value, and `args` as the base of
        ; `args\values` is called. As a CALL CALLEE it must stay bare
        ; ir_intrinsic — cCallee handles that.
        "intrinsic"    -> "ir_word(" ++ (quoteC (to :string n\name)) ++ ")"
        "define"       -> cDefine n
        "let"          -> cLet n
        "break"        -> "ir_op(\"break\", NULL, 0)"
        "continue"     -> "ir_op(\"continue\", NULL, 0)"
        "block"        -> cBlock n\items
        "call"         -> cCall n
        "function"     -> cFunction n
        "do"           -> cDo n
        "if"           -> cIf n
        "unless"       -> cUnless n
        "switch"       -> cSwitch n
        "when"         -> cWhen n
        "using"        -> cUsing n
        "try"          -> cTry n
        "throws?"      -> cThrows n
        "ensure"       -> cEnsure n
        "while"        -> cWhile n
        "until"        -> cUntil n
        "loop"         -> cLoop n
        "range"        -> cRange n
        "return"       -> cReturn n
    ]
]

; the deep-call arms, extracted so their result is bound before concatenation
; (avoids the host value-stack corruption when a deep cNode is inlined in `++`).
cDefine: function [n][
    e: cNullConst
    if not? :null = type n\expr [ e: cNode n\expr ]
    "ir_define(" ++ (quoteC (to :string n\name)) ++ ", " ++ e ++ ")"
]
cLet: function [n][
    e: cNullConst
    if not? :null = type n\expr [ e: cNode n\expr ]
    "ir_let(" ++ (quoteC (to :string n\name)) ++ ", " ++ e ++ ")"
]
cDo: function [n][
    a: cNode n\args\0
    "ir_op(\"do\", (IR*[]){" ++ a ++ "}, 1)"
]
cWhile: function [n][
    a: cNode n\args\0
    b: cNode n\args\1
    "ir_op(\"while\", (IR*[]){" ++ a ++ ", " ++ b ++ "}, 2)"
]
cUntil: function [n][
    a: cNode n\args\0
    b: cNode n\args\1
    "ir_op(\"until\", (IR*[]){" ++ a ++ ", " ++ b ++ "}, 2)"
]
cLoop: function [n][
    coll: cNode n\args\0
    params: cBlock n\args\1
    body: cNode n\args\2
    "ir_op(\"loop\", (IR*[]){" ++ coll ++ ", " ++ params ++ ", " ++ body ++ "}, 3)"
]
cRange: function [n][
    fromc: cNode n\args\0
    toc: cNode n\args\1
    "ir_op(\"range\", (IR*[]){" ++ fromc ++ ", " ++ toc ++ "}, 2)"
]
cReturn: function [n][
    a: cNullConst
    if not? :null = type n\args\0 [ a: cNode n\args\0 ]
    "ir_op(\"return\", (IR*[]){" ++ a ++ "}, 1)"
]

; ---- full C program ---------------------------------------------------------
; A direct-C leaf does not need the dynamic Value model, IR builders, or runSeq.
; The folder has already evaluated pure constant calls, so constant prints emit
; as libc I/O. Safe dynamic statements may be interleaved as individual runNode
; calls; structural control flow falls back to one runSeq so return/break keeps
; its sequence-wide behavior.
directStmt: function [n][
    if :dictionary <> type n [ return "" ]
    if "call" <> n\op [ return "" ]
    if :dictionary <> type n\fn [ return "" ]
    if "intrinsic" <> n\fn\op [ return "" ]
    if "print" <> n\fn\name [ return "" ]
    if 1 <> size n\args [ return "" ]
    a: n\args\0
    if :dictionary <> type a [ return "" ]
    if "const" <> a\op [ return "" ]
    if :null = type a\value [ return "puts(\"null\");" ]
    t: type a\value
    if :string = t [ return "puts(" ++ (quoteC a\value) ++ ");" ]
    if :integer = t [ return "puts(" ++ (quoteC (to :string a\value)) ++ ");" ]
    if :floating = t [ return "rt_print_float((double)" ++ (to :string a\value) ++ ");" ]
    if :char = t [ return "fputs(" ++ (quoteC (to :string a\value)) ++ ", stdout); putchar('\\n');" ]
    if :logical = t [
        if a\value [ return "puts(\"true\");" ]
        return "puts(\"false\");"
    ]
    ""
]

; ---- typed native lowering -------------------------------------------------
; This is the real AOT path for the statically typed scalar subset. Values are
; C scalars, definitions are C locals, pure intrinsic calls are C expressions,
; and if/while become C control flow. A single unsupported value rejects this
; whole path; directProgram below can still pick direct/hybrid IR statement
; emission, and the final fallback remains the complete dynamic runtime.
nativeResult: function [ok kind code][
    r: #[]
    r\ok: ok
    r\kind: kind
    r\code: code
    r
]
nativeFail: function [][ nativeResult false "" "" ]

nativeNumeric?: function [kind][
    if "int" = kind [ return true ]
    if "float" = kind [ return true ]
    false
]

nativeExpr: function [n state][
    if :dictionary <> type n [
        if :null = type n [ return nativeResult true "null" "0" ]
        rawType: type n
        if :integer = rawType [ return nativeResult true "int" (to :string n) ]
        if :floating = rawType [ return nativeResult true "float" (to :string n) ]
        if :string = rawType [ return nativeResult true "string" (quoteC n) ]
        if :word = rawType [ return nativeResult true "string" (quoteC (to :string n)) ]
        if :literal = rawType [ return nativeResult true "string" (quoteC (to :string n)) ]
        if :symbol = rawType [ return nativeResult true "string" (quoteC (to :string n)) ]
        if :type = rawType [ return nativeResult true "string" (quoteC (":" ++ (to :string n))) ]
        if :logical = rawType [
            if n [ return nativeResult true "bool" "1" ]
            return nativeResult true "bool" "0"
        ]
        return nativeFail
    ]
    if not? key? n "op" [ return nativeFail ]
    op: n\op
    if "passthrough" = op [ return nativeExpr n\src state ]
    if "const" = op [
        if :null = type n\value [ return nativeResult true "null" "0" ]
        t: type n\value
        if :integer = t [ return nativeResult true "int" (to :string n\value) ]
        if :floating = t [ return nativeResult true "float" (to :string n\value) ]
        if :string = t [ return nativeResult true "string" (quoteC n\value) ]
        if :type = t [ return nativeResult true "string" (quoteC (":" ++ (to :string n\value))) ]
        if :logical = t [
            if n\value [ return nativeResult true "bool" "1" ]
            return nativeResult true "bool" "0"
        ]
        return nativeFail
    ]
    if "load" = op [
        if key? state\vars n\name [
            found: get state\vars n\name
            return found
        ]
        return nativeFail
    ]
    if "block" = op [
        return nativeBlockResult n\items state
    ]
    if "do" = op [
        seq: n\args\0
        if :dictionary = type seq [
            loaded: nativeExpr seq state
            if not? loaded\ok [ return nativeFail ]
            if "block" <> loaded\kind [ return nativeFail ]
            if not? key? state\blockitems loaded\code [ return nativeFail ]
            seq: get state\blockitems loaded\code
            rawNode: nativeRawNode seq "" null
            if rawNode\ok [ return nativeExpr (foldNode rawNode\node) state ]
        ]
        if :block <> type seq [ return nativeFail ]
        if empty? seq [ return nativeResult true "null" "0" ]
        ; Expression-form direct do is safe here when preceding elements are
        ; inert values; the last value is the block result.
        if 1 < size seq [
            k: 0
            while [k < dec (size seq)][
                preNode: seq\[k]
                if and? (:dictionary = type preNode) ("define" = preNode\op) [
                    pre: nativeExpr preNode\expr state
                    if not? pre\ok [ return nativeFail ]
                    set state\vars preNode\name pre
                ]
                if not? and? (:dictionary = type preNode) ("define" = preNode\op) [
                    pre: nativeExpr preNode state
                    if not? pre\ok [ return nativeFail ]
                ]
                k: k + 1
            ]
        ]
        return nativeExpr (last seq) state
    ]
    if "function" = op [
        ident: "df_" ++ (to :string state\functionnext)
        state\functionnext: state\functionnext + 1
        set state\functionvals ident n
        return nativeResult true "function" ident
    ]
    if "range" = op [
        fromv: nativeExpr n\args\0 state
        tov: nativeExpr n\args\1 state
        if not? fromv\ok [ return nativeFail ]
        if not? tov\ok [ return nativeFail ]
        if "int" <> fromv\kind [ return nativeFail ]
        if "int" <> tov\kind [ return nativeFail ]
        return nativeResult true "range" ("(DRange){" ++ fromv\code ++ ", " ++ tov\code ++ "}")
    ]
    if "call" <> op [ return nativeFail ]
    if :dictionary <> type n\fn [ return nativeFail ]
    ; A single-expression user function can be inlined with its arguments bound
    ; to native expressions. This preserves call-by-value for this pure subset
    ; and avoids shipping the closure/IR machinery for ordinary helpers.
    if "load" = n\fn\op [
        if "makeDict" = n\fn\name [ return nativeMakeDict n state ]
        if not? key? state\funcs n\fn\name [ return nativeFail ]
        fnDef: get state\funcs n\fn\name
        params: fnDef\args\0
        fnBody: fnDef\args\1
        ; Only the canonical function shape is eligible for direct inlining.
        ; A host grouping quirk can preserve a single body node as a dictionary
        ; instead of a sequence; indexing that as `fnBody\0` used to abort the
        ; entire bootstrap rather than simply declining the optimization.
        if :block <> type fnBody [ return nativeFail ]
        if (size params) <> size n\args [ return nativeFail ]
        argValues: @[]
        good: true
        j: 0
        loop n\args [aNode][
            av: nativeExpr aNode state
            if not? av\ok [ good: false ]
            addItem argValues av
        ]
        if not? good [ return nativeFail ]
        ; Compile a call in its own lexical map. For multi-statement functions,
        ; parameters become local C variables so loops may update them.
        outerVars: state\vars
        localVars: #[]
        loop outerVars [k v][ set localVars k v ]
        state\vars: localVars
        if 1 = size fnBody [
            j: 0
            loop params [p][
                set state\vars (to :string p) argValues\[j]
                j: j + 1
            ]
            result: nativeExpr fnBody\0 state
            state\vars: outerVars
            return result
        ]
        decls: @[]
        loop params [p][
            pname: to :string p
            av: argValues\[j]
            ctype: nativeCType av\kind
            if empty? ctype [
                set state\vars pname av
            ]
            if not? empty? ctype [
                cname: "dp_" ++ (to :string state\next)
                state\next: state\next + 1
                addItem decls (ctype ++ " " ++ cname ++ " = " ++ av\code ++ ";")
                set state\vars pname (nativeResult true av\kind cname)
            ]
            j: j + 1
        ]
        if empty? fnBody [ state\vars: outerVars return nativeResult true "null" "0" ]
        savedReturnKind: state\returnKind
        savedReturnVar: state\returnVar
        savedReturnLabel: state\returnLabel
        savedTerminated: state\terminated
        state\returnKind: ""
        state\returnVar: "dr_" ++ (to :string state\next)
        state\next: state\next + 1
        state\returnLabel: "dl_" ++ (to :string state\next)
        state\next: state\next + 1
        state\terminated: false
        prefixNodes: @[]
        j: 0
        while [j < dec (size fnBody)][
            addItem prefixNodes fnBody\[j]
            j: j + 1
        ]
        prefix: nativeSeq prefixNodes state
        if or? (:dictionary <> type prefix) [not? key? prefix "ok"] [
            prefix: #[ok: false kind: "" code: ""]
        ]
        if not? prefix\ok [ good: false ]
        tailNode: last fnBody
        tail: nativeExpr tailNode state
        if or? (:dictionary <> type tail) [not? key? tail "ok"] [
            tail: #[ok: false kind: "" code: ""]
        ]
        tailStatement: ""
        if not? tail\ok [
            tailSeq: nativeSeq @[tailNode] state
            if or? (:dictionary <> type tailSeq) [not? key? tailSeq "ok"] [
                tailSeq: #[ok: false kind: "" code: ""]
            ]
            if not? tailSeq\ok [ good: false ]
            if tailSeq\ok [ tailStatement: tailSeq\code ]
        ]
        explicitKind: state\returnKind
        resultKind: explicitKind
        if empty? resultKind [
            if tail\ok [ resultKind: tail\kind ]
        ]
        if and? (not? empty? explicitKind) tail\ok [
            if explicitKind <> tail\kind [ good: false ]
        ]
        ctype: nativeCType resultKind
        if empty? ctype [ good: false ]
        code: ""
        if good [
            pieces: @[]
            loop decls [d][ addItem pieces d ]
            if not? empty? explicitKind [ addItem pieces (ctype ++ " " ++ state\returnVar ++ ";") ]
            if not? empty? prefix\code [ addItem pieces prefix\code ]
            if tail\ok [
                if empty? explicitKind [ addItem pieces tail\code ]
                if not? empty? explicitKind [ addItem pieces (state\returnVar ++ " = " ++ tail\code ++ ";") ]
            ]
            if not? empty? tailStatement [ addItem pieces tailStatement ]
            if not? empty? explicitKind [
                addItem pieces (state\returnLabel ++ ":")
                addItem pieces state\returnVar
            ]
            code: "({ " ++ (joinWith pieces "\n") ++ "; })"
        ]
        state\vars: outerVars
        state\returnKind: savedReturnKind
        state\returnVar: savedReturnVar
        state\returnLabel: savedReturnLabel
        state\terminated: savedTerminated
        if not? good [ return nativeFail ]
        return nativeResult true resultKind code
    ]
    if "intrinsic" <> n\fn\op [ return nativeFail ]
    name: n\fn\name

    if "map" = name [ return nativeHigher n state false ]
    if "select" = name [ return nativeHigher n state true ]

    if "get" = name [
        if 2 <> size n\args [ return nativeFail ]
        owner: nativeExpr n\args\0 state
        if not? owner\ok [ return nativeFail ]
        if "block" = owner\kind [
            index: nativeExpr n\args\1 state
            if not? index\ok [ return nativeFail ]
            if "int" <> index\kind [ return nativeFail ]
            if not? key? state\blockitems owner\code [ return nativeFail ]
            items: get state\blockitems owner\code
            keyNode: n\args\1
            if :dictionary = type keyNode [
                if "const" = keyNode\op [
                    if :integer = type keyNode\value [
                        numericIndex: keyNode\value
                        if (0 =< numericIndex) [
                            if (numericIndex < size items) [ return nativeExpr items\[numericIndex] state ]
                        ]
                    ]
                ]
            ]
            state\dynamic: true
            return nativeResult true "dynamic" ("(" ++ owner\code ++ ").items[" ++ index\code ++ "]")
        ]
        if "dict" <> owner\kind [ return nativeFail ]
        keyText: nativeKeyText n\args\1
        if empty? keyText [ return nativeFail ]
        fields: get state\dicts owner\code
        if not? key? fields keyText [ return nativeResult true "null" "0" ]
        found: get fields keyText
        return found
    ]
    if "key?" = name [
        if 2 <> size n\args [ return nativeFail ]
        owner: nativeExpr n\args\0 state
        if not? owner\ok [ return nativeFail ]
        if "dict" <> owner\kind [ return nativeFail ]
        keyText: nativeKeyText n\args\1
        if empty? keyText [ return nativeFail ]
        fields: get state\dicts owner\code
        if key? fields keyText [ return nativeResult true "bool" "1" ]
        return nativeResult true "bool" "0"
    ]
    if "set" = name [
        if 3 <> size n\args [ return nativeFail ]
        owner: nativeExpr n\args\0 state
        if not? owner\ok [ return nativeFail ]
        if "dict" <> owner\kind [ return nativeFail ]
        keyText: nativeKeyText n\args\1
        if empty? keyText [ return nativeFail ]
        value: nativeExpr n\args\2 state
        if not? value\ok [ return nativeFail ]
        fields: get state\dicts owner\code
        set fields keyText value
        return value
    ]
    if "call" = name [
        if 2 <> size n\args [ return nativeFail ]
        callable: nativeExpr n\args\0 state
        argv: nativeExpr n\args\1 state
        if not? callable\ok [ return nativeFail ]
        if not? argv\ok [ return nativeFail ]
        if "function" <> callable\kind [ return nativeFail ]
        if "block" <> argv\kind [ return nativeFail ]
        if not? key? state\functionvals callable\code [ return nativeFail ]
        if not? key? state\blockitems argv\code [ return nativeFail ]
        tempName: "callable_" ++ (to :string state\functionnext)
        state\functionnext: state\functionnext + 1
        set state\funcs tempName (get state\functionvals callable\code)
        fnLoad: #[op: "load" name: tempName]
        callArgs: @[]
        loop (get state\blockitems argv\code) [item][
            if :dictionary = type item [ addItem callArgs item ]
            if :dictionary <> type item [ addItem callArgs (nativeTokenNode item "") ]
        ]
        return nativeExpr #[op: "call" fn: fnLoad args: callArgs] state
    ]

    if "pop" = name [
        if 1 <> size n\args [ return nativeFail ]
        refNode: n\args\0
        if :dictionary <> type refNode [ return nativeFail ]
        if "passthrough" <> refNode\op [ return nativeFail ]
        owner: nativeRefValue refNode\src state
        if not? owner\ok [ return nativeFail ]
        if "block" <> owner\kind [ return nativeFail ]
        if not? key? state\blockitems owner\code [ return nativeFail ]
        items: get state\blockitems owner\code
        if empty? items [ return nativeResult true "null" "0" ]
        popped: nativeExpr (last items) state
        kept: @[]
        j: 0
        while [j < dec (size items)][ addItem kept items\[j] j: j + 1 ]
        set state\blockitems owner\code kept
        return popped
    ]
    if "append" = name [
        if 2 <> size n\args [ return nativeFail ]
        refNode: n\args\0
        if :dictionary = type refNode [
            if "passthrough" = refNode\op [
                owner: nativeRefValue refNode\src state
                if owner\ok [
                    if "block" = owner\kind [
                        if key? state\blockitems owner\code [
                            items: get state\blockitems owner\code
                            addItem items n\args\1
                            set state\blockitems owner\code items
                            return owner
                        ]
                    ]
                ]
            ]
        ]
    ]

    ; size of a literal block needs no block runtime representation.
    if "size" = name [
        if 1 <> size n\args [ return nativeFail ]
        raw: n\args\0
        if :dictionary = type raw [
            if "block" = raw\op [ return nativeResult true "int" (to :string (size raw\items)) ]
        ]
        one: nativeExpr raw state
        if not? one\ok [ return nativeFail ]
        if "string" = one\kind [ return nativeResult true "int" ("(long)strlen(" ++ one\code ++ ")") ]
        if "range" = one\kind [ return nativeResult true "int" ("(long)(labs((" ++ one\code ++ ").hi - (" ++ one\code ++ ").lo) + 1)") ]
        if "block" = one\kind [
            if key? state\blockitems one\code [ return nativeResult true "int" (to :string (size (get state\blockitems one\code))) ]
            return nativeResult true "int" ("(long)(" ++ one\code ++ ").n")
        ]
        if "dict" = one\kind [
            fields: get state\dicts one\code
            return nativeResult true "int" (to :string (size fields))
        ]
        return nativeFail
    ]
    if "type" = name [
        if 1 <> size n\args [ return nativeFail ]
        one: nativeExpr n\args\0 state
        if not? one\ok [ return nativeFail ]
        tn: ""
        if "int" = one\kind [ tn: ":integer" ]
        if "float" = one\kind [ tn: ":floating" ]
        if "string" = one\kind [ tn: ":string" ]
        if "bool" = one\kind [ tn: ":logical" ]
        if "null" = one\kind [ tn: ":null" ]
        if "dict" = one\kind [ tn: ":dictionary" ]
        if empty? tn [ return nativeFail ]
        return nativeResult true "string" (quoteC tn)
    ]
    if "first" = name [
        if 1 <> size n\args [ return nativeFail ]
        raw: n\args\0
        if :dictionary <> type raw [ return nativeFail ]
        if "block" <> raw\op [ return nativeFail ]
        if empty? raw\items [ return nativeResult true "null" "0" ]
        return nativeExpr raw\items\0 state
    ]
    if "last" = name [
        if 1 <> size n\args [ return nativeFail ]
        raw: n\args\0
        if :dictionary <> type raw [ return nativeFail ]
        if "block" <> raw\op [ return nativeFail ]
        if empty? raw\items [ return nativeResult true "null" "0" ]
        return nativeExpr (last raw\items) state
    ]
    if "inc" = name [
        one: nativeExpr n\args\0 state
        if not? one\ok [ return nativeFail ]
        if "int" <> one\kind [ return nativeFail ]
        return nativeResult true "int" ("(" ++ one\code ++ " + 1)")
    ]
    if "dec" = name [
        one: nativeExpr n\args\0 state
        if not? one\ok [ return nativeFail ]
        if "int" <> one\kind [ return nativeFail ]
        return nativeResult true "int" ("(" ++ one\code ++ " - 1)")
    ]
    if 2 <> size n\args [ return nativeFail ]
    left: nativeExpr n\args\0 state
    right: nativeExpr n\args\1 state
    if not? left\ok [ return nativeFail ]
    if not? right\ok [ return nativeFail ]

    if "append" = name [
        if "string" <> left\kind [ return nativeFail ]
        if "string" <> right\kind [ return nativeFail ]
        state\concat: true
        return nativeResult true "string" ("dc_concat(" ++ left\code ++ ", " ++ right\code ++ ")")
    ]
    if "add" = name [
        if not? nativeNumeric? left\kind [ return nativeFail ]
        if not? nativeNumeric? right\kind [ return nativeFail ]
        kind: "int"
        if "float" = left\kind [ kind: "float" ]
        if "float" = right\kind [ kind: "float" ]
        return nativeResult true kind ("(" ++ left\code ++ " + " ++ right\code ++ ")")
    ]
    if "sub" = name [
        if not? nativeNumeric? left\kind [ return nativeFail ]
        if not? nativeNumeric? right\kind [ return nativeFail ]
        kind: "int"
        if "float" = left\kind [ kind: "float" ]
        if "float" = right\kind [ kind: "float" ]
        return nativeResult true kind ("(" ++ left\code ++ " - " ++ right\code ++ ")")
    ]
    if "mul" = name [
        if not? nativeNumeric? left\kind [ return nativeFail ]
        if not? nativeNumeric? right\kind [ return nativeFail ]
        kind: "int"
        if "float" = left\kind [ kind: "float" ]
        if "float" = right\kind [ kind: "float" ]
        return nativeResult true kind ("(" ++ left\code ++ " * " ++ right\code ++ ")")
    ]
    if "div" = name [
        if "int" <> left\kind [ return nativeFail ]
        if "int" <> right\kind [ return nativeFail ]
        return nativeResult true "int" ("(" ++ left\code ++ " / " ++ right\code ++ ")")
    ]
    if "fdiv" = name [
        if not? nativeNumeric? left\kind [ return nativeFail ]
        if not? nativeNumeric? right\kind [ return nativeFail ]
        return nativeResult true "float" ("((double)(" ++ left\code ++ ") / (double)(" ++ right\code ++ "))")
    ]
    if "mod" = name [
        if "int" <> left\kind [ return nativeFail ]
        if "int" <> right\kind [ return nativeFail ]
        return nativeResult true "int" ("(" ++ left\code ++ " % " ++ right\code ++ ")")
    ]
    if "pow" = name [
        ; Arturo preserves integer type for non-negative integer powers, but a
        ; negative exponent becomes floating. The typed path cannot represent
        ; that value-dependent result kind, so integer operands use the dynamic
        ; runtime, which performs the correct dispatch.
        if and? ("int" = left\kind) ("int" = right\kind) [ return nativeFail ]
        if not? nativeNumeric? left\kind [ return nativeFail ]
        if not? nativeNumeric? right\kind [ return nativeFail ]
        return nativeResult true "float" ("pow((double)(" ++ left\code ++ "), (double)(" ++ right\code ++ "))")
    ]

    cmp: ""
    if "equal?" = name [ cmp: "==" ]
    if "notEqual?" = name [ cmp: "!=" ]
    if "less?" = name [ cmp: "<" ]
    if "greater?" = name [ cmp: ">" ]
    if "lessOrEqual?" = name [ cmp: "<=" ]
    if "greaterOrEqual?" = name [ cmp: ">=" ]
    if not? empty? cmp [
        if and? ("string" = left\kind) ("string" = right\kind) [
            leftLiteral: false
            rightLiteral: false
            if not? empty? left\code [ leftLiteral: "\"" = slice left\code 0 0 ]
            if not? empty? right\code [ rightLiteral: "\"" = slice right\code 0 0 ]
            if and? (and? leftLiteral rightLiteral) (or? ("equal?" = name) ("notEqual?" = name)) [
                literalEqual: left\code = right\code
                if "notEqual?" = name [ literalEqual: not? literalEqual ]
                if literalEqual [ return nativeResult true "bool" "1" ]
                return nativeResult true "bool" "0"
            ]
            return nativeResult true "bool" ("(strcmp(" ++ left\code ++ ", " ++ right\code ++ ") " ++ cmp ++ " 0)")
        ]
        if and? (nativeNumeric? left\kind) (nativeNumeric? right\kind) [
            return nativeResult true "bool" ("(" ++ left\code ++ " " ++ cmp ++ " " ++ right\code ++ ")")
        ]
        if and? ("bool" = left\kind) ("bool" = right\kind) [
            return nativeResult true "bool" ("(" ++ left\code ++ " " ++ cmp ++ " " ++ right\code ++ ")")
        ]
    ]
    nativeFail
]

nativeKeyText: function [n][
    if :dictionary <> type n [ return to :string n ]
    if "const" = n\op [
        if :null = type n\value [ return "" ]
        return to :string n\value
    ]
    if "passthrough" = n\op [
        if :null = type n\src [ return "" ]
        return to :string n\src
    ]
    ""
]

nativeRefValue: function [src state][
    if :literal = type src [
        name: to :string src
        if key? state\vars name [ return get state\vars name ]
        return nativeFail
    ]
    if :pathliteral = type src [
        parts: to :block src
        if empty? parts [ return nativeFail ]
        base: to :string parts\0
        if not? key? state\vars base [ return nativeFail ]
        current: get state\vars base
        j: 1
        while [j < size parts][
            if "dict" <> current\kind [ return nativeFail ]
            fields: get state\dicts current\code
            keyText: to :string parts\[j]
            if not? key? fields keyText [ return nativeFail ]
            current: get fields keyText
            j: j + 1
        ]
        return current
    ]
    nativeFail
]

nativeBlockResult: function [items state][
    boxedItems: @[]
    goodItems: true
    loop items [item][
        ri: nativeExpr item state
        if not? ri\ok [ goodItems: false ]
        if ri\ok [
            bi: nativeBox ri
            if empty? bi [ goodItems: false ]
            if not? empty? bi [ addItem boxedItems bi ]
        ]
    ]
    if not? goodItems [ return nativeFail ]
    state\blocks: true
    state\dynamic: true
    blockCode: "ds_block((DScalar[]){" ++ (joinWith boxedItems ", ") ++ "}, " ++ (to :string (size boxedItems)) ++ ")"
    set state\blockitems blockCode items
    nativeResult true "block" blockCode
]

nativeMakeDict: function [n state][
    if 0 <> (size n\args) % 2 [ return nativeFail ]
    fields: #[]
    good: true
    j: 0
    while [j < size n\args][
        keyText: nativeKeyText n\args\[j]
        if empty? keyText [ good: false ]
        value: nativeExpr n\args\[j + 1] state
        if not? value\ok [ good: false ]
        if and? good (not? empty? keyText) [ set fields keyText value ]
        j: j + 2
    ]
    if not? good [ return nativeFail ]
    ident: "dd_" ++ (to :string state\dictnext)
    state\dictnext: state\dictnext + 1
    set state\dicts ident fields
    nativeResult true "dict" ident
]

nativeOpName: function [glyph][
    if "+" = glyph [ return "add" ]
    if "-" = glyph [ return "sub" ]
    if "*" = glyph [ return "mul" ]
    if "/" = glyph [ return "div" ]
    if "//" = glyph [ return "fdiv" ]
    if "%" = glyph [ return "mod" ]
    if "^" = glyph [ return "pow" ]
    if "++" = glyph [ return "append" ]
    if "=" = glyph [ return "equal?" ]
    if "<>" = glyph [ return "notEqual?" ]
    if "<" = glyph [ return "less?" ]
    if ">" = glyph [ return "greater?" ]
    if "=<" = glyph [ return "lessOrEqual?" ]
    if ">=" = glyph [ return "greaterOrEqual?" ]
    ""
]

nativeTokenNode: function [token paramName][
    if :dictionary = type token [ return token ]
    r: #[]
    if and? (:word = type token) ((to :string token) = paramName) [
        r\op: "load"
        r\name: paramName
        return r
    ]
    r\op: "const"
    r\value: token
    r
]

nativeRawToken: function [token paramName replacement][
    if not? empty? paramName [
        tokenType: type token
        if or? (:word = tokenType) (:string = tokenType) [
            if (to :string token) = paramName [ return nativeTokenNode replacement "" ]
        ]
    ]
    if :inline = type token [
        nested: nativeRawNode (to :block token) paramName replacement
        if nested\ok [ return nested\node ]
        return null
    ]
    nativeTokenNode token paramName
]

nativeRawNode: function [items paramName replacement][
    fail: #[ok: false node: null]
    if 1 = size items [ return #[ok: true node: nativeRawToken items\0 paramName replacement] ]
    fnName: ""
    args: @[]
    if 2 = size items [
        fnName: to :string items\0
        addItem args (nativeRawToken items\1 paramName replacement)
    ]
    if 3 = size items [
        fnName: nativeOpName (to :string items\1)
        addItem args (nativeRawToken items\0 paramName replacement)
        addItem args (nativeRawToken items\2 paramName replacement)
    ]
    if empty? fnName [ return fail ]
    fn: #[op: "intrinsic" name: fnName]
    #[ok: true node: #[op: "call" fn: fn args: args]]
]

nativeHigher: function [n state selecting][
    if 3 <> size n\args [ return nativeFail ]
    coll: n\args\0
    params: n\args\1
    action: n\args\2
    collItems: @[]
    if :dictionary = type coll [
        if "block" = coll\op [ collItems: coll\items ]
        if "load" = coll\op [
            loadedColl: nativeExpr coll state
            if loadedColl\ok [
                if "block" = loadedColl\kind [
                    if key? state\blockitems loadedColl\code [ collItems: get state\blockitems loadedColl\code ]
                ]
            ]
        ]
    ]
    if empty? collItems [ return nativeFail ]
    paramName: ""
    if :dictionary = type params [
        if "block" = params\op [
            if not? empty? params\items [ paramName: to :string params\items\0 ]
        ]
        if "passthrough" = params\op [ paramName: to :string params\src ]
    ]
    if empty? paramName [ return nativeFail ]
    if :dictionary <> type action [ return nativeFail ]
    if "block" <> action\op [ return nativeFail ]
    out: @[]
    checks: @[]
    good: true
    loop collItems [item][
        itemNode: nativeTokenNode item ""
        itemValue: nativeExpr itemNode state
        if not? itemValue\ok [ good: false ]
        if itemValue\ok [
            existed: key? state\vars paramName
            old: nativeFail
            if existed [ old: get state\vars paramName ]
            set state\vars paramName itemValue
            built: nativeRawNode action\items paramName item
            if not? built\ok [ good: false ]
            mapped: nativeFail
            if built\ok [ mapped: nativeExpr built\node state ]
            if not? mapped\ok [ good: false ]
            if selecting [
                if "bool" <> mapped\kind [ good: false ]
            ]
            chosen: mapped
            if selecting [ chosen: itemValue ]
            if good [
                boxed: nativeBox chosen
                if empty? boxed [ good: false ]
                if not? empty? boxed [
                    if not? selecting [ addItem out boxed ]
                    if selecting [ addItem checks #[cond: mapped\code value: boxed] ]
                ]
            ]
            if existed [ set state\vars paramName old ]
            if not? existed [
                unavailable: nativeFail
                set state\vars paramName unavailable
            ]
        ]
    ]
    if not? good [ return nativeFail ]
    state\blocks: true
    state\dynamic: true
    if selecting [
        arr: "dh_a" ++ (to :string state\next)
        state\next: state\next + 1
        seq: "dh_s" ++ (to :string state\next)
        state\next: state\next + 1
        lines: @[]
        addItem lines ("DScalar *" ++ arr ++ " = (DScalar*)malloc(sizeof(DScalar) * " ++ (to :string (size checks)) ++ ");")
        addItem lines ("DSeq " ++ seq ++ " = ds_block(" ++ arr ++ ", 0);")
        loop checks [check][ addItem lines ("if (" ++ check\cond ++ ") " ++ arr ++ "[" ++ seq ++ ".n++] = " ++ check\value ++ ";") ]
        addItem lines seq
        return nativeResult true "block" ("({ " ++ (joinWith lines " ") ++ "; })")
    ]
    nativeResult true "block" ("ds_block((DScalar[]){" ++ (joinWith out ", ") ++ "}, " ++ (to :string (size out)) ++ ")")
]

nativeTruth: function [r][
    if "null" = r\kind [ return "0" ]
    if "bool" = r\kind [ return r\code ]
    if "dynamic" = r\kind [ return "ds_truth(" ++ r\code ++ ")" ]
    "1"
]

nativeBox: function [r][
    if "null" = r\kind [ return "ds_null()" ]
    if "int" = r\kind [ return "ds_int(" ++ r\code ++ ")" ]
    if "float" = r\kind [ return "ds_float(" ++ r\code ++ ")" ]
    if "string" = r\kind [ return "ds_string(" ++ r\code ++ ")" ]
    if "bool" = r\kind [ return "ds_bool(" ++ r\code ++ ")" ]
    if "block" = r\kind [ return "ds_seq(" ++ r\code ++ ")" ]
    ""
]

nativePrint: function [r][
    if "null" = r\kind [ return "puts(\"null\");" ]
    if "string" = r\kind [ return "puts(" ++ r\code ++ ");" ]
    if "int" = r\kind [ return "printf(\"%ld\\n\", (long)(" ++ r\code ++ "));" ]
    if "float" = r\kind [ return "rt_print_float((double)(" ++ r\code ++ "));" ]
    if "bool" = r\kind [ return "puts((" ++ r\code ++ ") ? \"true\" : \"false\");" ]
    if "range" = r\kind [ return "printf(\"%ld..%ld\\n\", (long)(" ++ r\code ++ ").lo, (long)(" ++ r\code ++ ").hi);" ]
    if "dynamic" = r\kind [ return "ds_print(" ++ r\code ++ ");" ]
    if "block" = r\kind [ return "ds_print_seq(" ++ r\code ++ ");" ]
    ""
]

nativeCType: function [kind][
    if "int" = kind [ return "long" ]
    if "float" = kind [ return "double" ]
    if "string" = kind [ return "const char *" ]
    if "bool" = kind [ return "int" ]
    if "range" = kind [ return "DRange" ]
    if "dynamic" = kind [ return "DScalar" ]
    if "block" = kind [ return "DSeq" ]
    ""
]

nativeDictLoop: function [n state][
    fail: nativeFail
    coll: nativeExpr n\args\0 state
    if not? coll\ok [ return fail ]
    if "dict" <> coll\kind [ return fail ]
    params: n\args\1
    if 2 <> size params [ return fail ]
    keyName: to :string params\0
    valName: to :string params\1
    keyHad: key? state\vars keyName
    valHad: key? state\vars valName
    keyOld: nativeFail
    valOld: nativeFail
    if keyHad [ keyOld: get state\vars keyName ]
    if valHad [ valOld: get state\vars valName ]
    lines: @[]
    good: true
    fields: get state\dicts coll\code
    loop fields [k v][
        if good [
            set state\vars keyName (nativeResult true "string" (quoteC (to :string k)))
            set state\vars valName v
            action: nativeSeq n\args\2 state
            if not? action\ok [ good: false ]
            if action\ok [ addItem lines action\code ]
        ]
    ]
    if keyHad [ set state\vars keyName keyOld ]
    if not? keyHad [ set state\vars keyName nativeFail ]
    if valHad [ set state\vars valName valOld ]
    if not? valHad [ set state\vars valName nativeFail ]
    nativeResult good "seq" (joinWith lines "\n")
]

nativeSeq: function [ir state][
    lines: @[]
    good: true
    loop ir [n][
        if and? good (not? state\terminated) [
            handled: false
            if :dictionary = type n [
                if "define" = n\op [
                    if :dictionary = type n\expr [
                        if "function" = n\expr\op [
                            set state\funcs n\name n\expr
                            handled: true
                        ]
                    ]
                    if not? handled [
                        rv: nativeExpr n\expr state
                        if not? rv\ok [ good: false ]
                        if rv\ok [
                        if "dict" = rv\kind [
                            set state\vars n\name rv
                            handled: true
                        ]
                        if "dict" <> rv\kind [
                        if key? state\vars n\name [
                            old: get state\vars n\name
                            if "dynamic" = old\kind [
                                boxed: nativeBox rv
                                if empty? boxed [ good: false ]
                                if not? empty? boxed [ addItem lines (old\code ++ " = " ++ boxed ++ ";") ]
                            ]
                            if and? ("dynamic" <> old\kind) (old\kind <> rv\kind) [ good: false ]
                            if old\kind = rv\kind [ addItem lines (old\code ++ " = " ++ rv\code ++ ";") ]
                        ]
                        if not? key? state\vars n\name [
                            storedKind: rv\kind
                            initCode: rv\code
                            if "null" = rv\kind [
                                storedKind: "dynamic"
                                initCode: "ds_null()"
                                state\dynamic: true
                            ]
                            ctype: nativeCType storedKind
                            if empty? ctype [ good: false ]
                            if not? empty? ctype [
                                cname: "dv_" ++ (to :string state\next)
                                state\next: state\next + 1
                                stored: nativeResult true storedKind cname
                                set state\vars n\name stored
                                if "block" = storedKind [
                                    if key? state\blockitems rv\code [ set state\blockitems cname (get state\blockitems rv\code) ]
                                ]
                                addItem lines (ctype ++ " " ++ cname ++ " = " ++ initCode ++ ";")
                            ]
                        ]
                    ]
                    ]
                    ]
                    handled: true
                ]
                if "call" = n\op [
                    isPrint: false
                    if :dictionary = type n\fn [
                        if "intrinsic" = n\fn\op [
                            if "print" = n\fn\name [ isPrint: true ]
                        ]
                    ]
                    if isPrint [
                        rv: nativeExpr n\args\0 state
                        if not? rv\ok [ good: false ]
                        if rv\ok [
                            if "block" = rv\kind [
                                if key? state\blockitems rv\code [ rv: nativeBlockResult (get state\blockitems rv\code) state ]
                            ]
                            pc: nativePrint rv
                            if empty? pc [ good: false ]
                            if not? empty? pc [ addItem lines pc ]
                        ]
                        handled: true
                    ]
                    if not? isPrint [
                        rv: nativeExpr n state
                        if not? rv\ok [ good: false ]
                        if rv\ok [
                            if and? ("dict" <> rv\kind) ("function" <> rv\kind) [ addItem lines ("(void)(" ++ rv\code ++ ");") ]
                        ]
                        handled: true
                    ]
                ]
                if "const" = n\op [
                    rv: nativeExpr n state
                    if not? rv\ok [ good: false ]
                    if rv\ok [ addItem lines ("(void)(" ++ rv\code ++ ");") ]
                    handled: true
                ]
                if "load" = n\op [
                    rv: nativeExpr n state
                    if not? rv\ok [ good: false ]
                    if rv\ok [ addItem lines ("(void)(" ++ rv\code ++ ");") ]
                    handled: true
                ]
                if "return" = n\op [
                    rv: nativeExpr n\args\0 state
                    if not? rv\ok [ good: false ]
                    if rv\ok [
                        if empty? state\returnVar [ good: false ]
                        if empty? state\returnKind [ state\returnKind: rv\kind ]
                        if state\returnKind <> rv\kind [ good: false ]
                        if good [ addItem lines (state\returnVar ++ " = " ++ rv\code ++ "; goto " ++ state\returnLabel ++ ";") ]
                        if good [ state\terminated: true ]
                    ]
                    handled: true
                ]
                if "if" = n\op [
                    cond: nativeExpr n\args\0 state
                    if not? cond\ok [ good: false ]
                    if cond\ok [
                        if and? ("bool" = cond\kind) ("1" = cond\code) [
                            yes: nativeSeq n\args\1 state
                            if not? yes\ok [ good: false ]
                            if yes\ok [ addItem lines yes\code ]
                        ]
                        if not? and? ("bool" = cond\kind) (or? ("0" = cond\code) ("1" = cond\code)) [
                            oldTerminated: state\terminated
                            state\depth: state\depth + 1
                            yes: nativeSeq n\args\1 state
                            state\depth: state\depth - 1
                            state\terminated: oldTerminated
                            if not? yes\ok [ good: false ]
                            if yes\ok [ addItem lines ("if (" ++ (nativeTruth cond) ++ ") {\n" ++ yes\code ++ "\n}") ]
                        ]
                    ]
                    handled: true
                ]
                if "while" = n\op [
                    if 1 <> size n\args\0 [ good: false ]
                    if good [
                        cond: nativeExpr n\args\0\0 state
                        if not? cond\ok [ good: false ]
                        if cond\ok [
                            state\depth: state\depth + 1
                            action: nativeSeq n\args\1 state
                            state\depth: state\depth - 1
                            if not? action\ok [ good: false ]
                            if action\ok [ addItem lines ("while (" ++ (nativeTruth cond) ++ ") {\n" ++ action\code ++ "\n}") ]
                        ]
                    ]
                    handled: true
                ]
                if "loop" = n\op [
                    dictAction: nativeDictLoop n state
                    if dictAction\ok [
                        addItem lines dictAction\code
                        handled: true
                    ]
                ]
                if and? ("loop" = n\op) (not? handled) [
                    coll: n\args\0
                    params: n\args\1
                    if 0 = size params [ good: false ]
                    if good [
                        pname: to :string params\0
                        hadOld: key? state\vars pname
                        old: nativeFail
                        if hadOld [ old: get state\vars pname ]
                        cname: "dv_" ++ (to :string state\next)
                        state\next: state\next + 1
                        prefix: ""
                        suffix: "}"
                        elemKind: ""
                        if :dictionary = type coll [
                            if "range" = coll\op [
                                lo: nativeExpr coll\args\0 state
                                hi: nativeExpr coll\args\1 state
                                if not? lo\ok [ good: false ]
                                if not? hi\ok [ good: false ]
                                if good [
                                    if "int" <> lo\kind [ good: false ]
                                    if "int" <> hi\kind [ good: false ]
                                ]
                                if good [
                                    elemKind: "int"
                                    prefix: "for (long " ++ cname ++ " = " ++ lo\code ++ ", dc_end = " ++ hi\code ++ ", dc_step = (" ++ lo\code ++ " <= " ++ hi\code ++ " ? 1 : -1);; " ++ cname ++ " += dc_step) {\n"
                                    suffix: "if (" ++ cname ++ " == dc_end) break;\n}"
                                ]
                            ]
                            if "block" = coll\op [
                                items: @[]
                                loopKind: ""
                                loopGood: true
                                loop coll\items [item][
                                    ri: nativeExpr item state
                                    if not? ri\ok [ loopGood: false ]
                                    if ri\ok [
                                        if empty? loopKind [ loopKind: ri\kind ]
                                        if loopKind <> ri\kind [ loopGood: false ]
                                        addItem items ri\code
                                    ]
                                ]
                                if not? loopGood [ good: false ]
                                if loopGood [
                                    ctype: nativeCType loopKind
                                    if empty? ctype [ good: false ]
                                    if not? empty? ctype [
                                        arr: "da_" ++ (to :string state\next)
                                        state\next: state\next + 1
                                        elemKind: loopKind
                                        prefix: ctype ++ " " ++ arr ++ "[] = {" ++ (joinWith items ", ") ++ "};\nfor (size_t di=0; di<" ++ (to :string (size items)) ++ "; di++) {\n" ++ ctype ++ " " ++ cname ++ " = " ++ arr ++ "[di];\n"
                                    ]
                                ]
                            ]
                        ]
                        if empty? elemKind [
                            loadedColl: nativeExpr coll state
                            if loadedColl\ok [
                                if "block" = loadedColl\kind [
                                    if key? state\blockitems loadedColl\code [
                                        rawItems: get state\blockitems loadedColl\code
                                        items: @[]
                                        loopKind: ""
                                        loopGood: true
                                        loop rawItems [item][
                                            ri: nativeExpr item state
                                            if not? ri\ok [ loopGood: false ]
                                            if ri\ok [
                                                if empty? loopKind [ loopKind: ri\kind ]
                                                if loopKind <> ri\kind [ loopGood: false ]
                                                addItem items ri\code
                                            ]
                                        ]
                                        if loopGood [
                                            ctype: nativeCType loopKind
                                            if not? empty? ctype [
                                                arr: "da_" ++ (to :string state\next)
                                                state\next: state\next + 1
                                                elemKind: loopKind
                                                prefix: ctype ++ " " ++ arr ++ "[] = {" ++ (joinWith items ", ") ++ "};\nfor (size_t di=0; di<" ++ (to :string (size items)) ++ "; di++) {\n" ++ ctype ++ " " ++ cname ++ " = " ++ arr ++ "[di];\n"
                                            ]
                                        ]
                                    ]
                                ]
                                if "string" = loadedColl\kind [
                                    elemKind: "string"
                                    buf: cname ++ "_buf"
                                    ptr: "dp_" ++ (to :string state\next)
                                    state\next: state\next + 1
                                    prefix: "for (const char *" ++ ptr ++ " = " ++ loadedColl\code ++ "; *" ++ ptr ++ "; " ++ ptr ++ "++) {\nchar " ++ buf ++ "[2] = {*" ++ ptr ++ ", 0};\nconst char *" ++ cname ++ " = " ++ buf ++ ";\n"
                                ]
                            ]
                        ]
                        if empty? elemKind [ good: false ]
                        if good [
                            bound: nativeResult true elemKind cname
                            set state\vars pname bound
                            action: nativeSeq n\args\2 state
                            if not? action\ok [ good: false ]
                            if action\ok [ addItem lines (prefix ++ action\code ++ "\n" ++ suffix) ]
                        ]
                        if hadOld [ set state\vars pname old ]
                        if not? hadOld [
                            unavailable: nativeFail
                            set state\vars pname unavailable
                        ]
                    ]
                    handled: true
                ]
            ]
            if not? handled [ good: false ]
        ]
    ]
    nativeResult good "seq" (joinWith lines "\n")
]

nativeProgram: function [ir][
    state: #[]
    state\vars: #[]
    state\funcs: #[]
    state\dicts: #[]
    state\dictnext: 0
    state\functionvals: #[]
    state\functionnext: 0
    state\blockitems: #[]
    state\next: 0
    state\depth: 0
    state\concat: false
    state\dynamic: false
    state\blocks: false
    state\returnKind: ""
    state\returnVar: ""
    state\returnLabel: ""
    state\terminated: false
    body: nativeSeq ir state
    if not? body\ok [ return "" ]
    helpers: ""
    if state\concat [
        helpers: "static char *dc_concat(const char *a, const char *b){ size_t na=strlen(a), nb=strlen(b); char *r=(char*)malloc(na+nb+1); memcpy(r,a,na); memcpy(r+na,b,nb+1); return r; }\n\n"
    ]
    if state\dynamic [
        helpers: helpers ++ "typedef struct DSeq DSeq;\ntypedef struct { int tag; long i; double f; const char *s; DSeq *b; } DScalar;\nstruct DSeq { DScalar *items; size_t n; };\nstatic DScalar ds_null(void){ return (DScalar){0,0,0,NULL,NULL}; }\nstatic DScalar ds_int(long x){ return (DScalar){1,x,0,NULL,NULL}; }\nstatic DScalar ds_float(double x){ return (DScalar){2,0,x,NULL,NULL}; }\nstatic DScalar ds_string(const char *x){ return (DScalar){3,0,0,x,NULL}; }\nstatic DScalar ds_bool(int x){ return (DScalar){4,x,0,NULL,NULL}; }\nstatic DSeq ds_block(DScalar *x,size_t n){ return (DSeq){x,n}; }\nstatic DScalar ds_seq(DSeq x){ DSeq *p=(DSeq*)malloc(sizeof(DSeq)); *p=x; return (DScalar){5,0,0,NULL,p}; }\nstatic int ds_truth(DScalar x){ return x.tag != 0 && (x.tag != 4 || x.i); }\nstatic void ds_print_inner(DScalar x){ if(x.tag==0) printf(\"null\"); else if(x.tag==1) printf(\"%ld\",x.i); else if(x.tag==2) rt_write_float(x.f); else if(x.tag==3) printf(\"%s\",x.s); else if(x.tag==4) printf(x.i?\"true\":\"false\"); else { printf(\"[\"); for(size_t i=0;i<x.b->n;i++){ if(i)printf(\" \"); ds_print_inner(x.b->items[i]); } printf(\"]\"); } }\nstatic void ds_print(DScalar x){ ds_print_inner(x); putchar('\\n'); }\nstatic void ds_print_seq(DSeq x){ for(size_t i=0;i<x.n;i++){ ds_print_inner(x.items[i]); putchar(' '); } putchar('\\n'); }\n\n"
    ]
    content: body\code
    if not? empty? content [ content: "\t" ++ (replace content "\n" "\n\t") ++ "\n" ]
    "/* typed native C: no IR interpreter */\n#include \"runtime.h\"\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n\ntypedef struct { long lo, hi; } DRange;\n\n" ++ helpers ++ "int main(void){\n" ++ content ++ "\treturn 0;\n}\n"
]

directProgram: function [ir][
    lines: @[]
    hasDirect: false
    hasGeneric: false
    safe: true
    loop ir [n][
        line: directStmt n
        if not? empty? line [
            hasDirect: true
            addItem lines line
        ]
        if empty? line [
            allowed: false
            if :dictionary = type n [
                if "define" = n\op [ allowed: true ]
                if "call" = n\op [ allowed: true ]
                if "const" = n\op [ allowed: true ]
                if "load" = n\op [ allowed: true ]
                if "block" = n\op [ allowed: true ]
                if "passthrough" = n\op [ allowed: true ]
            ]
            if allowed [
                generic: cNode n
                addItem lines ("(void)runNode(e, " ++ generic ++ ");")
                hasGeneric: true
            ]
            if not? allowed [ safe: false ]
        ]
    ]
    ; With no direct statements the ordinary runSeq emitter is smaller and has
    ; already been proved by the differential harness. Structural ops fall back
    ; too: a nested return/break must be allowed to stop the enclosing sequence.
    if not? hasDirect [ return "" ]
    if not? safe [ return "" ]
    body: ""
    if not? empty? lines [ body: "\t" ++ (joinWith lines "\n\t") ++ "\n" ]
    if hasGeneric [
        return "/* hybrid C: direct statements plus the dynamic fallback */\n#include \"runtime.h\"\n#include <stdio.h>\n\nint main(int argc, char **argv){\n\truntime_set_args(argc, argv);\n\tEnv *e = env_new(NULL);\n" ++ body ++ "\treturn 0;\n}\n"
    ]
    "/* direct C */\n#include \"runtime.h\"\n#include <stdio.h>\n\nint main(void){\n" ++ body ++ "\treturn 0;\n}\n"
]

compileToC: function [src][
    rawIR: compileToIR src
    ir: fold rawIR
    native: ""
    ; Typed lowering is an optimization, never the semantic fallback. Large
    ; self-host inputs are far outside its scalar subset and can trip host
    ; value-stack/index defects merely while proving ineligibility. Decline
    ; that probe and let the complete dynamic emitter handle the same IR.
    if 50000 > (size src) [ native: nativeProgram ir ]
    if not? empty? native [ return native ]
    direct: directProgram ir
    if not? empty? direct [ return direct ]
    ; each statement string must be returned BARE from the map (as cSeq/cCall
    ; do) — the deep cNode result is bound to r, and formatting moves into the
    ; joinWith separator. Inlining `"\t\t" ++ r` corrupts the host value stack
    ; once the source is large (the self-compiler's 106KB source emits 0 bytes).
    stmts: map ir [n][
        r: cNullConst
        if not? :null = type n [ r: cNode n ]
        r
    ]
    bodyc: joinWith stmts ",\n\t\t"
    header: "/* generated by the compiler's C backend; links runtime.a */\n#include \"runtime.h\"\n\nint main(int argc, char **argv){\n\truntime_set_args(argc, argv);\n\tEnv *e = env_new(NULL);\n\tIR *seq[] = {\n\t\t"
    footer: "\n\t};\n\trunSeq(e, seq, " ++ (to :string (size ir)) ++ ");\n\treturn 0;\n}\n"
    header ++ bodyc ++ footer
]

; emit C to a file, compile it, and link runtime.a into a native binary
compileToNativeC: function [src outName][
    c: compileToC src
    cPath: outName ++ ".c"
    write c cPath
    execute ("cc -Oz -flto -fvisibility=hidden -c -Iruntime " ++ cPath ++ " -o " ++ outName ++ ".o 2>&1")
    execute ("cc -Oz -flto -Wl,-dead_strip -Wl,-x " ++ outName ++ ".o runtime/runtime.a -lm -o " ++ outName ++ " 2>&1")
    outName
]
