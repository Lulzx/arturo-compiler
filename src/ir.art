;=======================================================
; ir.art — the IR: rendering (ir2art) and passes (fold)
;
; IR nodes are op-tagged dictionaries:
;   const / load / define / func / if / do / block /
;   call / return / while / until / passthrough
;
; ir2art renders IR back to core-Arturo text so the
; donated VM can compile it (-c) and run it (-x). Because
; grouping lives in the call trees (and lowering is an
; exact mirror of the host's processBlock), prefix calls
; print naively: `f a b` re-groups identically.
;
; fold is the first IR pass: constant folding. A call
; whose leaves are all const and whose operator is a
; known-pure host word is evaluated at compile time by
; running the kernel on the subtree, then replaced by a
; single const.
;=======================================================

import ./"kernel.art"

;-----------------------------------------------
; Word-level canonical text rendering (values)
;-----------------------------------------------
joinWith: function [parts sep][
    out: ""
    isFirst: true
    loop parts [p][
        if not? isFirst -> out: out ++ sep
        out: out ++ (to :string p)
        isFirst: false
    ]
    out
]

escapeString: function [s][
    out: @[]
    loop s [ch][
        c: to :string ch
        escaped: false
        if c = "\\" [ addItem out "\\\\" escaped: true ]
        if c = "\"" [ addItem out "\\\"" escaped: true ]
        if c = "\n" [ addItem out "\\n" escaped: true ]
        if c = "\r" [ addItem out "\\r" escaped: true ]
        if c = "\t" [ addItem out "\\t" escaped: true ]
        if not? escaped -> addItem out c
    ]
    join out
]

renderValue: function [v][
    if null? v -> return "null"
    t: type v
    ; A negative literal splits as `-` + `1` inside a block on
    ; the host, so it has to be rendered as an expression. `neg`
    ; and not `(0 - n)`: the host's bytecode compiler silently
    ; dies on a store bound to a negative constant, so
    ; `x: (0 - 4)` compiles to a program that stops there, while
    ; `x: neg 4` is fine. (`x: sub 10 4` works and `x: sub 4 10`
    ; does not — it is the negative result, not the call.)
    if :integer = t [
        if 0 > v -> return "neg " ++ (to :string (0 - v))
        return to :string v
    ]
    if :floating = t [
        if 0.0 > v -> return "neg " ++ (to :string (0 - v))
        return to :string v
    ]
    if :rational = t [
        return "to :rational [" ++ (to :string (numerator v)) ++ " " ++ (to :string (denominator v)) ++ "]"
    ]
    if :complex = t [
        parts: to :block v
        return "to :complex [" ++ (to :string parts\0) ++ " " ++ (to :string parts\1) ++ "]"
    ]
    if :quantity = t -> return (to :string (scalar v)) ++ "`" ++ (to :string (units v))
    if :unit = t -> return "`" ++ (to :string v)
    if :date = t -> return "to :date \"" ++ (escapeString (to :string v)) ++ "\""
    if :color = t -> return "to :color \"" ++ (to :string v) ++ "\""
    if :regex = t -> return "to :regex \"" ++ (escapeString (to :string v)) ++ "\""
    if :binary = t -> return "to :binary \"" ++ (escapeString (to :string v)) ++ "\""
    if :version = t -> return "to :version \"" ++ (escapeString (to :string v)) ++ "\""
    if :errorkind = t -> return "to :errorKind \"" ++ (escapeString (to :string v)) ++ "\""
    if :type = t -> return ":" ++ (to :string v)
    if :string = t -> return "\"" ++ (escapeString v) ++ "\""
    if :char = t -> return "'" ++ (to :string v) ++ "'"
    if :logical = t [
        if v -> return "true"
        return "false"
    ]
    if :word = t -> return to :string v
    if :literal = t [
        n: to :string v
        if "_" = (to :string n\0) -> return n
        return "'" ++ n
    ]
    if :symbol = t -> return to :string v
    if :symbolliteral = t -> return "'" ++ (to :string v)
    if :attribute = t -> return "." ++ (to :string v)
    if :attributelabel = t -> return "." ++ (to :string v) ++ ":"
    if :pathliteral = t [
        ; `'c\stack` — a reference, not a value: it must survive
        ; to the output verbatim, because the builtins that take
        ; one (`pop`, `append`, `insert`, `set`) mutate through
        ; it. Falling off the end of renderValue emitted `null`,
        ; so `pop 'c\stack` came back as `pop null`.
        return "'" ++ (renderPathParts (to :block v))
    ]
    if :label = t -> return (to :string v) ++ ":"
    if :block = t [
        parts: @[]
        loop v [el][ addItem parts (renderValue el) ]
        return "[" ++ (joinWith parts " ") ++ "]"
    ]
    if :inline = t [
        ; an inline is a group, not a block value: render its
        ; elements bare inside the parens. Going through the
        ; :block arm would emit `([a b])` — a block literal in
        ; parens — instead of the grouped expression `(a b)`.
        parts: @[]
        loop (to :block v) [el][ addItem parts (renderValue el) ]
        return "(" ++ (joinWith parts " ") ++ ")"
    ]
    if :path = t [
        n: buildPathGet (to :block v)
        return ir2art (emitNode (newEnv null) n)
    ]
    if :pathlabel = t [
        n: pathSetFrame (to :block v)
        return ir2art (emitNode (newEnv null) n)
    ]
    if :range = t -> return renderRange v
    if :dictionary = t -> return renderDict v
    null
]

; [base seg seg ...] -> `base\seg\seg`. Segments print bare
; (a `:literal` segment is a field name, not a quoted value);
; a `:block` segment keeps its brackets (`c\[i]`).
; The base is a read of a variable and takes the emitted name;
; the segments are field names and stay as written.
renderPathParts: function [parts][
    out: @[]
    isBase: true
    loop parts [p][
        if :block = type p -> addItem out (renderValue p)
        if :block <> type p [
            if isBase -> addItem out (emitName (to :string p))
            if not? isBase -> addItem out (to :string p)
        ]
        isBase: false
    ]
    joinWith out "\\"
]

renderRange: function [v][
    ; best-effort: range value as `from .. to`
    "range"
]

; Dictionaries are rendered as the host's own `#["k": v ...]`
; literal — see the note above ir2artCall for why nothing else
; works. Keys the host mis-compiles are handled the same way.
renderDict: function [v][
    parts: @[]
    flat: @[]
    safe: true
    loop v [k val][
        ks: to :string k
        if not? safeDictKey? ks -> safe: false
        addItem parts ("\"" ++ (escapeString ks) ++ "\":")
        addItem parts (renderValue val)
        addItem flat ("\"" ++ (escapeString ks) ++ "\"")
        addItem flat (renderValue val)
    ]
    if not? safe -> return "to :dictionary [" ++ (joinWith flat " ") ++ "]"
    "#[" ++ (joinWith parts " ") ++ "]"
]

;-----------------------------------------------
; IR -> source text
;-----------------------------------------------
; a dict key the host will accept as a quoted label under `-c`
DICT_KEY_CHARS: "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_?"
DICT_KEY_HEAD: "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_"

safeDictKey?: function [k][
    if empty? k -> return false
    if not? contains? DICT_KEY_HEAD (to :string k\0) -> return false
    ok: true
    loop k [ch][
        if not? contains? DICT_KEY_CHARS (to :string ch) -> ok: false
    ]
    ok
]

ir2artSeq: function [seq][
    parts: @[]
    loop seq [n][ addItem parts (ir2art n) ]
    joinWith parts " "
]

ir2art: function [node][
    if not? isIR node -> return renderValue node
    op: node\op
    if "const" = op -> return renderValue node\value
    if "load" = op -> return node\name
    ; an intrinsic prints as its own word. It is never renamed:
    ; hygiene moves the user's binding out of the way instead, so
    ; the word still reaches the primitive in the emitted text.
    if "intrinsic" = op -> return node\name
    if "define" = op [
        if prefix? node\name "__class_" [
            typeName: slice node\name 8 ((size node\name) - 1)
            if "dictionary" = node\expr\op [
                body: ir2artSeq node\expr\args\0
                return "define " ++ ":" ++ typeName ++ " [" ++ body ++ "]"
            ]
            if "is" = node\expr\op [
                parentNode: node\expr\args\0
                parentName: ir2art parentNode
                if and? (isConstNode parentNode) [:string = type parentNode\value] -> parentName: parentNode\value
                extra: node\expr\args\1
                body: ir2artSeq extra\args\0
                return "define " ++ ":" ++ typeName ++ " is " ++ parentName ++ " [" ++ body ++ "]"
            ]
        ]
        ex: ir2art node\expr
        return node\name ++ ": " ++ ex
    ]
    if "let" = op [
        ex: ir2art node\expr
        return "let '" ++ node\name ++ " " ++ ex
    ]
    if "break" = op -> return "break"
    if "continue" = op -> return "continue"
    if "function" = op [
        pr: renderValue node\args\0
        bd: ir2artSeq node\args\1
        return "function " ++ pr ++ " [" ++ bd ++ "]"
    ]
    if "method" = op [
        pr: renderValue node\args\0
        bd: ir2artSeq node\args\1
        return "method " ++ pr ++ " [" ++ bd ++ "]"
    ]
    if "constructor" = op -> return "constructor " ++ renderValue node\args\0
    if "is" = op [
        parent: ir2art node\args\0
        extra: node\args\1
        body: ir2artSeq extra\args\0
        return "is " ++ parent ++ " [" ++ body ++ "]"
    ]
    if "dictionary" = op [
        bd: ir2artSeq node\args\0
        return "dictionary [" ++ bd ++ "]"
    ]
    if "if" = op [
        cd: ir2art node\args\0
        ys: ir2artSeq node\args\1
        return "if " ++ cd ++ " [" ++ ys ++ "]"
    ]
    if "unless" = op [
        cd: ir2art node\args\0
        ac: ir2artSeq node\args\1
        return "unless " ++ cd ++ " [" ++ ac ++ "]"
    ]
    if "switch" = op [
        cd: ir2art node\args\0
        ys: ir2artSeq node\args\1
        ns: ir2artSeq node\args\2
        return "switch " ++ cd ++ " [" ++ ys ++ "] [" ++ ns ++ "]"
    ]
    if "when" = op [
        parts: @[]
        j: 0
        while [(j + 1) < size node\args][
            addItem parts (ir2art node\args\[j])
            body: ir2artSeq node\args\[j + 1]
            addItem parts ("[" ++ body ++ "]")
            j: j + 2
        ]
        return "when [" ++ (joinWith parts " ") ++ "]"
    ]
    if "using" = op [
        valueText: ir2art node\args\0
        bodyText: ir2artSeq node\args\1
        return "using " ++ valueText ++ " [" ++ bodyText ++ "]"
    ]
    if "try" = op [
        bodyText: ir2artSeq node\args\0
        return "try [" ++ bodyText ++ "]"
    ]
    if "throws?" = op [
        bodyText: ir2artSeq node\args\0
        return "throws? [" ++ bodyText ++ "]"
    ]
    if "ensure" = op [
        conditionText: ir2artSeq node\args\0
        return "ensure [" ++ conditionText ++ "]"
    ]
    if "do" = op [
        ; a body is emitted as a seq; an expression as a single node
        if :dictionary = type node\args\0 -> return "do " ++ (ir2art node\args\0)
        bd: ir2artSeq node\args\0
        return "do [" ++ bd ++ "]"
    ]
    if "block" = op [
        ; a raw source block `[a 1]` keeps words as data and
        ; prints bare; an evaluated block (`@[a b]`, or an empty
        ; block that will be mutated through a dict field) prints
        ; `@[...]` so the host builds a FRESH, element-evaluating
        ; block rather than a shared bytecode constant.
        inner: ir2artSeq node\items
        if empty? node\items -> return "@[]"
        if isIR node\items\0 -> return "@[" ++ inner ++ "]"
        return "[" ++ inner ++ "]"
    ]
    if "return" = op [
        ex: ir2art node\args\0
        return "return " ++ ex
    ]
    if "while" = op [
        cd: ir2artSeq node\args\0
        ac: ir2artSeq node\args\1
        return "while [" ++ cd ++ "] [" ++ ac ++ "]"
    ]
    if "until" = op [
        ac: ir2artSeq node\args\0
        cd: ir2artSeq node\args\1
        return "until [" ++ ac ++ "] [" ++ cd ++ "]"
    ]
    if "loop" = op [
        coll: ir2art node\args\0
        params: renderValue node\args\1
        body: ir2artSeq node\args\2
        return "loop " ++ coll ++ " " ++ params ++ " [" ++ body ++ "]"
    ]
    if "higher" = op [
        fnText: node\name
        if key? node "attrs" [
            loop node\attrs [attrName attrNode][
                flag: false
                if isConstNode attrNode [
                    if :logical = type attrNode\value -> if attrNode\value -> flag: true
                ]
                if flag -> fnText: fnText ++ "." ++ attrName
                if not? flag -> fnText: fnText ++ "." ++ attrName ++ ":" ++ (ir2art attrNode)
            ]
        ]
        coll: ir2art node\args\0
        params: ir2art node\args\1
        body: ir2artSeq node\args\2
        return fnText ++ " " ++ coll ++ " " ++ params ++ " [" ++ body ++ "]"
    ]
    if "range" = op [
        fromText: ir2art node\args\0
        toText: ir2art node\args\1
        return fromText ++ ".." ++ toText
    ]
    if "passthrough" = op -> return renderValue node\src
    if "call" = op -> return ir2artCall node
    renderValue node
]

; dict construction. Three candidate renderings, and the host
; rules out two of them:
;
;   to :dictionary [k v ...]   the elements are regrouped when
;     `to` evaluates them, and a value that is itself a block
;     re-pairs against the following key — `#[body: emitSeq ...]`
;     came back holding the wrong field.
;   to :dictionary @[k v ...]  pairs correctly, but `@[...]`
;     freezes a nested `@[]`, so a field meant to be an empty,
;     growable block ends up a readonly constant.
;   #["k": v ...]              correct on both counts. Only
;     catch: the host mis-compiles operator-like keys under `-c`
;     (`#["+": "add"]` -> a `let` arity error).
;
; So: `#[...]` whenever every key is a plain identifier, and the
; flat form otherwise. The one dict with operator keys is
; INFIX_SYMBOLS, whose values are all strings — no block values,
; so the regrouping bug cannot bite there.
ir2artDict: function [args][
    labelled: @[]
    flat: @[]
    safe: true
    j: 0
    while [j < size args][
        kn: args\[j]
        ks: null
        if isIR kn [
            if "const" = kn\op [
                if :string = type kn\value -> ks: kn\value
            ]
        ]
        if null? ks -> safe: false
        if not? null? ks [
            if not? safeDictKey? ks -> safe: false
            addItem labelled ("\"" ++ (escapeString ks) ++ "\":")
        ]
        addItem flat (ir2art kn)
        if (j + 1) < size args [
            vt: ir2art args\[j + 1]
            addItem labelled vt
            addItem flat vt
        ]
        j: j + 2
    ]
    if not? safe -> return "to :dictionary [" ++ (joinWith flat " ") ++ "]"
    "#[" ++ (joinWith labelled " ") ++ "]"
]

;-----------------------------------------------
; Calls that take a path reference.
;
; `append 'c\stack 4` hands the builtin a reference to write
; back through. The host's bytecode compiler drops that write —
; nothing lands in `c\stack` — while the same call through a
; plain reference, `append 'b 4`, is fine both interpreted and
; compiled.
;
; Binding the path to a local first is enough, because the local
; is an alias of the same container, so the plain reference
; reaches it:
;
;   f 'base\seg... rest   ->   do [_ref1: base\seg... f '_ref1 rest]
;
; The block's value is still f's, so `pop` keeps handing back
; the element it removed. And nothing binds the call's result,
; which matters: `v: append 'b 4` kills the host outright,
; interpreted or compiled — so a source that reads an in-place
; `append` dies either way, and parity holds.
;
; The counter is reset per program by renderProgram, so the
; output is a function of the source alone.
;-----------------------------------------------
REF_SEQ: #[n: 0]

; index of the first argument that is a path reference — a
; `:pathliteral` carrying at least one segment — or -1. A bare
; `'b` is a `:literal` and already survives `-c` untouched.
pathRefArg: function [args][
    found: 0 - 1
    j: 0
    loop args [a][
        if 0 > found [
            if isIR a [
                if "passthrough" = a\op [
                    if :pathliteral = type a\src [
                        if 1 < size (to :block a\src) -> found: j
                    ]
                ]
            ]
        ]
        j: j + 1
    ]
    found
]

; is this call's callee a builtin declared to write through one of
; its arguments? A dynamic callee — anything that is not a direct
; load of a known builtin name — cannot be asked, so it is treated
; as not writing back, which is what the host does with a user
; function: it receives a value, not a reference.
writesThroughRef?: function [fnNode][
    if not? isIR fnNode -> return false
    if "intrinsic" <> fnNode\op -> return false
    mutatesThroughRef? fnNode\name
]

ir2artRefCall: function [node idx][
    REF_SEQ\n: REF_SEQ\n + 1
    tmp: "_ref" ++ (to :string REF_SEQ\n)
    place: renderPathParts (to :block node\args\[idx]\src)
    parts: @[]
    j: 0
    loop node\args [a][
        if j = idx -> addItem parts ("'" ++ tmp)
        if j <> idx -> addItem parts (ir2art a)
        j: j + 1
    ]
    ; not `call:` — binding a builtin name anywhere in the program
    ; moves that word aside everywhere, because hygiene is global
    ; and monotonic. A local called `call` cost the kernel its
    ; `call` builtin, and a renamed word carries no arity, so the
    ; grouping of every call through it silently came apart.
    invocation: (ir2art node\fn) ++ " " ++ (joinWith parts " ")
    ; These host primitives replace the referenced block rather than mutating
    ; its shared body. A temporary alias therefore needs an explicit write-back
    ; when the original reference is nested inside a container.
    name: irCalleeName node\fn
    replacement: false
    if "difference" = name -> replacement: true
    if "intersection" = name -> replacement: true
    if "powerset" = name -> replacement: true
    if "union" = name -> replacement: true
    if replacement [
        return "do [" ++ tmp ++ ": " ++ place ++ " " ++ invocation ++ " " ++ place ++ ": " ++ tmp ++ "]"
    ]
    "do [" ++ tmp ++ ": " ++ place ++ " " ++ invocation ++ "]"
]

ir2artPathKey: function [keyNode][
    if and? (isIR keyNode) ["passthrough" = keyNode\op] -> return to :string keyNode\src
    "[" ++ (ir2art keyNode) ++ "]"
]

; Reassemble a lowered get-chain as one path. Parenthesizing a prefix `get`
; does not produce a path base in Arturo, while leaving it bare makes the
; final segment bind to the literal argument (`get d 'inner\v`).
ir2artPath: function [node][
    if isIR node [
        if "call" = node\op [
            callee: irCalleeName node\fn
            if or? ("get" = callee) ["pathGet" = callee] [
                return (ir2artPath node\args\0) ++ "\\" ++ (ir2artPathKey node\args\1)
            ]
        ]
    ]
    ir2art node
]

ir2artCall: function [node][
    if "makeDict" = irCalleeName node\fn -> return ir2artDict node\args
    if "pathGet" = irCalleeName node\fn -> return ir2artPath node
    ; the shim is only for calls that actually write back. Before
    ; the intrinsic database there was no way to ask, so any call
    ; carrying a path argument got wrapped — `call 'handlers\ok x`
    ; and `info 'obj\field` included, neither of which mutates
    ; anything. Now the callee's own declaration decides.
    refIdx: 0 - 1
    if writesThroughRef? node\fn -> refIdx: pathRefArg node\args
    if refIdx >= 0 -> return ir2artRefCall node refIdx
    fnText: ir2art node\fn
    if key? node "attrs" [
        loop node\attrs [attrName attrNode][
            flag: false
            if isConstNode attrNode [
                if :logical = type attrNode\value -> if attrNode\value -> flag: true
            ]
            if flag -> fnText: fnText ++ "." ++ attrName
            if not? flag -> fnText: fnText ++ "." ++ attrName ++ ":" ++ (ir2art attrNode)
        ]
    ]
    argsText: @[]
    customTypeArg: "to" = irCalleeName node\fn
    if "is?" = irCalleeName node\fn -> customTypeArg: true
    j: 0
    loop node\args [a][
        rendered: ir2art a
        if and? customTypeArg [0 = j] [
            if and? (isConstNode a) [:string = type a\value] [
                if prefix? a\value ":" -> rendered: a\value
            ]
        ]
        addItem argsText rendered
        j: j + 1
    ]
    if empty? argsText -> return fnText
    jt: joinWith argsText " "
    fnText ++ " " ++ jt
]

;-----------------------------------------------
; Constant folding
;-----------------------------------------------

isConstNode: function [n][
    if not? isIR n -> return false
    "const" = n\op
]

; fold one argument of a construct op. A seq is a block of IR and
; folds element-wise; a single emitted node folds itself; a raw
; block (function params) is data and its elements pass through.
foldArg: function [a][
    if :block = type a [
        out: @[]
        loop a [el][ addItem out (foldNode el) ]
        return out
    ]
    foldNode a
]

; Keep definition metadata in a distinct function frame while foldNode
; recursively descends. The donated host reuses foldNode's own parameter/local
; slots during recursion, so a local saved beside that recursive call is not
; sufficient for a nullary dynamic call such as `super`.
foldBinding: function [opName bindingName expr][
    foldedExpr: foldNode expr
    #[op: opName name: bindingName expr: foldedExpr]
]

foldNode: function [node][
    if not? isIR node -> return node
    op: node\op
    if "const" = op -> return node
    if "load" = op -> return node
    if "intrinsic" = op -> return node
    if "passthrough" = op -> return node
    if "block" = op -> return node
    if "define" = op [
        return foldBinding "define" node\name node\expr
    ]
    if "let" = op [
        return foldBinding "let" node\name node\expr
    ]
    if "call" = op [
        ff: foldNode node\fn
        fa: @[]
        loop node\args [a][ addItem fa (foldNode a) ]
        foldedAttrs: #[]
        if key? node "attrs" -> loop node\attrs [name value][ foldedAttrs\[name]: foldNode value ]
        ; fold pure calls over const args by running the kernel
        ; only an intrinsic folds. A call through a name — even a
        ; name spelled `mul` — is whatever that name is bound to at
        ; the point of the call, and folding it would be running
        ; the primitive in place of the user's function.
        if and? (isIR ff) ["intrinsic" = ff\op] [
            if pureIntrinsic? ff\name [
                allConst: true
                loop fa [a][ if not? isConstNode a -> allConst: false ]
                ; A preserved custom type is a string such as `":person"`.
                ; Its conversion depends on the class binding established by
                ; an earlier statement, so it is never a context-free fold.
                if and? ("to" = ff\name) [not? empty? fa] [
                    firstArg: fa\0
                    if and? (isConstNode firstArg) [:string = type firstArg\value] [
                        if prefix? firstArg\value ":" -> allConst: false
                    ]
                ]
                if allConst [
                    ; evaluate the pure call by handing it straight to
                    ; the host. Not through runIR: the kernel's
                    ; interpreter frames during a fold leave the host
                    ; value stack dirty, and the next runIR call that
                    ; is nested under a construct loses its arguments.
                    vals: @[]
                    loop fa [a][ addItem vals a\value ]
                    res: delegate ff\name vals
                    ; an error is not a value. `div 10 0` aborts the
                    ; host at runtime; folding it into a const would
                    ; make the compiled program print an error node
                    ; and carry on. Leave the call unfolded so the
                    ; runtime raises the same error the host does.
                    if isErrorNode res -> return #[op: "call" fn: ff args: fa attrs: foldedAttrs]
                    return #[op: "const" value: res]
                ]
            ]
        ]
        return #[op: "call" fn: ff args: fa attrs: foldedAttrs]
    ]
    if "higher" = op [
        fa: @[]
        loop node\args [a][ addItem fa (foldArg a) ]
        folded: #[op: "higher" name: node\name args: fa]
        foldedAttrs: #[]
        if key? node "attrs" -> loop node\attrs [name value][ foldedAttrs\[name]: foldNode value ]
        if not? empty? foldedAttrs -> folded\attrs: foldedAttrs
        return folded
    ]
    ; every construct op folds by folding its arguments — the shape
    ; of an op is whatever its row's `emit` column declared, so one
    ; recursion serves all of them instead of one branch per op.
    r: ruleFor op
    if not? null? r [
        fa: @[]
        loop node\args [a][ addItem fa (foldArg a) ]
        folded: #[op: op args: fa]
        foldedAttrs: #[]
        if key? node "attrs" -> loop node\attrs [name value][ foldedAttrs\[name]: foldNode value ]
        if not? empty? foldedAttrs -> folded\attrs: foldedAttrs
        return folded
    ]
    node
]

foldIR: function [ir][
    out: @[]
    loop ir [n][ addItem out (foldNode n) ]
    out
]
