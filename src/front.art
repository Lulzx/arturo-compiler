;=======================================================
; front.art — stripComments + to :block + lowering
;
; The donated lexer (`to :block`) produces the tree; this
; module reproduces the grouping of the authoritative
; front-end (src/vm/ast.nim, processBlock): left-to-right
; build, a function word opens a call node with its arity,
; a node pops back to its parent once it has exactly
; `arity` children, and infix symbols bind an operand with
; a single precedence (right-assoc, rightmost binds
; tightest).
;
; Output: a block of tagged nodes the kernel evaluates:
;   load    -> #[nodek: "load" name: <string>]
;   call    -> #[nodek: "call" fn: <node> args: [..] arity: <int>]
;   define  -> #[nodek: "define" name: <string> args: [<node>]]
; Everything else stays a raw value (literal/block/symbol/
; char/inline/string/...).
;
; Function / if / do / while / until bodies stay RAW; the
; kernel lowers them on demand (interpret) or emits them
; on demand (emit). Blocks that are *values* stay raw too.
;
; Host constraints pinned while writing this:
;   - Arturo 0.10.0 has NO `else` keyword (if is arity 2).
;   - `and`/`or` are bitwise; logical ops are `and?`/`or?`,
;     and `if A and? B [block]` makes and? consume the
;     block, so compound conditions use `and? A [B]`.
;   - `not` is bitwise; logical negation is `not?`.
;   - `while`/`until` conditions must be BLOCKS.
;   - Runtime symbol VALUES segfault the host, so infix
;     symbols are translated to their alias word names and
;     symbols never become evaluator values.
;=======================================================

import ./"intrinsics.art"
import ./"semantics.art"

;-----------------------------------------------
; Builtin arity, infix aliases, and which builtins write
; back through a reference — all three read off the
; generated intrinsic database rather than maintained here.
;
; These used to be two hand-written tables, pinned by
; reading src/library/*.nim by eye. That is a mirror of
; another program's signatures, and mirrors drift: the
; hand table had `chunk` at arity 2 (it takes three, like
; `loop` and `map`) and was missing ten infix aliases,
; among them `∈`, `⊆` and `⊼`, all of which the host does
; group as infix. Both classes of error are silent — the
; program still compiles, it just groups differently than
; the host would.
;
;   BUILTIN_ARITY   name  -> number of declared arguments
;   INFIX_SYMBOLS   glyph -> the function word it denotes
;   MUTATES         name  -> writes through a reference arg
;
; MUTATES is the one that was hardest to come by. Which
; builtins mutate in place was worked out here from host
; crashes; it is declared upstream as `PathLiteral` in an
; argument's type set, for every builtin, and has been all
; along.
;-----------------------------------------------
BUILTIN_ARITY: #[]
INFIX_SYMBOLS: #[]
MUTATES: #[]

loop INTRINSICS [nm spec][
    BUILTIN_ARITY\[nm]: spec\arity
    if spec\infix? [
        if 0 < size spec\alias -> INFIX_SYMBOLS\[spec\alias]: nm
    ]
    if not? key? NOT_MUTATING nm [
        loop spec\muts [m][ if m -> MUTATES\[nm]: true ]
    ]
]

mutatesThroughRef?: function [name][ key? MUTATES name ]

;-----------------------------------------------
; Words the kernel handles lazily (kernel rules)
;-----------------------------------------------
SPECIAL_NAMES: #[
    "function": true  "do": true  "if": true  "return": true
    "while": true  "until": true
]

;-----------------------------------------------
; Dynamic arity table (builtins + user functions)
;-----------------------------------------------
ARITY: #[]
loop BUILTIN_ARITY [k v][ ARITY\[k]: v ]

arityOf: function [name][
    if key? ARITY name [
        if not? null? ARITY\[name] -> return ARITY\[name]
    ]
    (0 - 1)
]

; An infix symbol always denotes its builtin, whatever the
; word of that name currently means. Verified on the host:
; after `sub: 5`, `sub 10 3` loads the variable (prints 5)
; but `10 - 3` still calls the builtin (prints 7). Reading
; the mutable table here gave `-` arity -1 in any program
; that also used `sub` as a variable name, collapsing
; `0 - 1` into a zero-argument `sub` call.
infixArityOf: function [name][
    if key? BUILTIN_ARITY name -> return BUILTIN_ARITY\[name]
    arityOf name
]

isInfixSymbol: function [el][
    if :symbol <> type el -> return false
    key? INFIX_SYMBOLS (to :string el)
]

;-----------------------------------------------
; Output hygiene.
;
; The emitted program names builtins as prefix words: `a * b`
; comes back as `mul a b`, `d\k` as `get d 'k`. If the source
; also binds a *variable* called `mul`, that word no longer
; reaches the builtin in the emitted text, and the compiler's
; own call is captured by the user's value.
;
; So the variable is renamed instead. A program that rebinds a
; builtin word to a plain value gets that binding — and every
; later load of it — moved to a private name, which leaves the
; word itself meaning the builtin, exactly as it did in the
; source. Only value bindings are renamed: `add: function [a b]
; [...]` does not shadow on the host either (verified: `add 1 2`
; still answers 3), so it is left alone.
;
; The kernel gets the same benefit. `loadRule` resolves any
; builtin name to a hostword, so before this it could not see a
; user variable named `mul` at all; now it sees `_shadow_mul`
; and binds it normally.
;-----------------------------------------------
SHADOWED: #[]

; the name a shadowed builtin's variable is emitted under
shadowName: function [name][ "_shadow_" ++ name ]

; the name to emit for a word the source read
emitName: function [name][
    if key? SHADOWED name -> return shadowName name
    name
]

; called when a define demotes a word to a plain variable
noteShadow: function [name][
    if key? BUILTIN_ARITY name -> SHADOWED\[name]: true
]

;-----------------------------------------------
; Node constructors
;-----------------------------------------------
loadNode:   function [name][ #[nodek: "load" name: name] ]

;-----------------------------------------------
; `load` and `intrinsic` are two different questions.
;
;   load "mul"        resolve the name `mul` in the environment
;   intrinsic "mul"   the Arturo primitive MUL
;
; They used to be the same node, which meant every downstream
; question about a callee had to be asked as a string: is
; "mul" in PURE_WORDS, is "if" a special, does "append" write
; through its first argument. A word that happens to spell a
; builtin got the same answers as the builtin itself.
;
; Which one a source word becomes is decided by the host's own
; rule, the one loadRule already implements: a builtin word
; resolves to the builtin, never to a user function of that
; name. Only a user VALUE binding takes the word away, and that
; binding has already been renamed out of the way by then — so
; if the name still reaches a builtin, it is the builtin.
;-----------------------------------------------
intrinsicNode: function [name][ #[nodek: "intrinsic" name: name] ]

isIntrinsicNode: function [n][
    if :dictionary <> type n -> return false
    if not? key? n "nodek" -> return false
    "intrinsic" = n\nodek
]

; the node a source word becomes when it is read
wordNode: function [name][
    if key? SHADOWED name -> return loadNode (shadowName name)
    if key? INTRINSICS name -> return intrinsicNode name
    loadNode name
]

; the name a call head denotes, whichever kind it is, or null
calleeName: function [n][
    if isIntrinsicNode n -> return n\name
    if isLoadNode n -> return n\name
    null
]
callNode:   function [fn args][ #[nodek: "call" fn: fn args: args] ]
defineNode: function [name expr][ #[nodek: "define" name: name args: @[expr]] ]

;-----------------------------------------------
; Node-type predicates (short-circuiting via early returns)
;-----------------------------------------------
isCallNode: function [n][
    if :dictionary <> type n -> return false
    if not? key? n "nodek" -> return false
    "call" = n\nodek
]
isLoadNode: function [n][
    if :dictionary <> type n -> return false
    if not? key? n "nodek" -> return false
    "load" = n\nodek
]

;-----------------------------------------------
; stripComments — the donated lexer already drops `;`
; comments, so this is a defensive no-op kept for the
; spec's pipeline shape.
;-----------------------------------------------
stripComments: function [src][ src ]

;-----------------------------------------------
; addItem — append `v` to collection `c` as a SINGLE
; element. The host's `append` flattens block values
; (`append [1] [2 3]` -> `[1 2 3]`), which corrupts the
; tree, so we insert at the end instead.
;-----------------------------------------------
addItem: function [c v][
    insert 'c (size c) v
]

;-----------------------------------------------
; Paths: a :path / :pathlabel value decomposes via
; `to :block` into [base seg1 seg2 ...]. We rebuild the
; tree as explicit get/set calls (what the host's
; processBlock does with addPath).
;-----------------------------------------------
; The `return`s matter: without them both arms built a load
; node and dropped it, and the raw word fell through. emitNode
; turns a raw word into the same load, so the tree came out
; right — but it bypassed the name the word should be read
; under, leaving `sub\0` as `get sub 0` in a program where
; `sub` had been rebound.
pathBaseNode: function [base][
    if :word = type base -> return wordNode (to :string base)
    if :literal = type base -> return wordNode (to :string base)
    base
]

pathSegNode: function [seg][
    if :block = type seg [
        sub: lowerBlock seg
        if empty? sub -> return null
        return sub\0
    ]
    seg
]

; X\Y\Z  ->  get(get(X, Y), Z)
buildPathGet: function [parts][
    node: pathBaseNode parts\0
    if 1 < size parts [
        loop 1..dec (size parts) [j][
            seg: pathSegNode parts\[j]
            if not? null? seg -> node: callNode (intrinsicNode "get") @[node seg]
        ]
    ]
    node
]

; X\Y\Z: value  ->  set(get(X, Y), Z, value)
; returns a call frame to descend into (3 arity)
pathSetFrame: function [parts][
    n: size parts
    node: pathBaseNode parts\0
    if n > 2 [
        loop 1..dec (n - 1) [j][
            seg: pathSegNode parts\[j]
            if not? null? seg -> node: callNode (intrinsicNode "get") @[node seg]
        ]
    ]
    lastSeg: pathSegNode parts\[n - 1]
    fr: #[nodek: "call" fn: intrinsicNode "set" arity: 3 args: @[node lastSeg]]
    fr
]

;-----------------------------------------------
; buildDict — (unused legacy) kept for reference.
;-----------------------------------------------
buildDict: function [ib][
    pairs: @[]
    j: 0
    while [j < size ib][
        el: ib\[j]
        if :label = type el [
            addItem pairs (to :string el)
            jn: j + 1
            if jn < size ib -> addItem pairs ib\[jn]
            j: j + 2
        ]
        if :label <> type el -> j: j + 1
    ]
    to :dictionary pairs
]

;-----------------------------------------------
; makeDictCall — lower a `#[...]` inner block (labels +
; values) into a call to the kernel's makeDict. Each field
; value becomes a node: a single word -> load; any other
; single element -> the raw element; a multi-element
; expression -> a raw block (the kernel lowers it later).
; (No recursive lowerBlock here — it contaminates the host
; value stack when called from inside the walk.)
;-----------------------------------------------
makeDictCall: function [ib][
    pairs: @[]
    j: 0
    while [j < size ib][
        el: ib\[j]
        if :label = type el [
            addItem pairs (to :string el)
            ; collect the value expression until the next label
            vend: j + 1
            while [and? (vend < size ib) [:label <> type ib\[vend]]][
                vend: vend + 1
            ]
            ; NOTE: `-` is right-assoc in Arturo, so `vend - j - 1`
            ; would mean `vend - (j - 1)` — parenthesise
            n: (vend - j) - 1
            ; `@[a b]` value -> an evaluated block value
            atBlock: and? (n = 2) (and? (:symbol = type ib\[j + 1]) ["@" = to :string ib\[j + 1]])
            if atBlock -> addItem pairs (buildBlockVal ib\[j + 2])
            ; `#[k: v]` value -> a nested dictionary, lowered the
            ; same way as the outer one.
            ;
            ; Without this it fell through to the generic
            ; multi-element case below and came back out as
            ; `do [#[...]]`. That wrapper is not inert: the emitted
            ; `do` is an ordinary word lookup, so the moment a
            ; preceding key in the same literal is itself called
            ; `do` — as it is in the generated intrinsic table —
            ; every later value evaluates `do` to that entry's
            ; dictionary instead of the builtin, and the literal
            ; silently fills with junk. Emitting the nested literal
            ; directly has no such hazard, and the host accepts it
            ; interpreted and under `-c` alike.
            hashBlock: and? (n = 2) (and? (:symbol = type ib\[j + 1]) ["#" = to :string ib\[j + 1]])
            if hashBlock -> addItem pairs (makeDictCall to :block ib\[j + 2])
            if and? (not? atBlock) [not? hashBlock] [
                if n = 1 [
                    v: ib\[j + 1]
                    if :word = type v -> addItem pairs (wordNode (to :string v))
                    if :word <> type v -> addItem pairs v
                ]
                if n <> 1 [
                    if n > 1 [
                        sub: @[]
                        k: j + 1
                        while [k < vend][ addItem sub ib\[k] k: k + 1 ]
                        ; a multi-element value is an expression:
                        ; evaluate it with a `do` wrapping the raw block
                        addItem pairs (callNode (intrinsicNode "do") @[sub])
                    ]
                ]
            ]
            j: vend
        ]
        if :label <> type el -> j: j + 1
    ]
    callNode (loadNode "makeDict") pairs
]

;-----------------------------------------------
; buildBlockVal — an `@[a b]` value: each element becomes a
; node (word -> load), collected into a block value node.
;-----------------------------------------------
buildBlockVal: function [blk][
    out: @[]
    loop blk [x][
        ; `@[...]` elements are read, so a word here is a load and
        ; takes the emitted name. A raw `[...]` is data (or a body
        ; the host lowers later) and prints verbatim.
        if :word = type x -> addItem out (wordNode (to :string x))
        if :word <> type x -> addItem out x
    ]
    #[nodek: "blockval" items: out]
]

;-----------------------------------------------
;-----------------------------------------------
; The grouping walk. Mirrors processBlock.
;
; Note: Arturo nested functions cannot assign outer
; locals (assignment shadows), so all mutable walk state
; lives in a context dictionary passed by reference.
;
; lowerWalk blok start stopAtRoot
;   -> #[root: <tree> i: <nextIndex> complete: <bool>]
; stopAtRoot stops after an element that returns the call
; stack to empty (used to find `->` arrow bodies).
;-----------------------------------------------
lowerWalk: function [blok start stopAtRoot][
    ctx: #[root: @[] stack: @[] n: size blok i: start processed: 0]

    appendToTarget: function [c node][
        if empty? c\stack -> addItem c\root node
        if not? empty? c\stack [
            fr: last c\stack
            addItem fr\args node
        ]
    ]

    rewind: function [c][
        while [not? empty? c\stack][
            top: last c\stack
            nargs: size top\args
            car: top\arity
            if nargs < car -> break
            if "define" = top\nodek [
                expr: top\args\0
                if isCallNode expr [
                    if "function" = calleeName expr\fn [
                        params: expr\args\0
                        if :block = type params [
                            cnt: 0
                            loop params [p][
                                if :type <> type p -> cnt: cnt + 1
                            ]
                            ARITY\[top\name]: cnt
                        ]
                        if :block <> type params -> ARITY\[top\name]: 1
                    ]
                    ; a call that is not a function: the name is a
                    ; plain variable now — forget any builtin arity
                    if "function" <> calleeName expr\fn [
                        ARITY\[top\name]: null
                        noteShadow top\name
                    ]
                ]
                ; a non-call value: same — forget the builtin arity
                if not? isCallNode expr [
                    ARITY\[top\name]: null
                    noteShadow top\name
                ]
                ; if the name was a builtin, this binding and every
                ; later read of it move to the private name
                top\name: emitName top\name
            ]
            pop 'c\stack
        ]
    ]

    descendCall: function [c fnNode arity][
        fr: #[nodek: "call" fn: fnNode arity: arity args: @[]]
        appendToTarget c fr
        addItem c\stack fr
    ]

    descendDefine: function [c name][
        fr: #[nodek: "define" name: name arity: 1 args: @[]]
        appendToTarget c fr
        addItem c\stack fr
    ]

    appendValue: function [c node][
        appendToTarget c node
        rewind c
    ]

    ; infix lookahead: if the NEXT element is an infix
    ; symbol, descend into it so the current value becomes
    ; its first operand (single precedence, right-assoc)
    tryInfix: function [c][
        if and? (c\i < c\n - 1) [isInfixSymbol blok\[c\i + 1]] [
            opName: to :string blok\[c\i + 1]
            fnName: INFIX_SYMBOLS\[opName]
            descendCall c (intrinsicNode fnName) (infixArityOf fnName)
            c\i: c\i + 1
        ]
    ]

    ; `=>` (thickarrowright) expansion.
    ;   => [block]  -> `&` replaced by _0, _1, ...; feeds
    ;                  (collection, params, action) forms
    ;   => word     -> if word is a known function, params
    ;                  become _0.._arity-1 and the action is
    ;                  [word _0 .. _arity-1]
    ; emits TWO values: params (a block) and action.
    ; NOTE: the host's ast.nim expands `&` to the literal
    ; `_0`; we use plain word params in a block instead,
    ; because `_0` re-lexes as a word (or crashes) in the
    ; compiled round-trip. The delegated combinators treat
    ; `[x1]` identically to the literal `_0`.
    expandThickArrow: function [c][
        hasNext: c\i < c\n - 1
        if hasNext [
            nxt: blok\[c\i + 1]
            argblock: @[]
            subblock: @[]
            if :block = type nxt [
                idx: 1
                loop nxt [el2][
                    if :symbol = type el2 [
                        if "&" = to :string el2 [
                            w: to :word ("x" ++ to :string idx)
                            addItem argblock w
                            addItem subblock w
                            idx: idx + 1
                        ]
                        if "&" <> to :string el2 -> addItem subblock el2
                    ]
                    if :symbol <> type el2 -> addItem subblock el2
                ]
            ]
            if :word = type nxt [
                fnArity: arityOf (to :string nxt)
                if fnArity > 0 [
                    addItem subblock nxt
                    loop 0..dec fnArity [j][
                        w: to :word ("x" ++ to :string (j + 1))
                        addItem argblock w
                        addItem subblock w
                    ]
                ]
                if fnArity < 1 -> addItem subblock nxt
            ]
            if :block <> type nxt [
                if :word <> type nxt -> addItem subblock nxt
            ]
            appendValue c argblock
            appendValue c subblock
            c\i: c\i + 2
        ]
        if not? hasNext [
            appendValue c blok\[c\i]
            c\i: c\i + 1
        ]
    ]

    while [ctx\i < ctx\n][
        el: blok\[ctx\i]

        ; NOTE: no `continue`/`break` here — the host's
        ; ContinueTriggered unwinding leaves the value stack
        ; dirty (verified empirically), so every branch
        ; advances ctx\i itself and falls through.

        if :label = type el [
            descendDefine ctx (to :string el)
            ctx\i: ctx\i + 1
            ctx\processed: ctx\processed + 1
        ]

        if :word = type el [
            name: to :string el
            if name = "true" [
                appendValue ctx true
                ctx\i: ctx\i + 1
                ctx\processed: ctx\processed + 1
            ]
            if name = "false" [
                appendValue ctx false
                ctx\i: ctx\i + 1
                ctx\processed: ctx\processed + 1
            ]
            if name = "null" [
                appendValue ctx null
                ctx\i: ctx\i + 1
                ctx\processed: ctx\processed + 1
            ]
            if name <> "true" [
                if name <> "false" [
                    if name <> "null" [
                        ar: arityOf name
                        ; A word of arity 0 consumes no operands, so
                        ; it is a leaf: opening a call frame for it
                        ; parks a frame that nothing will ever
                        ; complete. The walk only rewinds after an
                        ; argument lands, so the frame sits on the
                        ; stack, and anything that watches for the
                        ; stack to empty — `->`, whose body ends
                        ; exactly there — runs past its end. `if x
                        ; -> break` swallowed the remaining twelve
                        ; statements of its block that way.
                        ;
                        ; It only surfaced once the generated table
                        ; brought the nullary builtins in with it;
                        ; before, `break` was simply unknown and
                        ; took this same leaf path by accident.
                        ; It stays a CALL, though — with no
                        ; arguments, completed on the spot. A load
                        ; would hand back the closure instead of
                        ; invoking it, which is the difference
                        ; between `f` printing 100 and printing a
                        ; function value.
                        if ar > 0 [
                            descendCall ctx (wordNode name) ar
                        ]
                        if ar = 0 [
                            rewind ctx
                            tryInfix ctx
                            appendValue ctx (callNode (wordNode name) @[])
                        ]
                        if ar < 0 [
                            rewind ctx
                            tryInfix ctx
                            appendValue ctx (wordNode name)
                        ]
                        ctx\i: ctx\i + 1
                        ctx\processed: ctx\processed + 1
                    ]
                ]
            ]
        ]

        if :symbol = type el [
            name: to :string el
            if name = "$" [
                descendCall ctx (intrinsicNode "function") 2
                ctx\i: ctx\i + 1
                ctx\processed: ctx\processed + 1
            ]
            if name = "#" [
                dictAhead: and? (ctx\i < ctx\n - 1) [:block = type blok\[ctx\i + 1]]
                if dictAhead [
                    ; dict literal #[...]: lower to a runtime
                    ; makeDict call so field values evaluate
                    appendValue ctx (makeDictCall blok\[ctx\i + 1])
                    ctx\i: ctx\i + 2
                    ctx\processed: ctx\processed + 1
                ]
                if not? dictAhead [
                    appendValue ctx el
                    ctx\i: ctx\i + 1
                    ctx\processed: ctx\processed + 1
                ]
            ]
            if name = "@" [
                ; `@[a b]` -> an evaluated block value
                blockAhead: and? (ctx\i < ctx\n - 1) [:block = type blok\[ctx\i + 1]]
                if blockAhead [
                    appendValue ctx (buildBlockVal blok\[ctx\i + 1])
                    ctx\i: ctx\i + 2
                    ctx\processed: ctx\processed + 1
                ]
                if not? blockAhead [
                    appendValue ctx el
                    ctx\i: ctx\i + 1
                    ctx\processed: ctx\processed + 1
                ]
            ]
            if name = "=>" [
                expandThickArrow ctx
                ctx\processed: ctx\processed + 1
            ]
            if name = "->" [
                ; arrow body: consume the following elements
                ; up to the first complete expression
                sub: lowerWalk blok (ctx\i + 1) true
                body: @[]
                loop ((ctx\i + 1)..(dec sub\i)) [j][ addItem body blok\[j] ]
                appendValue ctx body
                ctx\i: sub\i
                ctx\processed: ctx\processed + 1
            ]
            if name <> "$" [
                if name <> "#" [
                    if name <> "@" [
                        if name <> "=>" [
                            if name <> "->" [
                                ; other symbols: data
                                appendValue ctx el
                                ctx\i: ctx\i + 1
                                ctx\processed: ctx\processed + 1
                            ]
                        ]
                    ]
                ]
            ]
        ]

        if :pathlabel = type el [
            ; X\Y: value  -> set(get(X, Y), value) with the
            ; value filled by the following element
            parts: to :block el
            fr: pathSetFrame parts
            appendToTarget ctx fr
            append 'ctx\stack fr
            ctx\i: ctx\i + 1
            ctx\processed: ctx\processed + 1
        ]

        if :path = type el [
            parts: to :block el
            g: buildPathGet parts
            rewind ctx
            tryInfix ctx
            appendValue ctx g
            ctx\i: ctx\i + 1
            ctx\processed: ctx\processed + 1
        ]

        ; plain value (literal / block / inline / char / etc.)
        if :label <> type el [
            if :word <> type el [
                if :symbol <> type el [
                    if :path <> type el [
                        if :pathlabel <> type el [
                            rewind ctx
                            tryInfix ctx
                            appendValue ctx el
                            ctx\i: ctx\i + 1
                            ctx\processed: ctx\processed + 1
                        ]
                    ]
                ]
            ]
        ]

        ; stopAtRoot: one expression, then stop. The check lives
        ; here, at the bottom of the walk, so it fires whatever
        ; kind of element completed the expression — a plain
        ; value, a bare word load (`return renderValue node`), a
        ; path (`op: node\op`), `true`/`false`/`null`, a dict or
        ; `@[...]` literal. Checking it in the plain-value branch
        ; alone let every other completing element fall through
        ; and swallow the statements that followed the arrow.
        if and? stopAtRoot (and? (not? empty? ctx\root) [empty? ctx\stack]) -> break
    ]

    #[root: ctx\root i: ctx\i complete: empty? ctx\stack]
]

;-----------------------------------------------
; Public entry: lower a whole raw block
;-----------------------------------------------
lowerBlock: function [blok][
    res: lowerWalk blok 0 false
    res\root
]
