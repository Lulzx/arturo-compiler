;=======================================================
; backend.art — the donation, phased
;
; v0: runIR executes the IR artifact in the kernel.
; v1: ir2art -> .art text -> `arturo -c` (bytecode) ->
;     `arturo -x` (execute bytecode on the donated VM).
;=======================================================

import ./"ir.art"

;-----------------------------------------------
; v0 backend: execute IR in-kernel
;-----------------------------------------------
executeIR: function [ir][
    runIR ir
]

;-----------------------------------------------
; v1 backend: render IR to source, donate the compile
;-----------------------------------------------
renderProgram: function [src][
    ; the path-reference temporaries are numbered per program, so
    ; the output depends only on the source
    REF_SEQ\n: 0
    ir2artSeq (fold (compileToIR src))
]

; compile a source program to bytecode, return the .bcode path
compileToBcode: function [src outPath][
    art: renderProgram src
    write art outPath
    execute ("arturo -c " ++ outPath ++ " 2>&1")
    outPath ++ ".bcode"
]

; run a bytecode artifact, returning its stdout
runBcode: function [bcodePath][
    execute ("arturo -x " ++ bcodePath ++ " 2>&1")
]

; full v1 pipeline: source -> IR -> source -> host bytecode -> run
runCompiled: function [src outPath][
    bcode: compileToBcode src outPath
    runBcode bcode
]

; v1 native: source -> IR -> source -> `arturo -b` -> native executable.
; The bundle names the binary after the source file's base name, so writing
; <outName>.art yields a binary named <outName>. The donated host (via `-b`,
; which Nim-builds a trimmed VM around the program) does all native codegen.
compileToNative: function [src outName][
    art: renderProgram src
    write art (outName ++ ".art")
    execute ("arturo -b " ++ outName ++ ".art 2>&1")
    outName
]

; run a source program on the raw host (the authority)
runHost: function [srcPath][
    execute ("arturo --no-color " ++ srcPath ++ " 2>&1")
]
