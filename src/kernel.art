;=======================================================
; kernel.art — the dual evaluator (M2 interpret + M3 emit)
;
; One dispatch (evalNode), one rule per construct, each
; rule carrying both its interpret behavior and its emit
; behavior. The interpreter and the compiler are the same
; dispatch with the mode flag flipped.
;
;   evalNode env node mode   ; mode ∈ { :interpret, :emit }
;
; Interpret mode evaluates the lowered tree from front.art.
; Emit mode produces IR: op-tagged dictionaries (see ir.art).
; runIR executes an IR artifact (the v0 backend, and the
; value the invariant is checked on).
;
; Host constraints (same as front.art): no `else` keyword,
; `and?`/`or?`/`not?` for logic, `while` needs block
; conditions, runtime symbol values segfault.
;=======================================================

import ./"front.art"

;-----------------------------------------------
; return-signal holder (single-threaded; reset per call)
;-----------------------------------------------
RET: #[set: false value: null]
LOOP_SIGNAL: #[break: false continue: false]

;-----------------------------------------------
; Truthiness: false and null are falsy
;-----------------------------------------------
truthy: function [v][
    if null? v -> return false
    if :logical = type v -> return v
    true
]

;-----------------------------------------------
; Environment: frames with a parent chain
;-----------------------------------------------
newEnv: function [parent][
    #[bindings: #[] parent: parent rebind: false]
]

define: function [env name value][
    if env\rebind [
        target: env
        while [not? null? target][
            if key? target\bindings name [
                target\bindings\[name]: value
                return value
            ]
            target: target\parent
        ]
    ]
    env\bindings\[name]: value
    value
]

letBind: function [env name value][
    target: env
    while [not? null? target][
        if key? target\bindings name [
            target\bindings\[name]: value
            return value
        ]
        target: target\parent
    ]
    env\bindings\[name]: value
    value
]

bound?: function [env name][
    if key? env\bindings name -> return true
    if not? null? env\parent -> return bound? env\parent name
    false
]

lookup: function [env name][
    if key? env\bindings name -> return env\bindings\[name]
    if not? null? env\parent -> return lookup env\parent name
    null
]

;-----------------------------------------------
; Node classification
;-----------------------------------------------
isNode: function [node][
    if :dictionary <> type node -> return false
    key? node "nodek"
]

; an evaluation that failed. `delegate` returns these instead of
; letting the host panic propagate, so any consumer that has to
; tell a failed evaluation apart from a value — the constant
; folder above all — checks for one.
isErrorNode: function [node][
    if not? isNode node -> return false
    "error" = node\nodek
]

isIR: function [node][
    if :dictionary <> type node -> return false
    key? node "op"
]

;-----------------------------------------------
; Donation: hand a hostword and evaluated args to the host
;-----------------------------------------------
delegate: function [name argVals][
    ; never hand kernel-internal values (closures, hostword
    ; markers, errors, IR) to the host — it crashes on them
    loop argVals [v][
        if isNode v -> return #[nodek: "error" msg: ["cannot delegate internal value" v\nodek]]
        if isIR v -> return #[nodek: "error" msg: ["cannot delegate IR value"]]
    ]
    r: null
    ; `do [callee arg...]` is not a safe donation boundary once an evaluated
    ; argument is itself a language token: a :word/:label/:path in that block
    ; is interpreted again as source. `call` accepts an evaluated argument
    ; block and therefore preserves every value kind. A literal names the host
    ; function without invoking it while the call is being assembled.
    err: try [r: call (to :literal name) argVals]
    if :error = type err -> return #[nodek: "error" msg: err]
    r
]


;-----------------------------------------------
; Mutation through a path reference.
;
; `pop 'c\stack` hands the host a REFERENCE, not a value: the
; builtin writes back through it. Passing that pathliteral
; straight to `delegate` sent it into a scope where `c` means
; nothing, so the write went nowhere and the kernel diverged
; from the host on every in-place update.
;
; Instead the base is bound locally, the reference is rebuilt
; against that local, and the (mutated) container is written
; back to the environment:
;
;   f 'base\seg... rest   ==   t: <base>;  f 't\seg... rest
;                               base := t
;
; Only `:pathliteral` args are treated this way. A bare `'x` is
; a `:literal` and is ambiguous — `get d 'tag` passes one as a
; key — so those still go through as values.
;-----------------------------------------------
isPathRef: function [v][
    if :pathliteral = type v -> return true
    ; For an intrinsic known to mutate, a bare literal (`'x`) is the
    ; one-segment reference to x. Non-mutating calls never enter the reference
    ; route, so ordinary literal keys remain ordinary values.
    :literal = type v
]

hasPathRef: function [argVals][
    found: false
    loop argVals [v][ if isPathRef v -> found: true ]
    found
]

; "\\stack" / "\\a\\b" — the segments of a path reference, as text
refSegText: function [parts][
    out: ""
    k: 1
    while [k < size parts][
        out: out ++ "\\" ++ (to :string parts\[k])
        k: k + 1
    ]
    out
]

delegateThroughRef: function [env name argVals][
    refAt: 0
    seen: false
    j: 0
    loop argVals [v][
        if not? seen [
            if isPathRef v [ refAt: j  seen: true ]
        ]
        j: j + 1
    ]
    refValue: argVals\[refAt]
    parts: @[]
    if :literal = type refValue -> addItem parts refValue
    if :literal <> type refValue -> parts: to :block refValue
    baseName: to :string parts\0
    if not? bound? env baseName -> return #[nodek: "error" msg: ["unbound path reference" baseName]]

    ; the local the rebuilt reference points at
    __t: lookup env baseName

    blk: @[]
    el0: to :block name
    if not? empty? el0 -> addItem blk el0\0
    j2: 0
    loop argVals [v][
        if j2 = refAt -> addItem blk (first to :block ("'__t" ++ (refSegText parts)))
        if j2 <> refAt -> addItem blk v
        j2: j2 + 1
    ]
    r: null
    err: try [r: do blk]
    if :error = type err -> return #[nodek: "error" msg: err]
    define env baseName __t
    r
]

;-----------------------------------------------
; Specials: lazy / structural constructs handled by name
;-----------------------------------------------
isSpecialName: function [name][
    not? null? ruleFor name
]

ruleFor: function [name][
    if null? name -> return null
    if key? RULES name -> return RULES\[name]
    null
]

;-----------------------------------------------
; The IR-level counterpart of front.art's calleeName: the name
; a call head denotes, whether it was written as a lexical load
; or identified as an intrinsic. Null when the callee is an
; expression — a closure in a variable, a value returned by
; another call — which is precisely when nothing static can be
; said about it.
;-----------------------------------------------
irCalleeName: function [node][
    if not? isIR node -> return null
    if "intrinsic" = node\op -> return node\name
    if "load" = node\op -> return node\name
    null
]

;=======================================================
; Interpret mode — shared helpers
;=======================================================
evalSeq: function [env seq][
    result: null
    loop seq [el][
        result: evalNode env el :interpret
        if RET\set -> break
        if LOOP_SIGNAL\break -> break
        if LOOP_SIGNAL\continue -> break
    ]
    result
]

; evaluate an expression; if the result is a block, execute it
evalBody: function [env node][
    v: evalNode env node :interpret
    if :block = type v -> return evalSeq env (lowerBlock v)
    v
]

loadRule: function [env name][
    if "true" = name -> return true
    if "false" = name -> return false
    if "null" = name -> return null
    ; The host resolves builtin words to the builtin, never
    ; to a user function of the same name (verified: a user
    ; `add` does not shadow the builtin `add`). So builtins
    ; always delegate.
    if key? BUILTIN_ARITY name -> return #[nodek: "hostword" name: name]
    if bound? env name -> return lookup env name
    #[nodek: "hostword" name: name]
]

evalDefine: function [env node][
    value: evalNode env node\args\0 :interpret
    define env node\name value
    value
]

evalLet: function [env argv][
    value: evalNode env argv\1 :interpret
    letBind env (to :string argv\0) value
]

evalReturn: function [env valNode][
    RET\set: true
    RET\value: evalNode env valNode :interpret
]

makeClosure: function [env params body][
    #[nodek: "closure" params: params body: body ir: false env: env]
]

evalIf: function [env condNode yesNode][
    cond: evalNode env condNode :interpret
    if truthy cond -> return evalBody env yesNode
    null
]

evalUnless: function [env condNode actionNode][
    cond: evalNode env condNode :interpret
    if not? truthy cond -> return evalBody env actionNode
    null
]

evalSwitch: function [env condNode yesNode noNode][
    cond: evalNode env condNode :interpret
    if truthy cond -> return evalBody env yesNode
    evalBody env noNode
]

evalWhen: function [env casesNode][
    cases: lowerBlock casesNode
    j: 0
    while [(j + 1) < size cases][
        cond: evalNode env cases\[j] :interpret
        if truthy cond -> return evalBody env cases\[j + 1]
        j: j + 2
    ]
    null
]

; The run behaviour of each construct, as a named helper. Each
; row's `run` column points at one (`function [env argv][ runIf
; env argv ]`) and runNode's construct dispatch calls the same
; helper directly — so the meaning lives once, and the two
; pointers cannot drift.
runFunction: function [env argv][
    #[nodek: "closure" params: argv\0 body: argv\1 ir: true env: env]
]

runLet: function [env node][
    value: runNode env node\expr
    letBind env node\name value
]

runIf: function [env argv][
    cond: runNode env argv\0
    if truthy cond -> return runSeq env argv\1
    if not? null? argv\2 -> return runSeq env argv\2
    null
]

runUnless: function [env argv][
    cond: runNode env argv\0
    if not? truthy cond -> return runSeq env argv\1
    null
]

runSwitch: function [env argv][
    cond: runNode env argv\0
    if truthy cond -> return runSeq env argv\1
    runSeq env argv\2
]

runWhen: function [env argv][
    j: 0
    while [(j + 1) < size argv][
        cond: runNode env argv\[j]
        if truthy cond -> return runSeq env argv\[j + 1]
        j: j + 2
    ]
    null
]

evalUsing: function [env valueNode bodyBlock][
    value: evalNode env valueNode :interpret
    child: newEnv env
    define child "this" value
    child\rebind: true
    evalSeq child (lowerBlock bodyBlock)
]

runUsing: function [env argv][
    value: runNode env argv\0
    child: newEnv env
    define child "this" value
    child\rebind: true
    runSeq child argv\1
]

evalTryBlock: function [env bodyBlock predicate][
    result: null
    caught: try [ result: evalSeq env (lowerBlock bodyBlock) ]
    failed: :error = type caught
    if isErrorNode result -> failed: true
    if predicate -> return failed
    if :error = type caught -> return caught
    if isErrorNode result -> return result\msg
    null
]

runTryBlock: function [env bodyIR predicate][
    result: null
    caught: try [ result: runSeq env bodyIR ]
    failed: :error = type caught
    if isErrorNode result -> failed: true
    if predicate -> return failed
    if :error = type caught -> return caught
    if isErrorNode result -> return result\msg
    null
]

evalThrow: function [env valueNode][
    value: evalNode env valueNode :interpret
    caught: try [ throw value ]
    #[nodek: "error" msg: caught]
]

runThrow: function [env valueNode][
    value: runNode env valueNode
    caught: try [ throw value ]
    #[nodek: "error" msg: caught]
]

evalErrorPredicate: function [env valueNode][
    value: evalNode env valueNode :interpret
    if isErrorNode value -> return true
    :error = type value
]

runErrorPredicate: function [env valueNode][
    value: runNode env valueNode
    if isErrorNode value -> return true
    :error = type value
]

evalEnsure: function [env conditionBlock][
    condition: evalSeq env (lowerBlock conditionBlock)
    if truthy condition -> return null
    caught: try [ throw "assertion failed" ]
    #[nodek: "error" msg: caught]
]

runEnsure: function [env conditionIR][
    condition: runSeq env conditionIR
    if truthy condition -> return null
    caught: try [ throw "assertion failed" ]
    #[nodek: "error" msg: caught]
]

collectionItems: function [coll][
    out: @[]
    if :dictionary = type coll [
        loop coll [k v][ addItem out @[k v] ]
        return out
    ]
    loop coll [v][ addItem out v ]
    out
]

higherGroup: function [env coll params action mode][
    vals: collectionItems coll
    keys: @[]
    groups: @[]
    gathered: #[]
    j: 0
    loop vals [item][
        iterVals: @[item]
        if :dictionary = type coll -> iterVals: item
        child: loopFrame env params iterVals
        groupKey: evalSeq child (lowerBlock action)
        found: neg 1
        if "chunk" = mode [
            if 0 < size keys [
                lastAt: dec size keys
                if same? keys\[lastAt] groupKey -> found: lastAt
            ]
        ]
        if "chunk" <> mode [
            k: 0
            loop keys [known][
                if and? (0 > found) [same? known groupKey] -> found: k
                k: k + 1
            ]
        ]
        if 0 > found [
            addItem keys groupKey
            addItem groups @[]
            found: dec size groups
        ]
        group: groups\[found]
        addItem group item
        set groups found group
        if "gather" = mode -> set gathered groupKey group
        j: j + 1
    ]
    if "gather" = mode -> return gathered
    groups
]

higherApply: function [env coll params action mode][
    vals: collectionItems coll
    out: @[]
    keys: @[]
    count: 0
    bestSet: false
    bestItem: null
    bestKey: null
    j: 0
    while [j < size vals][
        item: vals\[j]
        iterVals: @[item]
        if :dictionary = type coll -> iterVals: item
        child: loopFrame env params iterVals
        result: evalSeq child (lowerBlock action)
        if "map" = mode -> addItem out result
        if "select" = mode -> if truthy result -> addItem out item
        if "filter" = mode -> if not? truthy result -> addItem out item
        if "every?" = mode -> if not? truthy result -> return false
        if "some?" = mode -> if truthy result -> return true
        if "enumerate" = mode -> if truthy result -> count: count + 1
        if or? ("maximum" = mode) ["minimum" = mode] [
            replaceBest: not? bestSet
            if bestSet [
                order: compare result bestKey
                if "maximum" = mode -> replaceBest: 0 < order
                if "minimum" = mode -> replaceBest: 0 > order
            ]
            if replaceBest [
                bestSet: true
                bestItem: item
                bestKey: result
            ]
        ]
        if "arrange" = mode [
            at: size keys
            k: 0
            while [k < size keys][
                if 0 > compare result keys\[k] [
                    at: k
                    k: size keys
                ]
                k: k + 1
            ]
            insert 'keys at result
            insert 'out at item
        ]
        j: j + 1
    ]
    if "every?" = mode -> return true
    if "some?" = mode -> return false
    if "enumerate" = mode -> return count
    if or? ("maximum" = mode) ["minimum" = mode] -> return bestItem
    out
]

evalHigher: function [env argv mode][
    coll: evalNode env argv\0 :interpret
    if or? ("chunk" = mode) [or? ("cluster" = mode) ["gather" = mode]] [
        return higherGroup env coll argv\1 argv\2 mode
    ]
    higherApply env coll argv\1 argv\2 mode
]

runHigher: function [env argv mode][
    coll: runNode env argv\0
    params: runNode env argv\1
    action: runNode env argv\2
    if or? ("chunk" = mode) [or? ("cluster" = mode) ["gather" = mode]] [
        return higherGroup env coll params action mode
    ]
    higherApply env coll params action mode
]

emitHigher: function [env argv name][
    collIR: emitNode env argv\0
    paramsIR: emitNode env argv\1
    actionIR: emitNode env argv\2
    #[op: "call" fn: #[op: "intrinsic" name: name] args: @[collIR paramsIR actionIR]]
]

logicalAggregate: function [values mode][
    stats: tally values
    if "all?" = mode [
        answer: empty? values
        if key? stats true [ answer: (get stats true) = size values ]
        return answer
    ]
    key? stats true
]

evalLogicalAggregate: function [env argv mode][
    values: evalNode env argv\0 :interpret
    logicalAggregate values mode
]

runLogicalAggregate: function [env argv mode][
    values: runNode env argv\0
    logicalAggregate values mode
]

emitLogicalAggregate: function [env argv name][
    valuesIR: emitNode env argv\0
    ; Keep native emission as an ordinary builtin call. runCall still finds
    ; this rule by its intrinsic callee and uses the explicit run behavior.
    #[op: "call" fn: #[op: "intrinsic" name: name] args: @[valuesIR]]
]

runDo: function [env argv][
    v: argv\0
    ; a body is emitted as a seq; an expression as a single node
    if :dictionary = type v [
        w: runNode env v
        if :block = type w -> return evalSeq env (lowerBlock w)
        return w
    ]
    runSeq env v
]

runReturn: function [env argv][
    RET\set: true
    RET\value: runNode env argv\0
    RET\value
]

runWhile: function [env argv][
    while [true][
        cond: runSeq env argv\0
        if RET\set -> break
        if not? truthy cond -> break
        runSeq env argv\1
        if RET\set -> break
        if LOOP_SIGNAL\break -> break
        if LOOP_SIGNAL\continue -> LOOP_SIGNAL\continue: false
    ]
    LOOP_SIGNAL\break: false
    if RET\set -> return RET\value
    null
]

runUntil: function [env argv][
    while [true][
        runSeq env argv\0
        if RET\set -> break
        if LOOP_SIGNAL\break -> break
        if LOOP_SIGNAL\continue -> LOOP_SIGNAL\continue: false
        cond: runSeq env argv\1
        if RET\set -> break
        if truthy cond -> break
    ]
    LOOP_SIGNAL\break: false
    if RET\set -> return RET\value
    null
]

evalWhile: function [env condBlock actionBlock][
    while [true][
        cond: evalSeq env (lowerBlock condBlock)
        if RET\set -> break
        if not? truthy cond -> break
        evalSeq env (lowerBlock actionBlock)
        if RET\set -> break
        if LOOP_SIGNAL\break -> break
        if LOOP_SIGNAL\continue -> LOOP_SIGNAL\continue: false
    ]
    LOOP_SIGNAL\break: false
    if RET\set -> return RET\value
    null
]

evalUntil: function [env actionBlock condBlock][
    while [true][
        evalSeq env (lowerBlock actionBlock)
        if RET\set -> break
        if LOOP_SIGNAL\break -> break
        if LOOP_SIGNAL\continue -> LOOP_SIGNAL\continue: false
        cond: evalSeq env (lowerBlock condBlock)
        if RET\set -> break
        if truthy cond -> break
    ]
    LOOP_SIGNAL\break: false
    if RET\set -> return RET\value
    null
]

; A loop iteration has a child frame: its parameters are local,
; while labels in the body update the nearest existing binding.
; This is the host's action-block scope, and keeps a loop body
; capable of resolving kernel closures through the parent chain.
loopFrame: function [env params boundVals][
    child: newEnv env
    if :block = type params [
        j: 0
        loop params [p][
            if j < size boundVals -> define child (to :string p) boundVals\[j]
            j: j + 1
        ]
    ]
    if :block <> type params [
        if 0 < size boundVals -> define child (to :string params) boundVals\0
    ]
    child\rebind: true
    child
]

evalLoop: function [env collectionNode params actionBlock][
    coll: evalNode env collectionNode :interpret
    if :dictionary = type coll [
        loop coll [k v][
            iterVals: @[]
            addItem iterVals k
            addItem iterVals v
            child: loopFrame env params iterVals
            evalSeq child (lowerBlock actionBlock)
            if RET\set -> break
            if LOOP_SIGNAL\break -> break
            if LOOP_SIGNAL\continue -> LOOP_SIGNAL\continue: false
        ]
        LOOP_SIGNAL\break: false
        if RET\set -> return RET\value
        return null
    ]
    loop coll [v][
        iterVals: @[]
        addItem iterVals v
        child: loopFrame env params iterVals
        evalSeq child (lowerBlock actionBlock)
        if RET\set -> break
        if LOOP_SIGNAL\break -> break
        if LOOP_SIGNAL\continue -> LOOP_SIGNAL\continue: false
    ]
    LOOP_SIGNAL\break: false
    if RET\set -> return RET\value
    null
]

runLoop: function [env argv][
    coll: runNode env argv\0
    params: argv\1
    if :dictionary = type coll [
        loop coll [k v][
            iterVals: @[]
            addItem iterVals k
            addItem iterVals v
            child: loopFrame env params iterVals
            runSeq child argv\2
            if RET\set -> break
            if LOOP_SIGNAL\break -> break
            if LOOP_SIGNAL\continue -> LOOP_SIGNAL\continue: false
        ]
        LOOP_SIGNAL\break: false
        if RET\set -> return RET\value
        return null
    ]
    loop coll [v][
        iterVals: @[]
        addItem iterVals v
        child: loopFrame env params iterVals
        runSeq child argv\2
        if RET\set -> break
        if LOOP_SIGNAL\break -> break
        if LOOP_SIGNAL\continue -> LOOP_SIGNAL\continue: false
    ]
    LOOP_SIGNAL\break: false
    if RET\set -> return RET\value
    null
]

evalRange: function [env fromNode toNode][
    fromVal: evalNode env fromNode :interpret
    toVal: evalNode env toNode :interpret
    fromVal .. toVal
]

runRange: function [env argv][
    fromVal: runNode env argv\0
    toVal: runNode env argv\1
    fromVal .. toVal
]

applyClosure: function [cl argVals][
    child: newEnv cl\env
    params: cl\params
    if :block = type params [
        if 0 < size params [
            loop 0..dec (size params) [j][
                if j < size argVals -> define child (to :string params\[j]) argVals\[j]
            ]
        ]
    ]
    if :block <> type params [
        if not? empty? argVals -> define child (to :string params) argVals\0
    ]
    RET\set: false
    RET\value: null
    result: null
    if cl\ir -> result: runSeq child cl\body
    if not? cl\ir -> result: evalSeq child (lowerBlock cl\body)
    if RET\set [
        RET\set: false
        return RET\value
    ]
    result
]

;-----------------------------------------------
; Build a dictionary from a flat [k v k v ...] block.
;
; NOT `to :dictionary kv`: a dictionary built that way hands
; out COPIES of its values. `get d "inner"` returns a fresh
; dict, so `d\inner\v: 1` — which lowers to
; `set (get d 'inner) 'v 1` — mutated a copy and the write was
; lost. A `#[]` seeded with `set` keeps the references, which
; is what the host's own `#[...]` literal does.
;-----------------------------------------------
makeDictFrom: function [kv][
    d: #[]
    j: 0
    while [j < size kv][
        if (j + 1) < size kv -> set d kv\[j] kv\[j + 1]
        j: j + 2
    ]
    d
]

; Apply a function value to a block of evaluated arguments.
; The shared tail of every call: the callee has been
; evaluated to a value and the args have been evaluated, so
; all that is left is the application itself. The `call`
; row applies this to a block pulled from a dictionary.
applyVal: function [env fnVal argVals][
    if and? (isNode fnVal) [not? null? fnVal\nodek] [
        if "closure" = fnVal\nodek -> return applyClosure fnVal argVals
        if "hostword" = fnVal\nodek [
            ; A pathliteral is a reference only for an intrinsic declared to
            ; mutate through that argument. Predicates/conversions must receive
            ; it as an ordinary value (`pathLiteral? 'a\b`), not trigger the
            ; write-back shim.
            if and? (mutatesThroughRef? fnVal\name) [hasPathRef argVals] [
                return delegateThroughRef env fnVal\name argVals
            ]
            return delegate fnVal\name argVals
        ]
    ]
    #[nodek: "error" msg: ["cannot call" fnVal]]
]

evalCall: function [env node][
    fnNode: node\fn

    ; one row per construct, one lookup, one of its three
    ; behaviours picked by which dispatcher is asking
    r: ruleFor (calleeName fnNode)
    if not? null? r [
        rowArgs: @[]
        addItem rowArgs env
        addItem rowArgs node\args
        return call r\eval rowArgs
    ]

    fnVal: evalNode env fnNode :interpret
    argVals: @[]
    loop node\args [a][ addItem argVals (evalNode env a :interpret) ]
    applyVal env fnVal argVals
]

;=======================================================
; Emit mode — rules producing IR (op-tagged dictionaries)
;=======================================================
isPrimitive: function [v][
    t: type v
    if :integer = t -> return true
    if :floating = t -> return true
    if :string = t -> return true
    if :char = t -> return true
    if :logical = t -> return true
    null? v
]

emitSeq: function [env seq][
    out: @[]
    loop seq [el][ addItem out (emitNode env el) ]
    out
]

emitNode: function [env node][
    if and? (isNode node) ["load" = node\nodek] -> return #[op: "load" name: node\name]
    if and? (isNode node) ["intrinsic" = node\nodek] -> return #[op: "intrinsic" name: node\name]
    if and? (isNode node) ["define" = node\nodek] [
        return #[op: "define" name: node\name expr: emitNode env node\args\0]
    ]
    if and? (isNode node) ["call" = node\nodek] -> return emitCall env node
    if and? (isNode node) ["blockval" = node\nodek] [
        return #[op: "block" items: emitSeq env node\items]
    ]
    if :word = type node -> return #[op: "load" name: to :string node]
    if :inline = type node [
        bodyIR: emitSeq env (lowerBlock (to :block node))
        return #[op: "do" args: @[bodyIR]]
    ]
    if :block = type node -> return #[op: "block" items: node]
    if isPrimitive node -> return #[op: "const" value: node]
    #[op: "passthrough" src: node]
]

emitCall: function [env node][
    fnNode: node\fn
    r: ruleFor (calleeName fnNode)
    if not? null? r [
        rowArgs: @[]
        addItem rowArgs env
        addItem rowArgs node\args
        return call r\emit rowArgs
    ]
    fnIR: emitNode env fnNode
    argsIR: @[]
    loop node\args [a][ addItem argsIR (emitNode env a) ]
    #[op: "call" fn: fnIR args: argsIR]
]

;=======================================================
; The one dispatch — mode ∈ { :interpret, :emit }
;=======================================================
evalNode: function [env node mode][
    if :interpret = mode -> return evalInterpret env node
    emitNode env node
]

evalInterpret: function [env node][
    if and? (isNode node) ["load" = node\nodek] -> return evalLoad env node
    if and? (isNode node) ["intrinsic" = node\nodek] [
        if "break" = node\name [ LOOP_SIGNAL\break: true  return null ]
        if "continue" = node\name [ LOOP_SIGNAL\continue: true  return null ]
        if "true" = node\name -> return true
        if "false" = node\name -> return false
        if "null" = node\name -> return null
        return #[nodek: "hostword" name: node\name]
    ]
    if and? (isNode node) ["define" = node\nodek] -> return evalDefine env node
    if and? (isNode node) ["call" = node\nodek] -> return evalCall env node
    if and? (isNode node) ["blockval" = node\nodek] [
        out: @[]
        loop node\items [it][ addItem out (evalNode env it :interpret) ]
        return out
    ]
    if :word = type node -> return evalWord env node
    if :inline = type node -> return evalInline env node
    if :block = type node -> return node
    if and? (isIR node) ["passthrough" = node\op] -> return node\src
    node
]

evalLoad: function [env node][
    loadRule env node\name
]

evalWord: function [env node][
    name: to :string node
    if "break" = name [ LOOP_SIGNAL\break: true  return null ]
    if "continue" = name [ LOOP_SIGNAL\continue: true  return null ]
    loadRule env name
]

evalInline: function [env node][
    evalSeq env (lowerBlock (to :block node))
]

;=======================================================
; runIR — execute an IR artifact (v0 backend)
;=======================================================
runSeq: function [env seq][
    result: null
    loop seq [el][
        result: runNode env el
        if RET\set -> break
        if LOOP_SIGNAL\break -> break
        if LOOP_SIGNAL\continue -> break
    ]
    result
]

runNode: function [env node][
    if not? isIR node -> return node
    op: node\op
    if "const" = op -> return node\value
    if "load" = op -> return loadRule env node\name
    if "intrinsic" = op [
        if "true" = node\name -> return true
        if "false" = node\name -> return false
        if "null" = node\name -> return null
        return #[nodek: "hostword" name: node\name]
    ]
    if "break" = op [ LOOP_SIGNAL\break: true  return null ]
    if "continue" = op [ LOOP_SIGNAL\continue: true  return null ]
    if "define" = op [
        value: runNode env node\expr
        define env node\name value
        return value
    ]
    if "let" = op -> return runLet env node
    if "block" = op [
        out: @[]
        loop node\items [it][
            if isIR it -> addItem out (runNode env it)
            if not? isIR it -> addItem out it
        ]
        return out
    ]
    if "call" = op -> return runCall env node
    if "passthrough" = op -> return node\src
    ; construct ops: the row's `run` column is authoritative, and
    ; it lives in a shared helper (`runIf` etc.) that both the row
    ; and this branch point at. Called as a plain global — the
    ; host `call` builtin frame one level up from runSeq corrupts
    ; the value stack and a deeper runCall loses its `argVals`.
    if "function" = op -> return runFunction env node\args
    if "if" = op -> return runIf env node\args
    if "unless" = op -> return runUnless env node\args
    if "switch" = op -> return runSwitch env node\args
    if "when" = op -> return runWhen env node\args
    if "using" = op -> return runUsing env node\args
    if "try" = op -> return runTryBlock env node\args\0 false
    if "throws?" = op -> return runTryBlock env node\args\0 true
    if "ensure" = op -> return runEnsure env node\args\0
    if "do" = op -> return runDo env node\args
    if "return" = op -> return runReturn env node\args
    if "while" = op -> return runWhile env node\args
    if "until" = op -> return runUntil env node\args
    if "loop" = op -> return runLoop env node\args
    if "range" = op -> return runRange env node\args
    node
]

runCall: function [env node][
    fnNode: node\fn
    r: ruleFor (irCalleeName fnNode)
    if not? null? r [
        rowArgs: @[]
        addItem rowArgs env
        addItem rowArgs node\args
        return call r\run rowArgs
    ]

    fnVal: runNode env fnNode
    argVals: @[]
    loop node\args [a][ addItem argVals (runNode env a) ]
    applyVal env fnVal argVals
]

;=======================================================
; Entry points
;=======================================================
resetRET: function [][
    RET\set: false
    RET\value: null
    LOOP_SIGNAL\break: false
    LOOP_SIGNAL\continue: false
]

; interpret a source string with the kernel (interpret mode)
interpret: function [src][
    resetRET
    evalSeq (newEnv null) (lowerBlock (to :block src))
]

; compile a source string to IR (emit mode, top level)
compileToIR: function [src][
    emitSeq (newEnv null) (lowerBlock (to :block src))
]

; run an IR artifact (v0 backend)
runIR: function [ir][
    resetRET
    runSeq (newEnv null) ir
]

; run an IR artifact in an existing environment (bootstrap uses
; this to rebuild the compiler from its own IR in a fresh env)
runIRIn: function [env ir][
    resetRET
    runSeq env ir
]

;=======================================================
; The rule table.
;
; One row per construct, carrying its three behaviours: what it
; means when interpreted from source, what IR it emits, and what
; it means when that IR is executed. The three dispatchers above
; do not know these constructs; they look the row up and pick a
; column.
;
; Adding a language feature is adding a row. Getting one of the
; three paths wrong is now a visibly missing or mismatched field
; in a row, rather than a branch someone forgot to add to the
; third `if "while" = name` chain in a different function.
;
; Arity is deliberately NOT here. It is already declared upstream
; and generated into INTRINSICS, and a second copy is a second
; thing to drift. A row says what a construct MEANS; how many
; arguments it takes is Arturo's to say.
;
; All three columns receive the same `[env argv]`. `eval` gets
; source-level argument nodes, `emit` gets those nodes and
; produces an op-tagged dictionary whose `args` is a flat list of
; the emitted arguments, and `run` gets that list back. So `run`
; and `eval` are the same construct in the same shape, one in IR
; and one in source, which is exactly the distinction the table
; exists to make explicit. The op name is the construct name, so
; `runNode` reaches the rows the same way `runCall` does — a
; construct's IR means what its own row says it means, nowhere
; else.
;=======================================================
RULES: #[]

; the row is built at the call site, not passed in piece by
; piece: a function reaching a dictionary literal through a
; WORD is invoked on the spot rather than stored, so
; `#[eval: evalFn]` runs evalFn and keeps its result.
defRule: function [name row][ RULES\[name]: row ]

defRule "function" #[
    eval: function [env argv][ makeClosure env argv\0 argv\1 ]
    emit: function [env argv][
        bodyIR: emitSeq env (lowerBlock argv\1)
        ; host quirk: an inline group that returns a block, written
        ; straight into an `@[...]` literal, is mis-grouped and the
        ; intermediate gets spliced in as an extra element. Bind to
        ; a name first — every emit column does.
        #[op: "function" args: @[argv\0 bodyIR]]
    ]
    run:  function [env argv][ runFunction env argv ]
]

defRule "let" #[
    eval: function [env argv][ evalLet env argv ]
    emit: function [env argv][
        valueIR: emitNode env argv\1
        #[op: "let" name: to :string argv\0 expr: valueIR]
    ]
    run: function [env argv][
        ; Calls dispatch here with a flat argument list only for call-shaped
        ; rules. `let` emits its own op and runNode handles its named field.
        null
    ]
]

defRule "break" #[
    eval: function [env argv][ LOOP_SIGNAL\break: true  null ]
    emit: function [env argv][ #[op: "break" args: @[]] ]
    run: function [env argv][ LOOP_SIGNAL\break: true  null ]
]

defRule "continue" #[
    eval: function [env argv][ LOOP_SIGNAL\continue: true  null ]
    emit: function [env argv][ #[op: "continue" args: @[]] ]
    run: function [env argv][ LOOP_SIGNAL\continue: true  null ]
]

defRule "if" #[
    eval: function [env argv][ evalIf env argv\0 argv\1 ]
    emit: function [env argv][
        condIR: emitNode env argv\0
        yesIR: emitSeq env (lowerBlock argv\1)
        noIR: null
        #[op: "if" args: @[condIR yesIR noIR]]
    ]
    run:  function [env argv][ runIf env argv ]
]

defRule "unless" #[
    eval: function [env argv][ evalUnless env argv\0 argv\1 ]
    emit: function [env argv][
        condIR: emitNode env argv\0
        actionIR: emitSeq env (lowerBlock argv\1)
        #[op: "unless" args: @[condIR actionIR]]
    ]
    run: function [env argv][ runUnless env argv ]
]

defRule "switch" #[
    eval: function [env argv][ evalSwitch env argv\0 argv\1 argv\2 ]
    emit: function [env argv][
        condIR: emitNode env argv\0
        yesIR: emitSeq env (lowerBlock argv\1)
        noIR: emitSeq env (lowerBlock argv\2)
        #[op: "switch" args: @[condIR yesIR noIR]]
    ]
    run: function [env argv][ runSwitch env argv ]
]

defRule "when" #[
    eval: function [env argv][ evalWhen env argv\0 ]
    emit: function [env argv][
        cases: lowerBlock argv\0
        out: @[]
        j: 0
        while [(j + 1) < size cases][
            addItem out (emitNode env cases\[j])
            addItem out (emitSeq env (lowerBlock cases\[j + 1]))
            j: j + 2
        ]
        #[op: "when" args: out]
    ]
    run: function [env argv][ runWhen env argv ]
]

defRule "using" #[
    eval: function [env argv][ evalUsing env argv\0 argv\1 ]
    emit: function [env argv][
        valueIR: emitNode env argv\0
        bodyIR: emitSeq env (lowerBlock argv\1)
        #[op: "using" args: @[valueIR bodyIR]]
    ]
    run: function [env argv][ runUsing env argv ]
]

defRule "try" #[
    eval: function [env argv][ evalTryBlock env argv\0 false ]
    emit: function [env argv][
        bodyIR: emitSeq env (lowerBlock argv\0)
        #[op: "try" args: @[bodyIR]]
    ]
    run: function [env argv][ runTryBlock env argv\0 false ]
]

defRule "throws?" #[
    eval: function [env argv][ evalTryBlock env argv\0 true ]
    emit: function [env argv][
        bodyIR: emitSeq env (lowerBlock argv\0)
        #[op: "throws?" args: @[bodyIR]]
    ]
    run: function [env argv][ runTryBlock env argv\0 true ]
]

defRule "throw" #[
    eval: function [env argv][ evalThrow env argv\0 ]
    emit: function [env argv][
        valueIR: emitNode env argv\0
        #[op: "call" fn: #[op: "intrinsic" name: "throw"] args: @[valueIR]]
    ]
    run: function [env argv][ runThrow env argv\0 ]
]

defRule "error?" #[
    eval: function [env argv][ evalErrorPredicate env argv\0 ]
    emit: function [env argv][
        valueIR: emitNode env argv\0
        #[op: "call" fn: #[op: "intrinsic" name: "error?"] args: @[valueIR]]
    ]
    run: function [env argv][ runErrorPredicate env argv\0 ]
]

defRule "ensure" #[
    eval: function [env argv][ evalEnsure env argv\0 ]
    emit: function [env argv][
        conditionIR: emitSeq env (lowerBlock argv\0)
        #[op: "ensure" args: @[conditionIR]]
    ]
    run: function [env argv][ runEnsure env argv\0 ]
]

defRule "map" #[
    eval: function [env argv][ evalHigher env argv "map" ]
    emit: function [env argv][ emitHigher env argv "map" ]
    run: function [env argv][ runHigher env argv "map" ]
]

defRule "select" #[
    eval: function [env argv][ evalHigher env argv "select" ]
    emit: function [env argv][ emitHigher env argv "select" ]
    run: function [env argv][ runHigher env argv "select" ]
]

defRule "filter" #[
    eval: function [env argv][ evalHigher env argv "filter" ]
    emit: function [env argv][ emitHigher env argv "filter" ]
    run: function [env argv][ runHigher env argv "filter" ]
]

defRule "every?" #[
    eval: function [env argv][ evalHigher env argv "every?" ]
    emit: function [env argv][ emitHigher env argv "every?" ]
    run: function [env argv][ runHigher env argv "every?" ]
]

defRule "some?" #[
    eval: function [env argv][ evalHigher env argv "some?" ]
    emit: function [env argv][ emitHigher env argv "some?" ]
    run: function [env argv][ runHigher env argv "some?" ]
]

defRule "chunk" #[
    eval: function [env argv][ evalHigher env argv "chunk" ]
    emit: function [env argv][ emitHigher env argv "chunk" ]
    run: function [env argv][ runHigher env argv "chunk" ]
]

defRule "cluster" #[
    eval: function [env argv][ evalHigher env argv "cluster" ]
    emit: function [env argv][ emitHigher env argv "cluster" ]
    run: function [env argv][ runHigher env argv "cluster" ]
]

defRule "gather" #[
    eval: function [env argv][ evalHigher env argv "gather" ]
    emit: function [env argv][ emitHigher env argv "gather" ]
    run: function [env argv][ runHigher env argv "gather" ]
]

defRule "arrange" #[
    eval: function [env argv][ evalHigher env argv "arrange" ]
    emit: function [env argv][ emitHigher env argv "arrange" ]
    run: function [env argv][ runHigher env argv "arrange" ]
]

defRule "enumerate" #[
    eval: function [env argv][ evalHigher env argv "enumerate" ]
    emit: function [env argv][ emitHigher env argv "enumerate" ]
    run: function [env argv][ runHigher env argv "enumerate" ]
]

defRule "maximum" #[
    eval: function [env argv][ evalHigher env argv "maximum" ]
    emit: function [env argv][ emitHigher env argv "maximum" ]
    run: function [env argv][ runHigher env argv "maximum" ]
]

defRule "minimum" #[
    eval: function [env argv][ evalHigher env argv "minimum" ]
    emit: function [env argv][ emitHigher env argv "minimum" ]
    run: function [env argv][ runHigher env argv "minimum" ]
]

defRule "all?" #[
    eval: function [env argv][ evalLogicalAggregate env argv "all?" ]
    emit: function [env argv][ emitLogicalAggregate env argv "all?" ]
    run: function [env argv][ runLogicalAggregate env argv "all?" ]
]

defRule "any?" #[
    eval: function [env argv][ evalLogicalAggregate env argv "any?" ]
    emit: function [env argv][ emitLogicalAggregate env argv "any?" ]
    run: function [env argv][ runLogicalAggregate env argv "any?" ]
]

defRule "do" #[
    eval: function [env argv][ evalBody env argv\0 ]
    emit: function [env argv][
        body: argv\0
        if :block = type body [
            bodyIR: emitSeq env (lowerBlock body)
            return #[op: "do" args: @[bodyIR]]
        ]
        exprIR: emitNode env body
        #[op: "do" args: @[exprIR]]
    ]
    run:  function [env argv][ runDo env argv ]
]

defRule "return" #[
    eval: function [env argv][ evalReturn env argv\0 ]
    emit: function [env argv][
        exprIR: emitNode env argv\0
        #[op: "return" args: @[exprIR]]
    ]
    run:  function [env argv][ runReturn env argv ]
]

defRule "while" #[
    eval: function [env argv][ evalWhile env argv\0 argv\1 ]
    emit: function [env argv][
        condIR: emitSeq env (lowerBlock argv\0)
        actionIR: emitSeq env (lowerBlock argv\1)
        #[op: "while" args: @[condIR actionIR]]
    ]
    run:  function [env argv][ runWhile env argv ]
]

defRule "until" #[
    eval: function [env argv][ evalUntil env argv\0 argv\1 ]
    emit: function [env argv][
        actionIR: emitSeq env (lowerBlock argv\0)
        condIR: emitSeq env (lowerBlock argv\1)
        #[op: "until" args: @[actionIR condIR]]
    ]
    run:  function [env argv][ runUntil env argv ]
]

defRule "loop" #[
    eval: function [env argv][ evalLoop env argv\0 argv\1 argv\2 ]
    emit: function [env argv][
        collectionIR: emitNode env argv\0
        bodyIR: emitSeq env (lowerBlock argv\2)
        loopArgs: @[]
        addItem loopArgs collectionIR
        addItem loopArgs argv\1
        addItem loopArgs bodyIR
        #[op: "loop" args: loopArgs]
    ]
    run: function [env argv][ runLoop env argv ]
]

defRule "range" #[
    eval: function [env argv][ evalRange env argv\0 argv\1 ]
    emit: function [env argv][
        fromIR: emitNode env argv\0
        toIR: emitNode env argv\1
        rangeArgs: @[]
        addItem rangeArgs fromIR
        addItem rangeArgs toIR
        #[op: "range" args: rangeArgs]
    ]
    run: function [env argv][ runRange env argv ]
]

; `makeDict` is the one row that is not an Arturo word. The
; front-end lowers a `#[...]` literal into a call to it so the
; field values become nodes the kernel evaluates in order,
; rather than a block the host would re-read. Its emit column
; rebuilds the plain call, which the printer turns back into a
; literal.
defRule "makeDict" #[
    eval: function [env argv][
        kv: @[]
        loop argv [a][ addItem kv (evalNode env a :interpret) ]
        makeDictFrom kv
    ]
    emit: function [env argv][ #[op: "call" fn: #[op: "load" name: "makeDict"] args: emitSeq env argv] ]
    run:  function [env argv][
        kv: @[]
        loop argv [a][ addItem kv (runNode env a) ]
        makeDictFrom kv
    ]
]

; Function values created by the kernel are closures, which deliberately
; cannot be donated to the host. Own this predicate so introspection works
; for both kernel closures and ordinary host functions.
defRule "function?" #[
    eval: function [env argv][
        v: evalNode env argv\0 :interpret
        if and? (isNode v) ["closure" = v\nodek] -> return true
        false
    ]
    emit: function [env argv][
        #[op: "call" fn: #[op: "intrinsic" name: "function?"] args: emitSeq env argv]
    ]
    run: function [env argv][
        v: runNode env argv\0
        if and? (isNode v) ["closure" = v\nodek] -> return true
        false
    ]
]

; `call` is the builtin that takes a function VALUE and a
; block of arguments and applies them. It cannot stay
; delegated: the function value is usually a kernel
; closure, and the delegate refuses to hand kernel-internal
; values to the host — so the kernel applies it itself.
;
; This is the row the rule table is executed by. The
; dispatchers reach their rows through `call r\eval @[...]`,
; pulling a closure out of a dictionary and invoking it, and
; until this row existed that was a call the kernel could
; compile but not run. Its emit column rebuilds the plain
; call to the builtin, which is what the source said.
defRule "call" #[
    eval: function [env argv][
        fnVal: evalNode env argv\0 :interpret
        argBlock: evalNode env argv\1 :interpret
        applyVal env fnVal argBlock
    ]
    emit: function [env argv][ #[op: "call" fn: #[op: "intrinsic" name: "call"] args: emitSeq env argv] ]
    run:  function [env argv][
        fnVal: runNode env argv\0
        argBlock: runNode env argv\1
        applyVal env fnVal argBlock
    ]
]
