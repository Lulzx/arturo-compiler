;=======================================================
; kernel.art — the dual evaluator (M2 interpret + M3 emit)
;
; One dispatch (evalNode), one rule per construct, each
; rule carrying both its interpret behavior and its emit
; behavior. The interpreter and the compiler are the same
; dispatch with the mode flag flipped.
;
;   evalNode env node mode   ; mode ∈ { :interpret, :emit }
;
; Interpret mode evaluates the lowered tree from front.art.
; Emit mode produces IR: op-tagged dictionaries (see ir.art).
; runIR executes an IR artifact (the v0 backend, and the
; value the invariant is checked on).
;
; Host constraints (same as front.art): no `else` keyword,
; `and?`/`or?`/`not?` for logic, `while` needs block
; conditions, runtime symbol values segfault.
;=======================================================

import ./"front.art"

;-----------------------------------------------
; return-signal holder (single-threaded; reset per call)
;-----------------------------------------------
RET: #[set: false value: null]
LOOP_SIGNAL: #[break: false continue: false]
ATTR_STATE: #[current: #[]]

;-----------------------------------------------
; Truthiness: false and null are falsy
;-----------------------------------------------
truthy: function [v][
    if null? v -> return false
    if :logical = type v -> return v
    true
]

;-----------------------------------------------
; Environment: frames with a parent chain
;-----------------------------------------------
newEnv: function [parent][
    #[bindings: #[] parent: parent rebind: false]
]

define: function [env name value][
    if env\rebind [
        target: env
        while [not? null? target][
            if key? target\bindings name [
                target\bindings\[name]: value
                return value
            ]
            target: target\parent
        ]
    ]
    env\bindings\[name]: value
    value
]

letBind: function [env name value][
    target: env
    while [not? null? target][
        if key? target\bindings name [
            target\bindings\[name]: value
            return value
        ]
        target: target\parent
    ]
    env\bindings\[name]: value
    value
]

bound?: function [env name][
    if key? env\bindings name -> return true
    if not? null? env\parent -> return bound? env\parent name
    false
]

lookup: function [env name][
    if key? env\bindings name -> return env\bindings\[name]
    if not? null? env\parent -> return lookup env\parent name
    null
]

;-----------------------------------------------
; Node classification
;-----------------------------------------------
isNode: function [node][
    if :dictionary <> type node -> return false
    key? node "nodek"
]

; an evaluation that failed. `delegate` returns these instead of
; letting the host panic propagate, so any consumer that has to
; tell a failed evaluation apart from a value — the constant
; folder above all — checks for one.
isErrorNode: function [node][
    if not? isNode node -> return false
    "error" = node\nodek
]

isIR: function [node][
    if :dictionary <> type node -> return false
    key? node "op"
]

;-----------------------------------------------
; Donation: hand a hostword and evaluated args to the host
;-----------------------------------------------
delegate: function [name argVals][
    ; never hand kernel-internal values (closures, hostword
    ; markers, errors, IR) to the host — it crashes on them
    loop argVals [v][
        if isNode v -> return #[nodek: "error" msg: ["cannot delegate internal value" v\nodek]]
        if isIR v -> return #[nodek: "error" msg: ["cannot delegate IR value"]]
    ]
    r: null
    ; `do [callee arg...]` is not a safe donation boundary once an evaluated
    ; argument is itself a language token: a :word/:label/:path in that block
    ; is interpreted again as source. `call` accepts an evaluated argument
    ; block and therefore preserves every value kind. A literal names the host
    ; function without invoking it while the call is being assembled.
    err: try [r: call (to :literal name) argVals]
    if :error = type err -> return #[nodek: "error" msg: err]
    r
]

; The donated VM's generic `call` corrupts its value stack for several
; zero-argument builtins. Invoke those directly at this boundary.
delegateNullary: function [name][
    ; The kernel runners receive the target source path as their own argument;
    ; that is harness plumbing, not an argument of the interpreted program.
    if "arg" = name -> return []
    if "args" = name -> return args
    if "now" = name -> return now
    if "env" = name -> return env
    if "path" = name -> return path
    if "process" = name -> return process
    if "script" = name -> return script
    if "sys" = name -> return sys
    if "clear" = name -> return clear
    delegate name @[]
]


;-----------------------------------------------
; Mutation through a path reference.
;
; `pop 'c\stack` hands the host a REFERENCE, not a value: the
; builtin writes back through it. Passing that pathliteral
; straight to `delegate` sent it into a scope where `c` means
; nothing, so the write went nowhere and the kernel diverged
; from the host on every in-place update.
;
; Instead the base is bound locally, the reference is rebuilt
; against that local, and the (mutated) container is written
; back to the environment:
;
;   f 'base\seg... rest   ==   t: <base>;  f 't\seg... rest
;                               base := t
;
; Only `:pathliteral` args are treated this way. A bare `'x` is
; a `:literal` and is ambiguous — `get d 'tag` passes one as a
; key — so those still go through as values.
;-----------------------------------------------
isPathRef: function [v][
    if :pathliteral = type v -> return true
    ; For an intrinsic known to mutate, a bare literal (`'x`) is the
    ; one-segment reference to x. Non-mutating calls never enter the reference
    ; route, so ordinary literal keys remain ordinary values.
    :literal = type v
]

hasPathRef: function [argVals][
    found: false
    loop argVals [v][ if isPathRef v -> found: true ]
    found
]

; "\\stack" / "\\a\\b" — the segments of a path reference, as text
refSegText: function [parts][
    out: ""
    k: 1
    while [k < size parts][
        out: out ++ "\\" ++ (to :string parts\[k])
        k: k + 1
    ]
    out
]

delegateThroughRef: function [env name argVals][
    refAt: 0
    seen: false
    j: 0
    loop argVals [v][
        if not? seen [
            if isPathRef v [ refAt: j  seen: true ]
        ]
        j: j + 1
    ]
    refValue: argVals\[refAt]
    parts: @[]
    if :literal = type refValue -> addItem parts refValue
    if :literal <> type refValue -> parts: to :block refValue
    baseName: to :string parts\0
    if not? bound? env baseName -> return #[nodek: "error" msg: ["unbound path reference" baseName]]

    ; the local the rebuilt reference points at
    __t: lookup env baseName

    blk: @[]
    el0: to :block name
    if not? empty? el0 -> addItem blk el0\0
    j2: 0
    loop argVals [v][
        if j2 = refAt -> addItem blk (first to :block ("'__t" ++ (refSegText parts)))
        if j2 <> refAt -> addItem blk v
        j2: j2 + 1
    ]
    r: null
    err: try [r: do blk]
    if :error = type err -> return #[nodek: "error" msg: err]
    define env baseName __t
    r
]

;-----------------------------------------------
; Specials: lazy / structural constructs handled by name
;-----------------------------------------------
isSpecialName: function [name][
    not? null? ruleFor name
]

ruleFor: function [name][
    if null? name -> return null
    if key? RULES name -> return RULES\[name]
    null
]

;-----------------------------------------------
; The IR-level counterpart of front.art's calleeName: the name
; a call head denotes, whether it was written as a lexical load
; or identified as an intrinsic. Null when the callee is an
; expression — a closure in a variable, a value returned by
; another call — which is precisely when nothing static can be
; said about it.
;-----------------------------------------------
irCalleeName: function [node][
    if not? isIR node -> return null
    if "intrinsic" = node\op -> return node\name
    if "load" = node\op -> return node\name
    null
]

;=======================================================
; Interpret mode — shared helpers
;=======================================================
evalSeq: function [env seq][
    result: null
    loop seq [el][
        result: evalNode env el :interpret
        if RET\set -> break
        if LOOP_SIGNAL\break -> break
        if LOOP_SIGNAL\continue -> break
    ]
    result
]

; evaluate an expression; if the result is a block, execute it
evalBody: function [env node][
    v: evalNode env node :interpret
    if :block = type v -> return evalSeq env (lowerBlock v)
    v
]

loadRule: function [env name][
    if "true" = name -> return true
    if "false" = name -> return false
    if "null" = name -> return null
    if "runtimeError" = name -> return runtimeError
    ; The host resolves COMPILED builtins to the builtin, never to a user
    ; function of the same name (verified: a user `add` does not shadow the
    ; builtin `add`). But STDLIB words (sum, first, last, max, min, ...) are
    ; not compiled opcodes: the host dispatches them through the symbol table,
    ; so a user `sum: function [a b][...]` DOES shadow them. A user binding of
    ; a shadowable word wins over the builtin.
    if key? BUILTIN_ARITY name [
        if and? (key? SHADOWABLE name) [bound? env name] -> return lookup env name
        return #[nodek: "hostword" name: name]
    ]
    if bound? env name -> return lookup env name
    #[nodek: "hostword" name: name]
]

evalDefine: function [env node][
    value: evalNode env node\args\0 :interpret
    define env node\name value
    value
]

evalLet: function [env argv][
    value: evalNode env argv\1 :interpret
    letBind env (to :string argv\0) value
]

evalReturn: function [env valNode][
    RET\set: true
    RET\value: evalNode env valNode :interpret
]

makeClosure: function [env params body][
    #[nodek: "closure" params: params body: body ir: false env: env]
]

evalIf: function [env condNode yesNode][
    cond: evalNode env condNode :interpret
    if truthy cond -> return evalBody env yesNode
    null
]

evalUnless: function [env condNode actionNode][
    cond: evalNode env condNode :interpret
    if not? truthy cond -> return evalBody env actionNode
    null
]

evalSwitch: function [env condNode yesNode noNode][
    cond: evalNode env condNode :interpret
    if truthy cond -> return evalBody env yesNode
    evalBody env noNode
]

evalWhen: function [env casesNode][
    cases: lowerBlock casesNode
    j: 0
    while [(j + 1) < size cases][
        cond: evalNode env cases\[j] :interpret
        if truthy cond -> return evalBody env cases\[j + 1]
        j: j + 2
    ]
    null
]

; The run behaviour of each construct, as a named helper. Each
; row's `run` column points at one (`function [env argv][ runIf
; env argv ]`) and runNode's construct dispatch calls the same
; helper directly — so the meaning lives once, and the two
; pointers cannot drift.
runFunction: function [env argv][
    #[nodek: "closure" params: argv\0 body: argv\1 ir: true env: env]
]

runLet: function [env node][
    value: runNode env node\expr
    letBind env node\name value
]

runIf: function [env argv][
    cond: runNode env argv\0
    if truthy cond -> return runSeq env argv\1
    if not? null? argv\2 -> return runSeq env argv\2
    null
]

runUnless: function [env argv][
    cond: runNode env argv\0
    if not? truthy cond -> return runSeq env argv\1
    null
]

runSwitch: function [env argv][
    cond: runNode env argv\0
    if truthy cond -> return runSeq env argv\1
    runSeq env argv\2
]

runWhen: function [env argv][
    j: 0
    while [(j + 1) < size argv][
        cond: runNode env argv\[j]
        if truthy cond -> return runSeq env argv\[j + 1]
        j: j + 2
    ]
    null
]

evalUsing: function [env valueNode bodyBlock][
    value: evalNode env valueNode :interpret
    child: newEnv env
    define child "this" value
    child\rebind: true
    evalSeq child (lowerBlock bodyBlock)
]

runUsing: function [env argv][
    value: runNode env argv\0
    child: newEnv env
    define child "this" value
    child\rebind: true
    runSeq child argv\1
]

evalTryBlock: function [env bodyBlock predicate][
    result: null
    caught: try [ result: evalSeq env (lowerBlock bodyBlock) ]
    failed: :error = type caught
    if isErrorNode result -> failed: true
    if predicate -> return failed
    if :error = type caught -> return caught
    if isErrorNode result -> return result\msg
    null
]

runTryBlock: function [env bodyIR predicate][
    result: null
    caught: try [ result: runSeq env bodyIR ]
    failed: :error = type caught
    if isErrorNode result -> failed: true
    if predicate -> return failed
    if :error = type caught -> return caught
    if isErrorNode result -> return result\msg
    null
]

evalThrow: function [env valueNode][
    value: evalNode env valueNode :interpret
    caught: try [ throw value ]
    #[nodek: "error" msg: caught]
]

runThrow: function [env valueNode][
    value: runNode env valueNode
    caught: try [ throw value ]
    #[nodek: "error" msg: caught]
]

evalErrorPredicate: function [env valueNode][
    value: evalNode env valueNode :interpret
    if isErrorNode value -> return true
    :error = type value
]

runErrorPredicate: function [env valueNode][
    value: runNode env valueNode
    if isErrorNode value -> return true
    :error = type value
]

evalEnsure: function [env conditionBlock][
    condition: evalSeq env (lowerBlock conditionBlock)
    if truthy condition -> return null
    caught: try [ throw "assertion failed" ]
    #[nodek: "error" msg: caught]
]

runEnsure: function [env conditionIR][
    condition: runSeq env conditionIR
    if truthy condition -> return null
    caught: try [ throw "assertion failed" ]
    #[nodek: "error" msg: caught]
]

collectionItems: function [coll][
    out: @[]
    if :dictionary = type coll [
        loop coll [k v][ addItem out @[k v] ]
        return out
    ]
    loop coll [v][ addItem out v ]
    out
]

higherGroup: function [env coll params action mode][
    vals: collectionItems coll
    keys: @[]
    groups: @[]
    gathered: #[]
    j: 0
    loop vals [item][
        iterVals: @[item]
        if :dictionary = type coll -> iterVals: item
        child: loopFrame env params iterVals
        groupKey: evalSeq child (lowerBlock action)
        found: neg 1
        if "chunk" = mode [
            if 0 < size keys [
                lastAt: dec size keys
                if same? keys\[lastAt] groupKey -> found: lastAt
            ]
        ]
        if "chunk" <> mode [
            k: 0
            loop keys [known][
                if and? (0 > found) [same? known groupKey] -> found: k
                k: k + 1
            ]
        ]
        if 0 > found [
            addItem keys groupKey
            addItem groups @[]
            found: dec size groups
        ]
        group: groups\[found]
        addItem group item
        set groups found group
        if "gather" = mode -> set gathered groupKey group
        j: j + 1
    ]
    if "gather" = mode -> return gathered
    groups
]

higherApply: function [env coll params action mode][
    vals: collectionItems coll
    out: @[]
    keys: @[]
    count: 0
    bestSet: false
    bestItem: null
    bestKey: null
    j: 0
    while [j < size vals][
        item: vals\[j]
        iterVals: @[item]
        if :dictionary = type coll -> iterVals: item
        child: loopFrame env params iterVals
        result: evalSeq child (lowerBlock action)
        if "map" = mode -> addItem out result
        if "select" = mode -> if truthy result -> addItem out item
        if "filter" = mode -> if not? truthy result -> addItem out item
        if "every?" = mode -> if not? truthy result -> return false
        if "some?" = mode -> if truthy result -> return true
        if "enumerate" = mode -> if truthy result -> count: count + 1
        if or? ("maximum" = mode) ["minimum" = mode] [
            replaceBest: not? bestSet
            if bestSet [
                order: compare result bestKey
                if "maximum" = mode -> replaceBest: 0 < order
                if "minimum" = mode -> replaceBest: 0 > order
            ]
            if replaceBest [
                bestSet: true
                bestItem: item
                bestKey: result
            ]
        ]
        if "arrange" = mode [
            at: size keys
            k: 0
            while [k < size keys][
                if 0 > compare result keys\[k] [
                    at: k
                    k: size keys
                ]
                k: k + 1
            ]
            insert 'keys at result
            insert 'out at item
        ]
        j: j + 1
    ]
    if "every?" = mode -> return true
    if "some?" = mode -> return false
    if "enumerate" = mode -> return count
    if or? ("maximum" = mode) ["minimum" = mode] -> return bestItem
    out
]

evalHigher: function [env argv mode][
    if 3 > size argv [ panic ("not enough parameters: " ++ mode) ]
    coll: evalNode env argv\0 :interpret
    if or? ("chunk" = mode) [or? ("cluster" = mode) ["gather" = mode]] [
        return higherGroup env coll argv\1 argv\2 mode
    ]
    higherApply env coll argv\1 argv\2 mode
]

runHigher: function [env argv mode][
    if 3 > size argv [ panic ("not enough parameters: " ++ mode) ]
    coll: runNode env argv\0
    params: runNode env argv\1
    action: runNode env argv\2
    if or? ("chunk" = mode) [or? ("cluster" = mode) ["gather" = mode]] [
        return higherGroup env coll params action mode
    ]
    higherApply env coll params action mode
]

emitHigher: function [env argv name][
    if 3 > size argv [
        msg: "not enough parameters: " ++ name
        return #[op: "call" fn: #[op: "intrinsic" name: "panic"] args: @[#[op: "const" value: msg]]]
    ]
    collIR: emitNode env argv\0
    paramsIR: emitNode env argv\1
    actionIR: emitNode env argv\2
    #[op: "call" fn: #[op: "intrinsic" name: name] args: @[collIR paramsIR actionIR]]
]

logicalAggregate: function [values mode][
    stats: tally values
    if "all?" = mode [
        answer: empty? values
        if key? stats true [ answer: (get stats true) = size values ]
        return answer
    ]
    key? stats true
]

evalLogicalAggregate: function [env argv mode][
    values: evalNode env argv\0 :interpret
    logicalAggregate values mode
]

runLogicalAggregate: function [env argv mode][
    values: runNode env argv\0
    logicalAggregate values mode
]

emitLogicalAggregate: function [env argv name][
    valuesIR: emitNode env argv\0
    ; Keep native emission as an ordinary builtin call. runCall still finds
    ; this rule by its intrinsic callee and uses the explicit run behavior.
    #[op: "call" fn: #[op: "intrinsic" name: name] args: @[valuesIR]]
]

runDo: function [env argv][
    v: argv\0
    ; a body is emitted as a seq; an expression as a single node
    if :dictionary = type v [
        w: runNode env v
        if :block = type w -> return evalSeq env (lowerBlock w)
        return w
    ]
    runSeq env v
]

runReturn: function [env argv][
    RET\set: true
    RET\value: runNode env argv\0
    RET\value
]

runWhile: function [env argv][
    while [true][
        cond: runSeq env argv\0
        if RET\set -> break
        if not? truthy cond -> break
        runSeq env argv\1
        if RET\set -> break
        if LOOP_SIGNAL\break -> break
        if LOOP_SIGNAL\continue -> LOOP_SIGNAL\continue: false
    ]
    LOOP_SIGNAL\break: false
    if RET\set -> return RET\value
    null
]

runUntil: function [env argv][
    while [true][
        runSeq env argv\0
        if RET\set -> break
        if LOOP_SIGNAL\break -> break
        if LOOP_SIGNAL\continue -> LOOP_SIGNAL\continue: false
        cond: runSeq env argv\1
        if RET\set -> break
        if truthy cond -> break
    ]
    LOOP_SIGNAL\break: false
    if RET\set -> return RET\value
    null
]

evalWhile: function [env condBlock actionBlock][
    while [true][
        cond: evalSeq env (lowerBlock condBlock)
        if RET\set -> break
        if not? truthy cond -> break
        evalSeq env (lowerBlock actionBlock)
        if RET\set -> break
        if LOOP_SIGNAL\break -> break
        if LOOP_SIGNAL\continue -> LOOP_SIGNAL\continue: false
    ]
    LOOP_SIGNAL\break: false
    if RET\set -> return RET\value
    null
]

evalUntil: function [env actionBlock condBlock][
    while [true][
        evalSeq env (lowerBlock actionBlock)
        if RET\set -> break
        if LOOP_SIGNAL\break -> break
        if LOOP_SIGNAL\continue -> LOOP_SIGNAL\continue: false
        cond: evalSeq env (lowerBlock condBlock)
        if RET\set -> break
        if truthy cond -> break
    ]
    LOOP_SIGNAL\break: false
    if RET\set -> return RET\value
    null
]

; A loop iteration has a child frame: its parameters are local,
; while labels in the body update the nearest existing binding.
; This is the host's action-block scope, and keeps a loop body
; capable of resolving kernel closures through the parent chain.
loopFrame: function [env params boundVals][
    child: newEnv env
    if :block = type params [
        j: 0
        loop params [p][
            if j < size boundVals -> define child (to :string p) boundVals\[j]
            j: j + 1
        ]
    ]
    if :block <> type params [
        if 0 < size boundVals -> define child (to :string params) boundVals\0
    ]
    child\rebind: true
    child
]

evalLoop: function [env collectionNode params actionBlock][
    coll: evalNode env collectionNode :interpret
    if :dictionary = type coll [
        loop coll [k v][
            iterVals: @[]
            addItem iterVals k
            addItem iterVals v
            child: loopFrame env params iterVals
            evalSeq child (lowerBlock actionBlock)
            if RET\set -> break
            if LOOP_SIGNAL\break -> break
            if LOOP_SIGNAL\continue -> LOOP_SIGNAL\continue: false
        ]
        LOOP_SIGNAL\break: false
        if RET\set -> return RET\value
        return null
    ]
    loop coll [v][
        iterVals: @[]
        addItem iterVals v
        child: loopFrame env params iterVals
        evalSeq child (lowerBlock actionBlock)
        if RET\set -> break
        if LOOP_SIGNAL\break -> break
        if LOOP_SIGNAL\continue -> LOOP_SIGNAL\continue: false
    ]
    LOOP_SIGNAL\break: false
    if RET\set -> return RET\value
    null
]

runLoop: function [env argv][
    coll: runNode env argv\0
    params: argv\1
    if :dictionary = type coll [
        loop coll [k v][
            iterVals: @[]
            addItem iterVals k
            addItem iterVals v
            child: loopFrame env params iterVals
            runSeq child argv\2
            if RET\set -> break
            if LOOP_SIGNAL\break -> break
            if LOOP_SIGNAL\continue -> LOOP_SIGNAL\continue: false
        ]
        LOOP_SIGNAL\break: false
        if RET\set -> return RET\value
        return null
    ]
    loop coll [v][
        iterVals: @[]
        addItem iterVals v
        child: loopFrame env params iterVals
        runSeq child argv\2
        if RET\set -> break
        if LOOP_SIGNAL\break -> break
        if LOOP_SIGNAL\continue -> LOOP_SIGNAL\continue: false
    ]
    LOOP_SIGNAL\break: false
    if RET\set -> return RET\value
    null
]

evalRange: function [env fromNode toNode][
    fromVal: evalNode env fromNode :interpret
    toVal: evalNode env toNode :interpret
    fromVal .. toVal
]

runRange: function [env argv][
    fromVal: runNode env argv\0
    toVal: runNode env argv\1
    fromVal .. toVal
]

applyClosure: function [cl argVals][
    child: newEnv cl\env
    params: cl\params
    if :block = type params [
        if 0 < size params [
            loop 0..dec (size params) [j][
                if j < size argVals -> define child (to :string params\[j]) argVals\[j]
            ]
        ]
    ]
    if :block <> type params [
        if not? empty? argVals -> define child (to :string params) argVals\0
    ]
    RET\set: false
    RET\value: null
    result: null
    if cl\ir -> result: runSeq child cl\body
    if not? cl\ir -> result: evalSeq child (lowerBlock cl\body)
    if RET\set [
        RET\set: false
        return RET\value
    ]
    result
]

;-----------------------------------------------
; Build a dictionary from a flat [k v k v ...] block.
;
; NOT `to :dictionary kv`: a dictionary built that way hands
; out COPIES of its values. `get d "inner"` returns a fresh
; dict, so `d\inner\v: 1` — which lowers to
; `set (get d 'inner) 'v 1` — mutated a copy and the write was
; lost. A `#[]` seeded with `set` keeps the references, which
; is what the host's own `#[...]` literal does.
;-----------------------------------------------
makeDictFrom: function [kv][
    d: #[]
    j: 0
    while [j < size kv][
        if (j + 1) < size kv -> set d kv\[j] kv\[j + 1]
        j: j + 2
    ]
    d
]

; Apply a function value to a block of evaluated arguments.
; The shared tail of every call: the callee has been
; evaluated to a value and the args have been evaluated, so
; all that is left is the application itself. The `call`
; row applies this to a block pulled from a dictionary.
applyVal: function [env fnVal argVals][
    if and? (isNode fnVal) [not? null? fnVal\nodek] [
        if "closure" = fnVal\nodek -> return applyClosure fnVal argVals
        if "hostword" = fnVal\nodek [
            ; A pathliteral is a reference only for an intrinsic declared to
            ; mutate through that argument. Predicates/conversions must receive
            ; it as an ordinary value (`pathLiteral? 'a\b`), not trigger the
            ; write-back shim.
            if and? (mutatesThroughRef? fnVal\name) [hasPathRef argVals] [
                return delegateThroughRef env fnVal\name argVals
            ]
            return delegate fnVal\name argVals
        ]
    ]
    #[nodek: "error" msg: ["cannot call" fnVal]]
]

evalCallAttrs: function [env node mode][
    out: #[]
    if key? node "attrs" [
        loop node\attrs [name valueNode][
            if :interpret = mode -> out\[name]: evalNode env valueNode :interpret
            if :interpret <> mode -> out\[name]: runNode env valueNode
        ]
    ]
    out
]

kernelTruncate: function [text cutoff options][
    filler: "..."
    if key? options "with" -> filler: to :string options\with
    n: size text
    at: cutoff
    if 0 > at -> at: 0
    if key? options "preserve" [
        if n > at [
            i: at
            if i >= n -> i: dec n
            while [and? (i > 0) [not? whitespace? text\[i]]][ i: i - 1 ]
            i: i - 1
            while [and? (i > 0) [whitespace? text\[i]]][ i: i - 1 ]
            if 0 > i -> return filler
            return (slice text 0 i) ++ filler
        ]
        return text
    ]
    if n > (at + size filler) -> return (slice text 0 at) ++ filler
    text
]

kernelCombinations: function [values options][
    width: size values
    if key? options "by" -> width: to :integer options\by
    repeated: key? options "repeated"
    state: #[out: @[]]
    walk: function [st start depth chosen][
        if depth = width [ addItem st\out (new chosen) return null ]
        if start >= size values -> return null
        i: start
        while [i < size values][
            nextChosen: new chosen
            addItem nextChosen values\[i]
            nextStart: i + 1
            if repeated -> nextStart: i
            walk st nextStart (depth + 1) nextChosen
            i: i + 1
        ]
        null
    ]
    if 0 = width -> addItem state\out @[]
    if width > 0 [
        if or? repeated [width <= size values] -> walk state 0 0 @[]
    ]
    if key? options "count" -> return size state\out
    state\out
]

kernelOptionInteger: function [options name][
    if key? options name -> return to :integer options\[name]
    0
]

kernelTwoDigits: function [value][
    text: to :string value
    if 1 = size text -> return "0" ++ text
    text
]

kernelDaysInMonth: function [year month][
    days: [31 28 31 30 31 30 31 31 30 31 30 31]
    result: days\[(month - 1)]
    leap: or? (and? (0 = year % 4) [0 <> year % 100]) [0 = year % 400]
    if and? (2 = month) [leap] -> result: 29
    result
]

kernelShiftDate: function [date options direction][
    shifted: date
    overflowDays: 0
    monthDelta: direction * ((kernelOptionInteger options "months") + 12 * kernelOptionInteger options "years")
    if 0 <> monthDelta [
        totalMonths: (date\year * 12) + (date\month - 1) + monthDelta
        year: div totalMonths 12
        monthIndex: totalMonths % 12
        if 0 > monthIndex [ monthIndex: monthIndex + 12 year: year - 1 ]
        month: monthIndex + 1
        monthLimit: kernelDaysInMonth year month
        day: date\day
        if date\day > monthLimit [ day: monthLimit overflowDays: date\day - monthLimit ]
        dateText: to :string date
        zoneText: slice dateText ((size dateText) - 6) ((size dateText) - 1)
        iso: (to :string year) ++ "-" ++ (kernelTwoDigits month) ++ "-" ++
            (kernelTwoDigits day) ++ "T" ++ (kernelTwoDigits date\hour) ++ ":" ++
            (kernelTwoDigits date\minute) ++ ":" ++ (kernelTwoDigits date\second) ++ zoneText
        shifted: to :date iso
    ]
    secondsPart: kernelOptionInteger options "seconds"
    minutesPart: 60 * kernelOptionInteger options "minutes"
    hoursPart: 3600 * kernelOptionInteger options "hours"
    daysPart: 86400 * ((kernelOptionInteger options "days") + overflowDays)
    weeksPart: 604800 * kernelOptionInteger options "weeks"
    seconds: secondsPart + minutesPart + hoursPart + daysPart + weeksPart
    to :date ((to :integer shifted) + direction * seconds)
]

kernelCodec: function [value options decoding][
    if decoding [
        if key? options "url" -> return decode.url value
        return decode value
    ]
    if key? options "url" [
        hasSpaces: key? options "spaces"
        hasSlashes: key? options "slashes"
        if and? hasSpaces hasSlashes -> return encode.url.spaces.slashes value
        if hasSpaces -> return encode.url.spaces value
        if hasSlashes -> return encode.url.slashes value
        return encode.url value
    ]
    encode value
]

kernelPalette: function [base options][
    if key? options "triad" -> return palette.triad base
    if key? options "tetrad" -> return palette.tetrad base
    if key? options "split" -> return palette.split base
    if key? options "analogous" [
        if key? options "size" -> return palette.analogous.size: options\size base
        return palette.analogous base
    ]
    if key? options "monochrome" [
        if key? options "size" -> return palette.monochrome.size: options\size base
        return palette.monochrome base
    ]
    if key? options "random" [
        if key? options "size" -> return palette.random.size: options\size base
        return palette.random base
    ]
    palette base
]

kernelNormalize: function [pathValue options][
    hasExecutable: key? options "executable"
    hasTilde: key? options "tilde"
    if and? hasExecutable hasTilde -> return normalize.executable.tilde pathValue
    if hasExecutable -> return normalize.executable pathValue
    if hasTilde -> return normalize.tilde pathValue
    normalize pathValue
]

kernelEscape: function [text options][
    if key? options "json" -> return escape.json text
    if key? options "regex" -> return escape.regex text
    if key? options "shell" -> return escape.shell text
    if key? options "xml" -> return escape.xml text
    if key? options "html" -> return escape.html text
    escape text
]

kernelWordwrap: function [text options][
    if key? options "at" -> return wordwrap.at: options\at text
    wordwrap text
]

kernelExtract: function [value options][
    if key? options "directory" -> return extract.directory value
    if key? options "basename" -> return extract.basename value
    if key? options "filename" -> return extract.filename value
    if key? options "extension" -> return extract.extension value
    extract value
]

kernelRender: function [env text options][
    result: to :string text
    rounds: 100
    if key? options "once" -> rounds: 1
    i: 0
    while [i < rounds][
        before: result
        frame: env
        while [not? null? frame][
            loop frame\bindings [name value][ result: replace result ("|" ++ name ++ "|") (to :string value) ]
            frame: frame\parent
        ]
        if before = result -> break
        i: i + 1
    ]
    result
]

kernelBenchmark: function [action options][
    if key? options "get" -> return benchmark.get action
    benchmark action
]

kernelAlphabet: function [locale options][
    hasLower: key? options "lower"
    hasUpper: key? options "upper"
    hasAll: key? options "all"
    if and? hasLower hasUpper [
        if hasAll -> return alphabet.lower.upper.all locale
        return alphabet.lower.upper locale
    ]
    if hasUpper [ if hasAll -> return alphabet.upper.all locale return alphabet.upper locale ]
    if hasAll -> return alphabet.all locale
    alphabet locale
]

kernelDigest: function [value options][
    if key? options "sha" -> return digest.sha value
    digest value
]

kernelHash: function [value options][
    if key? options "string" -> return hash.string value
    hash value
]

kernelCollect: function [collection params condition options][
    if key? options "after" -> return collect.after collection params condition
    collect collection params condition
]

kernelWithValue: function [env value][
    if :block = type value [
        result: @[]
        loop value [item][ addItem result (kernelWithValue env item) ]
        return result
    ]
    if or? (:word = type value) [:literal = type value] [
        name: to :string value
        if bound? env name -> return lookup env name
    ]
    value
]

kernelWith: function [env embed body][
    capture: newEnv env
    if :dictionary = type embed -> loop embed [name value][ define capture name value ]
    if :block = type embed -> loop embed [name][ if bound? env (to :string name) -> define capture (to :string name) (lookup env (to :string name)) ]
    if and? (:dictionary <> type embed) [:block <> type embed] [
        name: to :string embed
        if bound? env name -> define capture name (lookup env name)
    ]
    kernelWithValue capture body
]

kernelSpecify: function [name value options][
    if key? options "property" -> return specify.property name value
    if key? options "symbol" [
        if key? options "describes" -> return specify.symbol: options\symbol .describes: options\describes name value
        return specify.symbol: options\symbol name value
    ]
    if key? options "describes" -> return specify.describes: options\describes name value
    specify name value
]

kernelSortableBody: function [field][
    to :block ("compare this\\" ++ (to :string field) ++ " that\\" ++ (to :string field))
]

kernelSortableIR: function [field][
    keyIR: #[op: "passthrough" src: to :literal to :string field]
    pathFn: #[op: "intrinsic" name: "pathGet"]
    thisLoad: #[op: "load" name: "this"]
    thatLoad: #[op: "load" name: "that"]
    leftArgs: @[]
    addItem leftArgs thisLoad
    addItem leftArgs keyIR
    leftIR: #[op: "call" fn: pathFn args: leftArgs]
    rightArgs: @[]
    addItem rightArgs thatLoad
    addItem rightArgs keyIR
    rightIR: #[op: "call" fn: pathFn args: rightArgs]
    compareFn: #[op: "intrinsic" name: "compare"]
    compareArgs: @[]
    addItem compareArgs leftIR
    addItem compareArgs rightIR
    compareIR: #[op: "call" fn: compareFn args: compareArgs]
    result: @[]
    addItem result compareIR
    result
]

kernelObjectOrder: function [env mode left right][
    order: applyVal env left\compare @[right]
    if "compare" = mode -> return order
    if "less?" = mode -> return order < 0
    if "greater?" = mode -> return order > 0
    if "lessOrEqual?" = mode -> return order <= 0
    if "greaterOrEqual?" = mode -> return order >= 0
    order
]

kernelArity: function [env][
    result: new arity
    frame: env
    while [not? null? frame][
        loop frame\bindings [name value][
            if and? (isNode value) ["closure" = value\nodek] [
                count: 1
                if :block = type value\params -> count: size value\params
                result\[name]: count
            ]
        ]
        frame: frame\parent
    ]
    result
]

kernelSymbols: function [env][
    result: #[]
    frame: env
    while [not? null? frame][
        loop frame\bindings [name value][ if not? key? result name -> result\[name]: value ]
        frame: frame\parent
    ]
    result
]

kernelUnset: function [env name][
    frame: env
    while [not? null? frame][
        if key? frame\bindings name [
            kept: #[]
            loop frame\bindings [key value][ if key <> name -> kept\[key]: value ]
            frame\bindings: kept
            return null
        ]
        frame: frame\parent
    ]
    null
]

kernelPopAttr: function [name][
    if not? key? ATTR_STATE\current name -> return null
    found: ATTR_STATE\current\[name]
    kept: #[]
    loop ATTR_STATE\current [key value][ if key <> name -> kept\[key]: value ]
    ATTR_STATE\current: kept
    found
]

applyAttributed: function [env fnVal argVals callAttributes][
    if empty? callAttributes -> return applyVal env fnVal argVals
    previousAttributes: ATTR_STATE\current
    ATTR_STATE\current: callAttributes
    result: applyVal env fnVal argVals
    ATTR_STATE\current: previousAttributes
    result
]

evalCall: function [env node][
    fnNode: node\fn

    memberMode: calleeName fnNode
    ; Unlike structural nullaries (`break`, `continue`, `attrs`, `now`), raw
    ; CLI arguments have no rule of their own. Resolve this completed call
    ; before callee evaluation would invoke it and then call its result.
    if "arg" = memberMode -> return delegateNullary "arg"
    if "arity" = memberMode -> return kernelArity env
    if "symbols" = memberMode -> return kernelSymbols env
    if "var" = memberMode [
        variableName: evalNode env node\args\0 :interpret
        return lookup env (to :string variableName)
    ]
    if "unset" = memberMode [
        variableName: evalNode env node\args\0 :interpret
        return kernelUnset env (to :string variableName)
    ]
    if "export" = memberMode [
        exported: evalNode env node\args\0 :interpret
        loop exported [name value][ define env name value ]
        return null
    ]
    if "attr" = memberMode [
        attrName: evalNode env node\args\0 :interpret
        return kernelPopAttr (to :string attrName)
    ]
    if "attrs" = memberMode [
        foundAttrs: new ATTR_STATE\current
        ATTR_STATE\current: #[]
        return foundAttrs
    ]
    if "attr?" = memberMode [
        attrName: evalNode env node\args\0 :interpret
        return key? ATTR_STATE\current (to :string attrName)
    ]
    if "truncate" = memberMode [
        text: evalNode env node\args\0 :interpret
        cutoff: evalNode env node\args\1 :interpret
        evaluatedAttrs: evalCallAttrs env node :interpret
        return kernelTruncate (to :string text) cutoff evaluatedAttrs
    ]
    if "combine" = memberMode [
        values: evalNode env node\args\0 :interpret
        evaluatedAttrs: evalCallAttrs env node :interpret
        return kernelCombinations values evaluatedAttrs
    ]
    if or? ("after" = memberMode) ["before" = memberMode] [
        date: evalNode env node\args\0 :interpret
        evaluatedAttrs: evalCallAttrs env node :interpret
        direction: 1
        if "before" = memberMode -> direction: 0 - 1
        return kernelShiftDate date evaluatedAttrs direction
    ]
    if or? ("encode" = memberMode) ["decode" = memberMode] [
        codecValue: evalNode env node\args\0 :interpret
        codecAttrs: evalCallAttrs env node :interpret
        return kernelCodec codecValue codecAttrs ("decode" = memberMode)
    ]
    if "palette" = memberMode [
        paletteBase: evalNode env node\args\0 :interpret
        paletteAttrs: evalCallAttrs env node :interpret
        return kernelPalette paletteBase paletteAttrs
    ]
    if "normalize" = memberMode [
        normalizedPathValue: evalNode env node\args\0 :interpret
        normalizeAttrs: evalCallAttrs env node :interpret
        if and? (isPathRef normalizedPathValue) [empty? normalizeAttrs] [
            return delegateThroughRef env "normalize" @[normalizedPathValue]
        ]
        return kernelNormalize normalizedPathValue normalizeAttrs
    ]
    if "escape" = memberMode [
        escapedText: evalNode env node\args\0 :interpret
        escapeAttrs: evalCallAttrs env node :interpret
        return kernelEscape escapedText escapeAttrs
    ]
    if "wordwrap" = memberMode [
        wrappedText: evalNode env node\args\0 :interpret
        wrapAttrs: evalCallAttrs env node :interpret
        return kernelWordwrap wrappedText wrapAttrs
    ]
    if "extract" = memberMode [
        extractedValue: evalNode env node\args\0 :interpret
        extractAttrs: evalCallAttrs env node :interpret
        return kernelExtract extractedValue extractAttrs
    ]
    if "render" = memberMode [
        templateText: evalNode env node\args\0 :interpret
        renderAttrs: evalCallAttrs env node :interpret
        return kernelRender env templateText renderAttrs
    ]
    if "benchmark" = memberMode [
        benchmarkAction: evalNode env node\args\0 :interpret
        benchmarkAttrs: evalCallAttrs env node :interpret
        return kernelBenchmark benchmarkAction benchmarkAttrs
    ]
    if "alphabet" = memberMode [
        alphabetLocale: evalNode env node\args\0 :interpret
        alphabetAttrs: evalCallAttrs env node :interpret
        return kernelAlphabet alphabetLocale alphabetAttrs
    ]
    if "digest" = memberMode [
        digestValue: evalNode env node\args\0 :interpret
        digestAttrs: evalCallAttrs env node :interpret
        return kernelDigest digestValue digestAttrs
    ]
    if "hash" = memberMode [
        hashedValue: evalNode env node\args\0 :interpret
        hashAttrs: evalCallAttrs env node :interpret
        return kernelHash hashedValue hashAttrs
    ]
    if "collect" = memberMode [
        collectionValue: evalNode env node\args\0 :interpret
        collectionParams: evalNode env node\args\1 :interpret
        collectionCondition: evalNode env node\args\2 :interpret
        collectAttrs: evalCallAttrs env node :interpret
        return kernelCollect collectionValue collectionParams collectionCondition collectAttrs
    ]
    if "with" = memberMode [
        embeddedNames: evalNode env node\args\0 :interpret
        embeddedBody: evalNode env node\args\1 :interpret
        return kernelWith env embeddedNames embeddedBody
    ]
    if "specify" = memberMode [
        unitName: evalNode env node\args\0 :interpret
        unitValue: evalNode env node\args\1 :interpret
        specifyAttrs: evalCallAttrs env node :interpret
        return kernelSpecify unitName unitValue specifyAttrs
    ]
    ; Avoid nesting two host `call r\eval ...` frames for `print to ...`.
    ; The donated VM corrupts its value stack when the inner rule invokes an
    ; object method. Print is simple enough to dispatch directly here.
    if "print" = memberMode [
        value: evalNode env node\args\0 :interpret
        if :block = type value -> value: kernelEvalBlock env value
        if kernelObject? value [
            hasString: key? value "string"
            if key? value "string" [
                stringMethod: value\string
                value: applyVal env stringMethod @[]
            ]
            if not? hasString -> value: kernelVisibleObject value
        ]
        return delegate "print" @[value]
    ]
    if "join" = memberMode [
        joinAttrs: evalCallAttrs env node :interpret
        joinedValue: evalNode env node\args\0 :interpret
        if key? joinAttrs "with" -> return kernelJoinWith joinedValue (to :string joinAttrs\with)
    ]
    if "sort" = memberMode [
        sortAttrs: evalCallAttrs env node :interpret
        sortColl: evalNode env node\args\0 :interpret
        if or? (key? sortAttrs "sensitive") [or? (key? sortAttrs "descending") [key? sortAttrs "as"]] [
            return kernelSort sortColl sortAttrs
        ]
    ]
    if or? ("keys" = memberMode) ["values" = memberMode] [
        if 1 = size node\args [
            memberOwner: evalNode env node\args\0 :interpret
            if kernelObject? memberOwner -> return kernelObjectMembers memberOwner memberMode
        ]
    ]
    if or? ("compare" = memberMode) [or? ("less?" = memberMode) [or? ("greater?" = memberMode) [or? ("lessOrEqual?" = memberMode) ["greaterOrEqual?" = memberMode]]]] [
        orderedLeft: evalNode env node\args\0 :interpret
        if and? (kernelObject? orderedLeft) [key? orderedLeft "compare"] [
            orderedRight: evalNode env node\args\1 :interpret
            return kernelObjectOrder env memberMode orderedLeft orderedRight
        ]
    ]
    if "throw" = memberMode [
        throwAttrs: evalCallAttrs env node :interpret
        if key? throwAttrs "as" [
            thrownValue: evalNode env node\args\0 :interpret
            caughtThrow: try [throw.as: throwAttrs\as thrownValue]
            return #[nodek: "error" msg: caughtThrow]
        ]
    ]

    ; one row per construct, one lookup, one of its three
    ; behaviours picked by which dispatcher is asking
    r: ruleFor (calleeName fnNode)
    if not? null? r [
        rowArgs: @[]
        addItem rowArgs env
        addItem rowArgs node\args
        return call r\eval rowArgs
    ]

    fnVal: evalNode env fnNode :interpret
    argVals: @[]
    loop node\args [a][ addItem argVals (evalNode env a :interpret) ]
    callAttributes: evalCallAttrs env node :interpret
    applyAttributed env fnVal argVals callAttributes
]

;=======================================================
; Emit mode — rules producing IR (op-tagged dictionaries)
;=======================================================
isPrimitive: function [v][
    t: type v
    if :integer = t -> return true
    if :floating = t -> return true
    if :string = t -> return true
    if :char = t -> return true
    if :logical = t -> return true
    null? v
]

emitSeq: function [env seq][
    out: @[]
    loop seq [el][ addItem out (emitNode env el) ]
    out
]

emitNode: function [env node][
    if and? (isNode node) ["load" = node\nodek] -> return #[op: "load" name: node\name]
    if and? (isNode node) ["intrinsic" = node\nodek] -> return #[op: "intrinsic" name: node\name]
    if and? (isNode node) ["define" = node\nodek] [
        return #[op: "define" name: node\name expr: emitNode env node\args\0]
    ]
    if and? (isNode node) ["call" = node\nodek] -> return emitCall env node
    if and? (isNode node) ["blockval" = node\nodek] [
        return #[op: "block" items: emitSeq env node\items]
    ]
    if :word = type node -> return #[op: "load" name: to :string node]
    if :inline = type node [
        bodyIR: emitSeq env (lowerBlock (to :block node))
        return #[op: "do" args: @[bodyIR]]
    ]
    if :block = type node -> return #[op: "block" items: node]
    if isPrimitive node -> return #[op: "const" value: node]
    #[op: "passthrough" src: node]
]

emitCall: function [env node][
    fnNode: node\fn
    r: ruleFor (calleeName fnNode)
    if not? null? r [
        rowArgs: @[]
        addItem rowArgs env
        addItem rowArgs node\args
        emitted: call r\emit rowArgs
        attrsIR: #[]
        if key? node "attrs" -> loop node\attrs [name value][ attrsIR\[name]: emitNode env value ]
        if not? empty? attrsIR -> emitted\attrs: attrsIR
        return emitted
    ]
    fnIR: emitNode env fnNode
    argsIR: @[]
    loop node\args [a][ addItem argsIR (emitNode env a) ]
    attrsIR: #[]
    if key? node "attrs" -> loop node\attrs [name value][ attrsIR\[name]: emitNode env value ]
    #[op: "call" fn: fnIR args: argsIR attrs: attrsIR]
]

;=======================================================
; The one dispatch — mode ∈ { :interpret, :emit }
;=======================================================
evalNode: function [env node mode][
    if :interpret = mode -> return evalInterpret env node
    emitNode env node
]

evalInterpret: function [env node][
    if and? (isNode node) ["load" = node\nodek] -> return evalLoad env node
    if and? (isNode node) ["intrinsic" = node\nodek] [
        if "break" = node\name [ LOOP_SIGNAL\break: true  return null ]
        if "continue" = node\name [ LOOP_SIGNAL\continue: true  return null ]
        if "true" = node\name -> return true
        if "false" = node\name -> return false
        if "null" = node\name -> return null
        if "arity" = node\name -> return kernelArity env
        if "symbols" = node\name -> return kernelSymbols env
        if 0 = BUILTIN_ARITY\[node\name] -> return delegateNullary node\name
        if and? (key? SHADOWABLE node\name) [bound? env node\name] -> return lookup env node\name
        return #[nodek: "hostword" name: node\name]
    ]
    if and? (isNode node) ["define" = node\nodek] -> return evalDefine env node
    if and? (isNode node) ["call" = node\nodek] -> return evalCall env node
    if and? (isNode node) ["blockval" = node\nodek] [
        out: @[]
        loop node\items [it][ addItem out (evalNode env it :interpret) ]
        return out
    ]
    if :word = type node -> return evalWord env node
    if :inline = type node -> return evalInline env node
    if :block = type node -> return node
    if and? (isIR node) ["passthrough" = node\op] -> return node\src
    node
]

evalLoad: function [env node][
    loadRule env node\name
]

evalWord: function [env node][
    name: to :string node
    if "break" = name [ LOOP_SIGNAL\break: true  return null ]
    if "continue" = name [ LOOP_SIGNAL\continue: true  return null ]
    loadRule env name
]

evalInline: function [env node][
    evalSeq env (lowerBlock (to :block node))
]

;=======================================================
; runIR — execute an IR artifact (v0 backend)
;=======================================================
runSeq: function [env seq][
    result: null
    loop seq [el][
        result: runNode env el
        if RET\set -> break
        if LOOP_SIGNAL\break -> break
        if LOOP_SIGNAL\continue -> break
    ]
    result
]

runNode: function [env node][
    if not? isIR node -> return node
    op: node\op
    if "const" = op -> return node\value
    if "load" = op -> return loadRule env node\name
    if "intrinsic" = op [
        if "true" = node\name -> return true
        if "false" = node\name -> return false
        if "null" = node\name -> return null
        if "arity" = node\name -> return kernelArity env
        if "symbols" = node\name -> return kernelSymbols env
        if 0 = BUILTIN_ARITY\[node\name] -> return delegateNullary node\name
        if and? (key? SHADOWABLE node\name) [bound? env node\name] -> return lookup env node\name
        return #[nodek: "hostword" name: node\name]
    ]
    if "break" = op [ LOOP_SIGNAL\break: true  return null ]
    if "continue" = op [ LOOP_SIGNAL\continue: true  return null ]
    if "define" = op [
        value: runNode env node\expr
        define env node\name value
        return value
    ]
    if "let" = op -> return runLet env node
    if "block" = op [
        out: @[]
        loop node\items [it][
            if isIR it -> addItem out (runNode env it)
            if not? isIR it -> addItem out it
        ]
        return out
    ]
    if "call" = op -> return runCall env node
    if "passthrough" = op -> return node\src
    ; construct ops: the row's `run` column is authoritative, and
    ; it lives in a shared helper (`runIf` etc.) that both the row
    ; and this branch point at. Called as a plain global — the
    ; host `call` builtin frame one level up from runSeq corrupts
    ; the value stack and a deeper runCall loses its `argVals`.
    if "function" = op -> return runFunction env node\args
    if "method" = op -> return runFunction env node\args
    if "constructor" = op -> return #[nodek: "constructor" params: node\args\0]
    if "is" = op [
        baseValue: runNode env node\args\0
        extra: runNode env node\args\1
        return kernelInherit env (to :string baseValue) extra
    ]
    if "dictionary" = op -> return runDictionary env node\args\0
    if "if" = op -> return runIf env node\args
    if "unless" = op -> return runUnless env node\args
    if "switch" = op -> return runSwitch env node\args
    if "when" = op -> return runWhen env node\args
    if "using" = op -> return runUsing env node\args
    if "try" = op -> return runTryBlock env node\args\0 false
    if "throws?" = op -> return runTryBlock env node\args\0 true
    if "ensure" = op -> return runEnsure env node\args\0
    if "do" = op -> return runDo env node\args
    if "return" = op -> return runReturn env node\args
    if "while" = op -> return runWhile env node\args
    if "until" = op -> return runUntil env node\args
    if "loop" = op -> return runLoop env node\args
    if "range" = op -> return runRange env node\args
    node
]

runCall: function [env node][
    fnNode: node\fn
    memberMode: irCalleeName fnNode
    if "arg" = memberMode -> return delegateNullary "arg"
    if "arity" = memberMode -> return kernelArity env
    if "symbols" = memberMode -> return kernelSymbols env
    if "var" = memberMode [
        variableName: runNode env node\args\0
        return lookup env (to :string variableName)
    ]
    if "unset" = memberMode [
        variableName: runNode env node\args\0
        return kernelUnset env (to :string variableName)
    ]
    if "export" = memberMode [
        exported: runNode env node\args\0
        loop exported [name value][ define env name value ]
        return null
    ]
    if "attr" = memberMode [
        attrName: runNode env node\args\0
        return kernelPopAttr (to :string attrName)
    ]
    if "attrs" = memberMode [
        foundAttrs: new ATTR_STATE\current
        ATTR_STATE\current: #[]
        return foundAttrs
    ]
    if "attr?" = memberMode [
        attrName: runNode env node\args\0
        return key? ATTR_STATE\current (to :string attrName)
    ]
    if "truncate" = memberMode [
        text: runNode env node\args\0
        cutoff: runNode env node\args\1
        evaluatedAttrs: evalCallAttrs env node :run
        return kernelTruncate (to :string text) cutoff evaluatedAttrs
    ]
    if "combine" = memberMode [
        values: runNode env node\args\0
        evaluatedAttrs: evalCallAttrs env node :run
        return kernelCombinations values evaluatedAttrs
    ]
    if or? ("after" = memberMode) ["before" = memberMode] [
        date: runNode env node\args\0
        evaluatedAttrs: evalCallAttrs env node :run
        direction: 1
        if "before" = memberMode -> direction: 0 - 1
        return kernelShiftDate date evaluatedAttrs direction
    ]
    if or? ("encode" = memberMode) ["decode" = memberMode] [
        codecValue: runNode env node\args\0
        codecAttrs: evalCallAttrs env node :run
        return kernelCodec codecValue codecAttrs ("decode" = memberMode)
    ]
    if "palette" = memberMode [
        paletteBase: runNode env node\args\0
        paletteAttrs: evalCallAttrs env node :run
        return kernelPalette paletteBase paletteAttrs
    ]
    if "normalize" = memberMode [
        normalizedPathValue: runNode env node\args\0
        normalizeAttrs: evalCallAttrs env node :run
        if and? (isPathRef normalizedPathValue) [empty? normalizeAttrs] [
            return delegateThroughRef env "normalize" @[normalizedPathValue]
        ]
        return kernelNormalize normalizedPathValue normalizeAttrs
    ]
    if "escape" = memberMode [
        escapedText: runNode env node\args\0
        escapeAttrs: evalCallAttrs env node :run
        return kernelEscape escapedText escapeAttrs
    ]
    if "wordwrap" = memberMode [
        wrappedText: runNode env node\args\0
        wrapAttrs: evalCallAttrs env node :run
        return kernelWordwrap wrappedText wrapAttrs
    ]
    if "extract" = memberMode [
        extractedValue: runNode env node\args\0
        extractAttrs: evalCallAttrs env node :run
        return kernelExtract extractedValue extractAttrs
    ]
    if "render" = memberMode [
        templateText: runNode env node\args\0
        renderAttrs: evalCallAttrs env node :run
        return kernelRender env templateText renderAttrs
    ]
    if "benchmark" = memberMode [
        benchmarkAction: runNode env node\args\0
        benchmarkAttrs: evalCallAttrs env node :run
        return kernelBenchmark benchmarkAction benchmarkAttrs
    ]
    if "alphabet" = memberMode [
        alphabetLocale: runNode env node\args\0
        alphabetAttrs: evalCallAttrs env node :run
        return kernelAlphabet alphabetLocale alphabetAttrs
    ]
    if "digest" = memberMode [
        digestValue: runNode env node\args\0
        digestAttrs: evalCallAttrs env node :run
        return kernelDigest digestValue digestAttrs
    ]
    if "hash" = memberMode [
        hashedValue: runNode env node\args\0
        hashAttrs: evalCallAttrs env node :run
        return kernelHash hashedValue hashAttrs
    ]
    if "collect" = memberMode [
        collectionValue: runNode env node\args\0
        collectionParams: runNode env node\args\1
        collectionCondition: runNode env node\args\2
        collectAttrs: evalCallAttrs env node :run
        return kernelCollect collectionValue collectionParams collectionCondition collectAttrs
    ]
    if "with" = memberMode [
        embeddedNames: runNode env node\args\0
        embeddedBody: runNode env node\args\1
        return kernelWith env embeddedNames embeddedBody
    ]
    if "specify" = memberMode [
        unitName: runNode env node\args\0
        unitValue: runNode env node\args\1
        specifyAttrs: evalCallAttrs env node :run
        return kernelSpecify unitName unitValue specifyAttrs
    ]
    if "print" = memberMode [
        value: runNode env node\args\0
        if :block = type value [
            blockNode: node\args\0
            if and? (:dictionary = type blockNode) [key? blockNode "items"] [
                rawItems: blockNode\items
                ; a plain block argument keeps raw source tokens and must be
                ; re-lowered as code; an `@[...]` block already holds evaluated
                ; IR nodes and must be left alone.
                if and? (:block = type rawItems) [not? empty? rawItems] [
                    if not? isIR rawItems\0 -> value: kernelEvalBlock env rawItems
                ]
            ]
        ]
        if kernelObject? value [
            hasString: key? value "string"
            if key? value "string" [
                stringMethod: value\string
                value: applyVal env stringMethod @[]
            ]
            if not? hasString -> value: kernelVisibleObject value
        ]
        return delegate "print" @[value]
    ]
    if "join" = memberMode [
        joinAttrs: evalCallAttrs env node :run
        joinedValue: runNode env node\args\0
        if key? joinAttrs "with" -> return kernelJoinWith joinedValue (to :string joinAttrs\with)
    ]
    if "sort" = memberMode [
        sortAttrs: evalCallAttrs env node :run
        sortColl: runNode env node\args\0
        if or? (key? sortAttrs "sensitive") [or? (key? sortAttrs "descending") [key? sortAttrs "as"]] [
            return kernelSort sortColl sortAttrs
        ]
    ]
    if or? ("keys" = memberMode) ["values" = memberMode] [
        if 1 = size node\args [
            memberOwner: runNode env node\args\0
            if kernelObject? memberOwner -> return kernelObjectMembers memberOwner memberMode
        ]
    ]
    if or? ("compare" = memberMode) [or? ("less?" = memberMode) [or? ("greater?" = memberMode) [or? ("lessOrEqual?" = memberMode) ["greaterOrEqual?" = memberMode]]]] [
        orderedLeft: runNode env node\args\0
        if and? (kernelObject? orderedLeft) [key? orderedLeft "compare"] [
            orderedRight: runNode env node\args\1
            return kernelObjectOrder env memberMode orderedLeft orderedRight
        ]
    ]
    if "throw" = memberMode [
        throwAttrs: evalCallAttrs env node :run
        if key? throwAttrs "as" [
            thrownValue: runNode env node\args\0
            caughtThrow: try [throw.as: throwAttrs\as thrownValue]
            return #[nodek: "error" msg: caughtThrow]
        ]
    ]
    r: ruleFor (irCalleeName fnNode)
    if not? null? r [
        rowArgs: @[]
        addItem rowArgs env
        addItem rowArgs node\args
        return call r\run rowArgs
    ]

    fnVal: runNode env fnNode
    argVals: @[]
    loop node\args [a][ addItem argVals (runNode env a) ]
    callAttributes: evalCallAttrs env node :run
    applyAttributed env fnVal argVals callAttributes
]

; A dictionary block is executable namespace construction, not a literal list
; of alternating keys and values. Evaluate it in a child frame, preserve outer
; reads, and return only bindings created by the block.
evalDictionary: function [env body][
    child: newEnv env
    evalSeq child (lowerBlock body)
    child\bindings
]

runDictionary: function [env bodyIR][
    child: newEnv env
    runSeq child bodyIR
    child\bindings
]

kernelObject?: function [v][
    if :dictionary <> type v -> return false
    if not? key? v "__object" -> return false
    true = v\__object
]

kernelMethod?: function [v][
    if not? isNode v -> return false
    if not? key? v "nodek" -> return false
    "closure" = v\nodek
]

kernelConstructor?: function [v][
    if not? isNode v -> return false
    if not? key? v "nodek" -> return false
    "constructor" = v\nodek
]

bindKernelMethod: function [method instance][
    receiver: newEnv method\env
    define receiver "this" instance
    #[nodek: "closure" params: method\params body: method\body ir: method\ir env: receiver]
]

kernelClassName: function [typeName][ "__class_" ++ slice typeName 1 ((size typeName) - 1) ]

kernelInherit: function [env baseName extra][
    base: lookup env (kernelClassName baseName)
    if :dictionary <> type base -> return #[nodek: "error" msg: ["undefined parent type" baseName]]
    merged: #[]
    loop base [name member][ merged\[name]: member ]
    loop extra [name member][
        if and? (key? merged name) [kernelMethod? member] [
            if kernelMethod? merged\[name] -> merged\["__super_" ++ name]: merged\[name]
        ]
        merged\[name]: member
    ]
    merged\__parent: baseName
    merged
]

kernelConstruct: function [env typeName values][
    proto: lookup env (kernelClassName typeName)
    if :dictionary <> type proto -> return #[nodek: "error" msg: ["undefined object type" typeName]]
    instance: #[__object: true __type: typeName]
    loop proto [name member][
        if kernelMethod? member -> instance\[name]: bindKernelMethod member instance
        if not? kernelMethod? member -> instance\[name]: new member
    ]
    loop instance [name member][
        if and? (kernelMethod? member) [not? prefix? name "__"] [
            superName: "__super_" ++ name
            if key? instance superName -> define member\env "super" instance\[superName]
        ]
    ]
    if key? instance "init" [
        if kernelConstructor? instance\init [
            at: 0
            loop instance\init\params [p][
                if :word = type p [
                    name: to :string p
                    if and? (:block = type values) [at < size values] [ instance\[name]: values\[at] at: at + 1 ]
                    if and? (:dictionary = type values) [key? values name] -> instance\[name]: values\[name]
                ]
            ]
        ]
        if not? kernelConstructor? instance\init [
            initArgs: @[]
            if :block = type values -> loop values [v][ addItem initArgs v ]
            if :dictionary = type values [
                params: instance\init\params
                loop params [p][ if key? values (to :string p) -> addItem initArgs values\[(to :string p)] ]
            ]
            applyVal env instance\init initArgs
        ]
    ]
    instance
]

; `print [a b]`-style: a block argument is CODE, so each grouped element is
; evaluated and the results are collected into the block value the host prints.
kernelEvalBlock: function [env blk][
    grouped: lowerBlock blk
    out: @[]
    loop grouped [item][ addItem out (evalNode env item :interpret) ]
    out
]

; `join.with: "sep" block` — the attribute form is kernel-owned because the
; host donation boundary cannot carry call attributes.
kernelJoinWith: function [coll sep][
    if :block <> type coll -> return to :string coll
    out: ""
    first: true
    loop coll [item][
        if not? first -> out: out ++ sep
        out: out ++ (to :string item)
        first: false
    ]
    out
]

; `sort.sensitive` / `sort.descending` — the attribute forms are kernel-owned
; for the same reason as join.with.  Plain `sort` (the locale collation form)
; stays delegated to the host.  The comparator mirrors the host: bytewise
; case-sensitive string order, case-insensitive (stable) default, and numeric
; ordering for numbers.
kernelSortCompare: function [a b sensitive descending][
    ; nested-function scoping shadows assignments, so compare by early return.
    adjust: function [v][
        if descending [
            result: neg v
            return result
        ]
        v
    ]
    if and? (:integer = type a) [:integer = type b] [
        if a < b [
            result: adjust (neg 1)
            return result
        ]
        if b < a [
            result: adjust 1
            return result
        ]
        return 0
    ]
    if and? (:floating = type a) [:floating = type b] [
        if a < b [
            result: adjust (neg 1)
            return result
        ]
        if b < a [
            result: adjust 1
            return result
        ]
        return 0
    ]
    at: to :string a
    bt: to :string b
    if sensitive [
        if at < bt [
            result: adjust (neg 1)
            return result
        ]
        if bt < at [
            result: adjust 1
            return result
        ]
        return 0
    ]
    la: lower at
    lb: lower bt
    if la < lb [
        result: adjust (neg 1)
        return result
    ]
    if lb < la [
        result: adjust 1
        return result
    ]
    0
]

kernelSort: function [coll attrs][
    if :block <> type coll -> return coll
    sensitive: key? attrs "sensitive"
    descending: key? attrs "descending"
    items: @[]
    loop coll [it][ addItem items it ]
    n: size items
    i: 1
    while [i < n][
        j: i
        while [and? (0 < j) [0 > (kernelSortCompare items\[j] items\[j - 1] sensitive descending)]][
            swap: items\[j]
            items\[j]: items\[j - 1]
            items\[j - 1]: swap
            j: j - 1
        ]
        i: i + 1
    ]
    items
]

kernelVisibleObject: function [obj][
    visible: #[]
    loop obj [name value][
        hidden: prefix? name "__"
        if "init" = name -> hidden: true
        if kernelMethod? value -> hidden: true        if not? hidden -> visible\[name]: value
    ]
    visible
]

kernelObjectMembers: function [obj mode][
    out: @[]
    loop obj [name value][
        hidden: prefix? name "__"
        callable: kernelMethod? value
        if kernelConstructor? value -> callable: true
        include: false
        if "methods" = mode -> if and? (not? hidden) [callable] -> include: true
        if "keys" = mode -> if and? (not? hidden) [not? callable] -> include: true
        if "values" = mode -> if and? (not? hidden) [not? callable] -> include: true
        if include [
            if "values" = mode -> addItem out value
            if "values" <> mode -> addItem out name
        ]
    ]
    out
]

;=======================================================
; Entry points
;=======================================================
resetRET: function [][
    RET\set: false
    RET\value: null
    LOOP_SIGNAL\break: false
    LOOP_SIGNAL\continue: false
]

; interpret a source string with the kernel (interpret mode)
interpret: function [src][
    resetRET
    evalSeq (newEnv null) (lowerBlock (to :block prepareSource src))
]

; compile a source string to IR (emit mode, top level)
compileToIR: function [src][
    emitSeq (newEnv null) (lowerBlock (to :block prepareSource src))
]

; run an IR artifact (v0 backend)
runIR: function [ir][
    resetRET
    runSeq (newEnv null) ir
]

; run an IR artifact in an existing environment (bootstrap uses
; this to rebuild the compiler from its own IR in a fresh env)
runIRIn: function [env ir][
    resetRET
    runSeq env ir
]

;=======================================================
; The rule table.
;
; One row per construct, carrying its three behaviours: what it
; means when interpreted from source, what IR it emits, and what
; it means when that IR is executed. The three dispatchers above
; do not know these constructs; they look the row up and pick a
; column.
;
; Adding a language feature is adding a row. Getting one of the
; three paths wrong is now a visibly missing or mismatched field
; in a row, rather than a branch someone forgot to add to the
; third `if "while" = name` chain in a different function.
;
; Arity is deliberately NOT here. It is already declared upstream
; and generated into INTRINSICS, and a second copy is a second
; thing to drift. A row says what a construct MEANS; how many
; arguments it takes is Arturo's to say.
;
; All three columns receive the same `[env argv]`. `eval` gets
; source-level argument nodes, `emit` gets those nodes and
; produces an op-tagged dictionary whose `args` is a flat list of
; the emitted arguments, and `run` gets that list back. So `run`
; and `eval` are the same construct in the same shape, one in IR
; and one in source, which is exactly the distinction the table
; exists to make explicit. The op name is the construct name, so
; `runNode` reaches the rows the same way `runCall` does — a
; construct's IR means what its own row says it means, nowhere
; else.
;=======================================================
RULES: #[]

; the row is built at the call site, not passed in piece by
; piece: a function reaching a dictionary literal through a
; WORD is invoked on the spot rather than stored, so
; `#[eval: evalFn]` runs evalFn and keeps its result.
defRule: function [name row][ RULES\[name]: row ]

defRule "function" #[
    eval: function [env argv][ makeClosure env argv\0 argv\1 ]
    emit: function [env argv][
        bodyIR: emitSeq env (lowerBlock argv\1)
        ; host quirk: an inline group that returns a block, written
        ; straight into an `@[...]` literal, is mis-grouped and the
        ; intermediate gets spliced in as an extra element. Bind to
        ; a name first — every emit column does.
        #[op: "function" args: @[argv\0 bodyIR]]
    ]
    run:  function [env argv][ runFunction env argv ]
]

defRule "method" #[
    eval: function [env argv][ makeClosure env argv\0 argv\1 ]
    emit: function [env argv][
        bodyIR: emitSeq env (lowerBlock argv\1)
        #[op: "method" args: @[argv\0 bodyIR]]
    ]
    run: function [env argv][ runFunction env argv ]
]

defRule "sortable" #[
    eval: function [env argv][ #[nodek: "closure" params: [that] body: kernelSortableIR argv\0 ir: true env: env] ]
    emit: function [env argv][
        bodyIR: kernelSortableIR argv\0
        #[op: "method" args: @[[that] bodyIR]]
    ]
    run: function [env argv][ #[nodek: "closure" params: [that] body: kernelSortableIR argv\0 ir: true env: env] ]
]

defRule "constructor" #[
    eval: function [env argv][ #[nodek: "constructor" params: argv\0] ]
    emit: function [env argv][ #[op: "constructor" args: @[argv\0]] ]
    run: function [env argv][ #[nodek: "constructor" params: argv\0] ]
]

defRule "is" #[
    eval: function [env argv][
        baseValue: evalNode env argv\0 :interpret
        baseName: to :string baseValue
        extra: evalDictionary env argv\1
        kernelInherit env baseName extra
    ]
    emit: function [env argv][
        baseIR: emitNode env argv\0
        bodyIR: emitSeq env (lowerBlock argv\1)
        extraIR: #[op: "dictionary" args: @[bodyIR]]
        #[op: "is" args: @[baseIR extraIR]]
    ]
    run: function [env argv][
        baseValue: runNode env argv\0
        baseName: to :string baseValue
        extra: runNode env argv\1
        kernelInherit env baseName extra
    ]
]

defRule "define" #[
    eval: function [env argv][
        typeName: to :string argv\0
        proto: null
        if :block = type argv\1 -> proto: evalDictionary env argv\1
        if :block <> type argv\1 -> proto: evalNode env argv\1 :interpret
        define env (kernelClassName typeName) proto
        proto
    ]
    emit: function [env argv][
        typeName: to :string argv\0
        if :block = type argv\1 [
            bodyIR: emitSeq env (lowerBlock argv\1)
            return #[op: "define" name: kernelClassName typeName expr: #[op: "dictionary" args: @[bodyIR]]]
        ]
        #[op: "define" name: kernelClassName typeName expr: emitNode env argv\1]
    ]
    run: function [env argv][ null ]
]

defRule "to" #[
    eval: function [env argv][
        target: evalNode env argv\0 :interpret
        value: evalNode env argv\1 :interpret
        targetName: to :string target
        if and? (prefix? targetName ":") [bound? env (kernelClassName targetName)] -> return kernelConstruct env targetName value
        if and? (":string" = targetName) [kernelObject? value] [
            if key? value "string" [
                stringMethod: value\string
                return applyVal env stringMethod @[]
            ]
        ]
        delegate "to" @[target value]
    ]
    emit: function [env argv][
        targetIR: emitNode env argv\0
        valueIR: emitNode env argv\1
        #[op: "call" fn: #[op: "intrinsic" name: "to"] args: @[targetIR valueIR]]
    ]
    run: function [env argv][
        target: runNode env argv\0
        value: runNode env argv\1
        targetName: to :string target
        if and? (prefix? targetName ":") [bound? env (kernelClassName targetName)] -> return kernelConstruct env targetName value
        if and? (":string" = targetName) [kernelObject? value] [
            if key? value "string" [
                stringMethod: value\string
                return applyVal env stringMethod @[]
            ]
        ]
        delegate "to" @[target value]
    ]
]

defRule "type" #[
    eval: function [env argv][
        value: evalNode env argv\0 :interpret
        if kernelObject? value -> return value\__type
        if and? (:dictionary = type value) [key? value "nodek"] [
            if "closure" = value\nodek -> return ":function"
        ]
        delegate "type" @[value]
    ]
    emit: function [env argv][
        valueIR: emitNode env argv\0
        #[op: "call" fn: #[op: "intrinsic" name: "type"] args: @[valueIR]]
    ]
    run: function [env argv][
        value: runNode env argv\0
        if kernelObject? value -> return value\__type
        if and? (:dictionary = type value) [key? value "nodek"] [
            if "closure" = value\nodek -> return ":function"
        ]
        delegate "type" @[value]
    ]
]

defRule "print" #[
    eval: function [env argv][
        value: evalNode env argv\0 :interpret
        if kernelObject? value [
            if key? value "string" [
                stringMethod: value\string
                rendered: applyVal env stringMethod @[]
                return delegate "print" @[rendered]
            ]
            return delegate "print" @[kernelVisibleObject value]
        ]
        delegate "print" @[value]
    ]
    emit: function [env argv][
        valueIR: emitNode env argv\0
        #[op: "call" fn: #[op: "intrinsic" name: "print"] args: @[valueIR]]
    ]
    run: function [env argv][
        value: runNode env argv\0
        if kernelObject? value [
            if key? value "string" [
                stringMethod: value\string
                rendered: applyVal env stringMethod @[]
                return delegate "print" @[rendered]
            ]
            return delegate "print" @[kernelVisibleObject value]
        ]
        delegate "print" @[value]
    ]
]

defRule "object?" #[
    eval: function [env argv][ value: evalNode env argv\0 :interpret kernelObject? value ]
    emit: function [env argv][ valueIR: emitNode env argv\0 #[op: "call" fn: #[op: "intrinsic" name: "object?"] args: @[valueIR]] ]
    run: function [env argv][ value: runNode env argv\0 kernelObject? value ]
]

defRule "method?" #[
    eval: function [env argv][ value: evalNode env argv\0 :interpret kernelMethod? value ]
    emit: function [env argv][ valueIR: emitNode env argv\0 #[op: "call" fn: #[op: "intrinsic" name: "method?"] args: @[valueIR]] ]
    run: function [env argv][ value: runNode env argv\0 kernelMethod? value ]
]

defRule "methods" #[
    eval: function [env argv][ value: evalNode env argv\0 :interpret kernelObjectMembers value "methods" ]
    emit: function [env argv][ valueIR: emitNode env argv\0 #[op: "call" fn: #[op: "intrinsic" name: "methods"] args: @[valueIR]] ]
    run: function [env argv][ value: runNode env argv\0 kernelObjectMembers value "methods" ]
]

defRule "is?" #[
    eval: function [env argv][
        expected: evalNode env argv\0 :interpret
        value: evalNode env argv\1 :interpret
        if kernelObject? value -> return (to :string expected) = value\__type
        delegate "is?" @[expected value]
    ]
    emit: function [env argv][
        expectedIR: emitNode env argv\0
        valueIR: emitNode env argv\1
        #[op: "call" fn: #[op: "intrinsic" name: "is?"] args: @[expectedIR valueIR]]
    ]
    run: function [env argv][
        expected: runNode env argv\0
        value: runNode env argv\1
        if kernelObject? value -> return (to :string expected) = value\__type
        delegate "is?" @[expected value]
    ]
]

defRule "get" #[
    eval: function [env argv][
        owner: evalNode env argv\0 :interpret
        key: evalNode env argv\1 :interpret
        if kernelObject? owner -> return owner\[(to :string key)]
        delegate "get" @[owner key]
    ]
    emit: function [env argv][
        ownerIR: emitNode env argv\0
        keyIR: emitNode env argv\1
        #[op: "call" fn: #[op: "intrinsic" name: "get"] args: @[ownerIR keyIR]]
    ]
    run: function [env argv][
        owner: runNode env argv\0
        key: runNode env argv\1
        if kernelObject? owner -> return owner\[(to :string key)]
        delegate "get" @[owner key]
    ]
]

defRule "pathGet" #[
    eval: function [env argv][
        owner: evalNode env argv\0 :interpret
        key: evalNode env argv\1 :interpret
        value: null
        if :dictionary = type owner -> value: get owner key
        if :dictionary <> type owner -> value: delegate "get" @[owner key]
        if kernelMethod? value [ if empty? value\params -> return applyVal env value @[] ]
        value
    ]
    emit: function [env argv][
        ownerIR: emitNode env argv\0
        keyIR: emitNode env argv\1
        #[op: "call" fn: #[op: "intrinsic" name: "pathGet"] args: @[ownerIR keyIR]]
    ]
    run: function [env argv][
        owner: runNode env argv\0
        key: runNode env argv\1
        value: null
        if :dictionary = type owner -> value: get owner key
        if :dictionary <> type owner -> value: delegate "get" @[owner key]
        if kernelMethod? value [ if empty? value\params -> return applyVal env value @[] ]
        value
    ]
]

defRule "dictionary" #[
    eval: function [env argv][ evalDictionary env argv\0 ]
    emit: function [env argv][
        bodyIR: emitSeq env (lowerBlock argv\0)
        #[op: "dictionary" args: @[bodyIR]]
    ]
    run: function [env argv][ runDictionary env argv\0 ]
]

defRule "module" #[
    eval: function [env argv][
        if :dictionary = type argv\0 -> return argv\0
        evalDictionary env argv\0
    ]
    emit: function [env argv][
        if :dictionary = type argv\0 -> return emitNode env argv\0
        bodyIR: emitSeq env (lowerBlock argv\0)
        #[op: "dictionary" args: @[bodyIR]]
    ]
    run: function [env argv][ runDictionary env argv\0 ]
]

defRule "set?" #[
    eval: function [env argv][ bound? env (to :string argv\0) ]
    emit: function [env argv][
        #[op: "call" fn: #[op: "intrinsic" name: "set?"] args: @[argv\0]]
    ]
    run: function [env argv][
        nameValue: runNode env argv\0
        bound? env (to :string nameValue)
    ]
]

defRule "now" #[
    eval: function [env argv][ now ]
    emit: function [env argv][ #[op: "call" fn: #[op: "intrinsic" name: "now"] args: @[]] ]
    run: function [env argv][ now ]
]

defRule "let" #[
    eval: function [env argv][ evalLet env argv ]
    emit: function [env argv][
        valueIR: emitNode env argv\1
        #[op: "let" name: to :string argv\0 expr: valueIR]
    ]
    run: function [env argv][
        ; Calls dispatch here with a flat argument list only for call-shaped
        ; rules. `let` emits its own op and runNode handles its named field.
        null
    ]
]

defRule "break" #[
    eval: function [env argv][ LOOP_SIGNAL\break: true  null ]
    emit: function [env argv][ #[op: "break" args: @[]] ]
    run: function [env argv][ LOOP_SIGNAL\break: true  null ]
]

defRule "continue" #[
    eval: function [env argv][ LOOP_SIGNAL\continue: true  null ]
    emit: function [env argv][ #[op: "continue" args: @[]] ]
    run: function [env argv][ LOOP_SIGNAL\continue: true  null ]
]

defRule "if" #[
    eval: function [env argv][ evalIf env argv\0 argv\1 ]
    emit: function [env argv][
        condIR: emitNode env argv\0
        yesIR: emitSeq env (lowerBlock argv\1)
        noIR: null
        #[op: "if" args: @[condIR yesIR noIR]]
    ]
    run:  function [env argv][ runIf env argv ]
]

defRule "unless" #[
    eval: function [env argv][ evalUnless env argv\0 argv\1 ]
    emit: function [env argv][
        condIR: emitNode env argv\0
        actionIR: emitSeq env (lowerBlock argv\1)
        #[op: "unless" args: @[condIR actionIR]]
    ]
    run: function [env argv][ runUnless env argv ]
]

defRule "switch" #[
    eval: function [env argv][ evalSwitch env argv\0 argv\1 argv\2 ]
    emit: function [env argv][
        condIR: emitNode env argv\0
        yesIR: emitSeq env (lowerBlock argv\1)
        noIR: emitSeq env (lowerBlock argv\2)
        #[op: "switch" args: @[condIR yesIR noIR]]
    ]
    run: function [env argv][ runSwitch env argv ]
]

defRule "when" #[
    eval: function [env argv][ evalWhen env argv\0 ]
    emit: function [env argv][
        cases: lowerBlock argv\0
        out: @[]
        j: 0
        while [(j + 1) < size cases][
            addItem out (emitNode env cases\[j])
            addItem out (emitSeq env (lowerBlock cases\[j + 1]))
            j: j + 2
        ]
        #[op: "when" args: out]
    ]
    run: function [env argv][ runWhen env argv ]
]

defRule "using" #[
    eval: function [env argv][ evalUsing env argv\0 argv\1 ]
    emit: function [env argv][
        valueIR: emitNode env argv\0
        bodyIR: emitSeq env (lowerBlock argv\1)
        #[op: "using" args: @[valueIR bodyIR]]
    ]
    run: function [env argv][ runUsing env argv ]
]

defRule "try" #[
    eval: function [env argv][ evalTryBlock env argv\0 false ]
    emit: function [env argv][
        bodyIR: emitSeq env (lowerBlock argv\0)
        #[op: "try" args: @[bodyIR]]
    ]
    run: function [env argv][ runTryBlock env argv\0 false ]
]

defRule "throws?" #[
    eval: function [env argv][ evalTryBlock env argv\0 true ]
    emit: function [env argv][
        bodyIR: emitSeq env (lowerBlock argv\0)
        #[op: "throws?" args: @[bodyIR]]
    ]
    run: function [env argv][ runTryBlock env argv\0 true ]
]

defRule "throw" #[
    eval: function [env argv][ evalThrow env argv\0 ]
    emit: function [env argv][
        valueIR: emitNode env argv\0
        #[op: "call" fn: #[op: "intrinsic" name: "throw"] args: @[valueIR]]
    ]
    run: function [env argv][ runThrow env argv\0 ]
]

defRule "error?" #[
    eval: function [env argv][ evalErrorPredicate env argv\0 ]
    emit: function [env argv][
        valueIR: emitNode env argv\0
        #[op: "call" fn: #[op: "intrinsic" name: "error?"] args: @[valueIR]]
    ]
    run: function [env argv][ runErrorPredicate env argv\0 ]
]

defRule "ensure" #[
    eval: function [env argv][ evalEnsure env argv\0 ]
    emit: function [env argv][
        conditionIR: emitSeq env (lowerBlock argv\0)
        #[op: "ensure" args: @[conditionIR]]
    ]
    run: function [env argv][ runEnsure env argv\0 ]
]

defRule "map" #[
    eval: function [env argv][ evalHigher env argv "map" ]
    emit: function [env argv][ emitHigher env argv "map" ]
    run: function [env argv][ runHigher env argv "map" ]
]

defRule "select" #[
    eval: function [env argv][ evalHigher env argv "select" ]
    emit: function [env argv][ emitHigher env argv "select" ]
    run: function [env argv][ runHigher env argv "select" ]
]

defRule "filter" #[
    eval: function [env argv][ evalHigher env argv "filter" ]
    emit: function [env argv][ emitHigher env argv "filter" ]
    run: function [env argv][ runHigher env argv "filter" ]
]

defRule "every?" #[
    eval: function [env argv][ evalHigher env argv "every?" ]
    emit: function [env argv][ emitHigher env argv "every?" ]
    run: function [env argv][ runHigher env argv "every?" ]
]

defRule "some?" #[
    eval: function [env argv][ evalHigher env argv "some?" ]
    emit: function [env argv][ emitHigher env argv "some?" ]
    run: function [env argv][ runHigher env argv "some?" ]
]

defRule "chunk" #[
    eval: function [env argv][ evalHigher env argv "chunk" ]
    emit: function [env argv][ emitHigher env argv "chunk" ]
    run: function [env argv][ runHigher env argv "chunk" ]
]

defRule "cluster" #[
    eval: function [env argv][ evalHigher env argv "cluster" ]
    emit: function [env argv][ emitHigher env argv "cluster" ]
    run: function [env argv][ runHigher env argv "cluster" ]
]

defRule "gather" #[
    eval: function [env argv][ evalHigher env argv "gather" ]
    emit: function [env argv][ emitHigher env argv "gather" ]
    run: function [env argv][ runHigher env argv "gather" ]
]

defRule "arrange" #[
    eval: function [env argv][ evalHigher env argv "arrange" ]
    emit: function [env argv][ emitHigher env argv "arrange" ]
    run: function [env argv][ runHigher env argv "arrange" ]
]

defRule "enumerate" #[
    eval: function [env argv][ evalHigher env argv "enumerate" ]
    emit: function [env argv][ emitHigher env argv "enumerate" ]
    run: function [env argv][ runHigher env argv "enumerate" ]
]

defRule "maximum" #[
    eval: function [env argv][ evalHigher env argv "maximum" ]
    emit: function [env argv][ emitHigher env argv "maximum" ]
    run: function [env argv][ runHigher env argv "maximum" ]
]

defRule "minimum" #[
    eval: function [env argv][ evalHigher env argv "minimum" ]
    emit: function [env argv][ emitHigher env argv "minimum" ]
    run: function [env argv][ runHigher env argv "minimum" ]
]

defRule "all?" #[
    eval: function [env argv][ evalLogicalAggregate env argv "all?" ]
    emit: function [env argv][ emitLogicalAggregate env argv "all?" ]
    run: function [env argv][ runLogicalAggregate env argv "all?" ]
]

defRule "any?" #[
    eval: function [env argv][ evalLogicalAggregate env argv "any?" ]
    emit: function [env argv][ emitLogicalAggregate env argv "any?" ]
    run: function [env argv][ runLogicalAggregate env argv "any?" ]
]

defRule "do" #[
    eval: function [env argv][ evalBody env argv\0 ]
    emit: function [env argv][
        body: argv\0
        if :block = type body [
            bodyIR: emitSeq env (lowerBlock body)
            return #[op: "do" args: @[bodyIR]]
        ]
        exprIR: emitNode env body
        #[op: "do" args: @[exprIR]]
    ]
    run:  function [env argv][ runDo env argv ]
]

defRule "return" #[
    eval: function [env argv][ evalReturn env argv\0 ]
    emit: function [env argv][
        exprIR: emitNode env argv\0
        #[op: "return" args: @[exprIR]]
    ]
    run:  function [env argv][ runReturn env argv ]
]

defRule "while" #[
    eval: function [env argv][ evalWhile env argv\0 argv\1 ]
    emit: function [env argv][
        condIR: emitSeq env (lowerBlock argv\0)
        actionIR: emitSeq env (lowerBlock argv\1)
        #[op: "while" args: @[condIR actionIR]]
    ]
    run:  function [env argv][ runWhile env argv ]
]

defRule "until" #[
    eval: function [env argv][ evalUntil env argv\0 argv\1 ]
    emit: function [env argv][
        actionIR: emitSeq env (lowerBlock argv\0)
        condIR: emitSeq env (lowerBlock argv\1)
        #[op: "until" args: @[actionIR condIR]]
    ]
    run:  function [env argv][ runUntil env argv ]
]

defRule "loop" #[
    eval: function [env argv][ evalLoop env argv\0 argv\1 argv\2 ]
    emit: function [env argv][
        collectionIR: emitNode env argv\0
        bodyIR: emitSeq env (lowerBlock argv\2)
        loopArgs: @[]
        addItem loopArgs collectionIR
        addItem loopArgs argv\1
        addItem loopArgs bodyIR
        #[op: "loop" args: loopArgs]
    ]
    run: function [env argv][ runLoop env argv ]
]

defRule "range" #[
    eval: function [env argv][ evalRange env argv\0 argv\1 ]
    emit: function [env argv][
        fromIR: emitNode env argv\0
        toIR: emitNode env argv\1
        rangeArgs: @[]
        addItem rangeArgs fromIR
        addItem rangeArgs toIR
        #[op: "range" args: rangeArgs]
    ]
    run: function [env argv][ runRange env argv ]
]

; `makeDict` is the one row that is not an Arturo word. The
; front-end lowers a `#[...]` literal into a call to it so the
; field values become nodes the kernel evaluates in order,
; rather than a block the host would re-read. Its emit column
; rebuilds the plain call, which the printer turns back into a
; literal.
defRule "makeDict" #[
    eval: function [env argv][
        kv: @[]
        loop argv [a][ addItem kv (evalNode env a :interpret) ]
        makeDictFrom kv
    ]
    emit: function [env argv][ #[op: "call" fn: #[op: "load" name: "makeDict"] args: emitSeq env argv] ]
    run:  function [env argv][
        kv: @[]
        loop argv [a][ addItem kv (runNode env a) ]
        makeDictFrom kv
    ]
]

; Function values created by the kernel are closures, which deliberately
; cannot be donated to the host. Own this predicate so introspection works
; for both kernel closures and ordinary host functions.
defRule "function?" #[
    eval: function [env argv][
        v: evalNode env argv\0 :interpret
        if and? (isNode v) ["closure" = v\nodek] -> return true
        false
    ]
    emit: function [env argv][
        #[op: "call" fn: #[op: "intrinsic" name: "function?"] args: emitSeq env argv]
    ]
    run: function [env argv][
        v: runNode env argv\0
        if and? (isNode v) ["closure" = v\nodek] -> return true
        false
    ]
]

; `call` is the builtin that takes a function VALUE and a
; block of arguments and applies them. It cannot stay
; delegated: the function value is usually a kernel
; closure, and the delegate refuses to hand kernel-internal
; values to the host — so the kernel applies it itself.
;
; This is the row the rule table is executed by. The
; dispatchers reach their rows through `call r\eval @[...]`,
; pulling a closure out of a dictionary and invoking it, and
; until this row existed that was a call the kernel could
; compile but not run. Its emit column rebuilds the plain
; call to the builtin, which is what the source said.
defRule "call" #[
    eval: function [env argv][
        fnVal: evalNode env argv\0 :interpret
        argBlock: evalNode env argv\1 :interpret
        applyVal env fnVal argBlock
    ]
    emit: function [env argv][ #[op: "call" fn: #[op: "intrinsic" name: "call"] args: emitSeq env argv] ]
    run:  function [env argv][
        fnVal: runNode env argv\0
        argBlock: runNode env argv\1
        applyVal env fnVal argBlock
    ]
]
