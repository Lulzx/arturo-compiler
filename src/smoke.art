; smoke test for kernel interpret (M2)
import ./"kernel.art"

; NOTE: top-level calls to imported functions are compiled
; before imports run (host 0.10.0 behaviour), so all calls
; happen inside a driver function.
run: function [code][
    r: interpret code
    print code
    print (to :string r)
]

go: function [][
    run "1 + 2"
    run "2 * 3 + 4"
    run "10 - 3 - 2"
    run "2 ^ 2 ^ 3"
    run "add: function [a b][a + b] 1 + add 2 3"
    run "g: function [x][x * 2] h: function [x][x + 1] g h 5"
    run "if 1 = 1 [7] [8]"
    run "if 1 = 2 [7] [8]"
    run "do [1 + 2]"
    run "do [[1 2] [3 4]]"
    run "f: function [x][x * 2] f 21"
    run "map [1 2 3] [x][x * 2]"
    run "select [1 2 3 4] [x][x > 2]"
    run "loop 1..3 [x][x + 1]"
    run "2 * (1 + 3)"
    run "f: $[x][x + 2] f 10"
    run "fact: function [n][while [n > 1][n: n - 1] n] fact 5"
    run "j: 0 total: 0 while [j < 4][total: total + j j: j + 1] total"
    run "map [1 2 3] => [& * 2]"
    run "map [1 2 3] 'x [x * 2]"
    run "f: function [x] -> x * 2 f 21"
    run "r: 1..5 size r"

    ; Mutation through paths. The kernel has to match the host
    ; here: a dictionary field is a reference, and a `'c\\stack`
    ; argument is written back through. Not in the corpus —
    ; the host's `-c` drops both, so the compiled engine of the
    ; differential harness cannot agree with the other three.
    run "d: #[inner: #[v: 41]] d\\inner\\v: d\\inner\\v + 1 d\\inner\\v"
    run "c: #[s: @[1 2 3]] append 'c\\s 4 size c\\s"
    run "c: #[s: @[1 2 3]] pop 'c\\s c\\s"
    run "c: #[a: #[b: @[]]] append 'c\\a\\b 7 c\\a\\b"
]
go
