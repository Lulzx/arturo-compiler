; test M4/M5: ir2art printer + folding
import ./"ir.art"

show: function [code][
    ir: compileToIR code
    print code
    print (ir2artSeq ir)
    f: fold ir
    print (ir2artSeq f)
]

go: function [][
    show "1 + 2"
    show "print add 3 4"
    show "add: function [a b][a + b] print add 3 4"
    show "if 1 = 1 [print 7]"
    show "map [1 2 3] [x][x * 2]"
    show "f: function [x][x * 2] f 21"
    show "j: 0 total: 0 while [j < 4][total: total + j j: j + 1] total"
    show "print 10 - add 1 2 - 3"
    show "2 * (1 + 3)"
]
go
