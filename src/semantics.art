;=======================================================
; semantics.art — what the compiler knows that Arturo
; does not declare.
;
; src/intrinsics.art is generated: every fact in it is a
; fact the language implementation states about itself.
; This file is the opposite — the small set of judgements
; the compiler has to make on its own, kept separate so
; that the generated half stays trustworthy.
;
; Keep it small. Anything that grows here is a candidate
; for being derived instead.
;=======================================================

;-----------------------------------------------
; Builtins that accept a :pathliteral but do not write
; through it.
;
; PathLiteral in an argument's type set means "this may be
; handed a path reference". For 100-odd builtins that is
; exactly the in-place write — `append`, `inc`, `insert`.
; For these two it is a lookup: they resolve the path and
; read it. Wrapping their calls in the reference shim would
; be harmless but pointless, and it would put a `do [...]`
; around an expression that never needed one.
;-----------------------------------------------
NOT_MUTATING: #[
    "call": true      ; resolves the path to the function to invoke
    "info": true      ; resolves the path to describe what is there
]

;-----------------------------------------------
; Intrinsics the folder may run at compile time.
;
; Arturo does not declare purity, so this is a judgement and
; not an extracted fact — which is exactly why it lives here
; and not in the generated file. An allowlist, so a builtin
; nobody has thought about is simply not folded.
;
; The folder asks this of an `intrinsic` node only. A call
; through a NAME is whatever that name is bound to when the
; call runs, so `mul a b` where the program has said
; `mul: something` is not this table's business, and used to
; be: the check was `key? PURE_WORDS ff\name` against a node
; that could not tell the two apart.
;-----------------------------------------------
PURE_INTRINSICS: #[
    "add": true  "sub": true  "mul": true  "div": true  "fdiv": true
    ; `divmod` yields an inline pair in the host. Donating it during a fold
    ; leaks both values onto the host stack and corrupts later IR nodes, so it
    ; remains a runtime call even though it has no side effects for value args.
    "mod": true  "pow": true
    "numerator": true  "denominator": true
    "equal?": true  "notEqual?": true  "less?": true  "greater?": true
    "lessOrEqual?": true  "greaterOrEqual?": true
    "and?": true  "or?": true
    "not?": true  "null?": true  "true?": true  "false?": true
    "size": true  "first": true  "last": true  "inc": true  "dec": true
    "type": true  "to": true
    "append": true  "not": true  "and": true  "or": true
    "round": true  "sqrt": true  "ln": true  "log": true
    "sin": true  "cos": true  "tan": true
    "asin": true  "acos": true  "atan": true
    "sinh": true  "cosh": true  "tanh": true
    "asinh": true  "acosh": true  "atanh": true  "gcd": true
    "word?": true  "label?": true  "literal?": true  "symbol?": true
    "type?": true  "inline?": true  "path?": true  "pathLabel?": true
    "pathLiteral?": true  "regex?": true  "attribute?": true
    "attributeLabel?": true  "true?": true  "false?": true  "one?": true
    "ascii?": true  "whitespace?": true  "lower?": true  "upper?": true
    "numeric?": true  "prefix?": true  "suffix?": true
    "between?": true  "same?": true  "all?": true  "any?": true
    "average": true  "clamp": true  "exp": true  "factorial": true
    ; `factors` is pure but returns a block, and the C constant serializer is
    ; intentionally scalar-only. Keep it runtime-evaluated until aggregate
    ; constants are representable by every backend.
    "hypot": true  "lcm": true  "median": true
    "powmod": true  "prime?": true  "variance": true  "deviation": true
    "skewness": true  "kurtosis": true
    "sorted?": true  "disjoint?": true  "intersect?": true
    "subset?": true  "superset?": true
    "sec": true  "sech": true  "csec": true  "csech": true
    "ctan": true  "ctanh": true  "asec": true  "asech": true
    "acsec": true  "acsech": true  "actan": true  "actanh": true
    "atan2": true  "gamma": true  "nand": true  "nor": true
    "xor": true  "xnor": true  "shl": true  "shr": true
    "nand?": true  "nor?": true  "xor?": true  "xnor?": true
    "coalesce": true  "compare": true  "in?": true  "infinite?": true
    "levenshtein": true  "jaro": true  "is?": true
    "defined?": true
]

pureIntrinsic?: function [name][ key? PURE_INTRINSICS name ]
