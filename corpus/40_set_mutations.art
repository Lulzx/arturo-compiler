; reference-mutating set operations preserve left-hand order
a: [1 2 3 2]
difference 'a [2 4]
print a
b: [1 2 2 3]
intersection 'b [2 3 4]
print b
c: [1 2]
union 'c [2 3 3 4]
print c

; nested reference write-back uses the generated mutation metadata
box: #[items: [1 2 3]]
difference 'box\items [1 3]
print box\items
