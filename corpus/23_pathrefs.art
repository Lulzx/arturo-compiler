; paths: reading through `\`, assigning through `\` at one and
; two levels, and index segments — plus `( ... )` grouping,
; which must survive the round-trip as a group and not as a
; block literal.
;
; Mutation through a path *reference* (`append 'c\stack v`) is
; in src/smoke.art instead: the host's `-c` silently drops it,
; so the compiled engine cannot agree with the other three.
c: #[stack: @[10 20 30] n: 0]
print c\stack\1
c\n: (2 + 3) * 2
print c\n
print (size c\stack) + c\n
i: 2
print c\stack\[i]

box: #[inner: #[v: 41]]
box\inner\v: box\inner\v + 1
print box\inner\v
