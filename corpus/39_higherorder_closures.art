; higher-order actions close over kernel-managed function locals
scaled: function [factor][
    map [1 2 3] [x][x * factor]
]
print scaled 4

partitionOut: function [limit][
    filter [1 2 3 4 5] [x][x > limit]
]
print partitionOut 3

selectOver: function [limit][
    select [1 2 3 4 5] [x][x > limit]
]
print selectOver 3

print every? [2 4 6] [x][even? x]
print every? [2 3 6] [x][even? x]
print some? [1 3 4] [x][even? x]
print some? [1 3 5] [x][even? x]
print every? [] [x][missingName]
print some? [] [x][missingName]
