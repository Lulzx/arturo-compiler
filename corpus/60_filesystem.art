write "alpha" "a.txt"
print exists? "a.txt"
print file? "a.txt"
print directory? "."
print hidden? ".secret"
print hidden? "a.txt"
print absolute? "a.txt"
print absolute? "/tmp"

copy "a.txt" "b.txt"
rename "b.txt" "c.txt"
move "c.txt" "d.txt"
print read "d.txt"

symlink "a.txt" "a.link"
print symlink? "a.link"
delete "a.link"
print exists? "a.link"
delete "d.txt"
delete "a.txt"
