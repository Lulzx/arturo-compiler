  {"define", "define new type with given prototype", "Types", "function", 93, "https://github.com/arturo-lang/arturo/blob/v0.9.83/src/library/Types.nim#L93", "type=type;prototype=type,dictionary,block", "", "nothing", "; define a simple type\ndefine :person [name surname]\n\n; and create an object\nsomeone: to :person [\"John\" \"Doe\"]\nprint someone       ; [name:John surname:Doe]; define a simple type\ndefine :person [name surname]\n\n; and create an object\n; using a dictionary with field values\nsomeone: to :person #[surname: \"Doe\", name: \"John\"]\nprint someone       ; [name:John surname:Doe]; define a new type\n; with custom constructor\n\ndefine :person [\n    init: method [name, surname, age][\n        this\\name: name\n        this\\surname: surname\n        this\\dob: now\\year - age\n    ]\n]\n\n; create an object\njd: to :person [\"John\" \"Doe\" 38]\nprint jd            ; [name:John surname:Doe dob:1986]; define type with overloaded\n; magic methods\ndefine :natural [\n    init: constructor [value]\n\n    ; custom `+` overload\n    add: method [x :integer :natural][\n        (integer? x)? -> this\\value + x\n                      -> to :natural @[this\\value + x\\value]\n    ]\n\n    ; custom `to :string` overload\n    string: method [][\n        to :string this\\value\n    ]\n]\n\n; create two new 'natural' numbers\nn1: to :natural @[3]\nn2: to :natural @[5]\n\nprint n1 + n2           ; 8", "name address type description module args attrs returns example line source ", "define new type with given prototype", "", "", "          usage  define type :type\n                        prototype :type :dictionary :block", "        returns  :nothing", ""},
