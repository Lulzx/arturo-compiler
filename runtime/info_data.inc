  {"some?", "check if any of collection's items satisfy given condition", "Iterators", "function", 1438, "https://github.com/arturo-lang/arturo/blob/v0.9.83/src/library/Iterators.nim#L1438", "collection=integer,string,dictionary,object,inline,block,range;params=null,literal,block;condition=block,bytecode", "with=literal:use given index", "logical", "if some? [1 3 5 6 7] 'x [even? x]\n    -> print \"at least one number is an even integer\"\n; at least one number is an even integerprint some? 1..10 'x -> x > 9\n; trueprint some? [4 6 8 10] 'x [prime? x]\n; falseprint some? 1..10 [x y]-> 15 < x+y\n; trueprint some? [2 4 6 9] 'x [prime? x]\n; trueprint some?.with:'i [\"three\" \"two\" \"one\" \"four\" \"five\"] 'x -> i >= size x\n; true", "name address type description module args attrs returns example line source ", "check if any of collection's\nitems satisfy given condition", "", "withuse given index", "          usage  some? collection :integer :string :dictionary :object :inline\n                                  :block :range\n                       params :null :literal :block\n                       condition :block :bytecode", "        returns  :logical", ""},
  {"sort", "sort given collection in ascending order", "Collections", "function", 2018, "https://github.com/arturo-lang/arturo/blob/v0.9.83/src/library/Collections.nim#L2018", "collection=literal,pathliteral,dictionary,block", "as=literal:localized by ISO 639-1 language code;sensitive=logical:case-sensitive sorting;descending=logical:sort in descending order;values=logical:sort dictionary by values;by=string,literal:sort array of dictionaries by given key", "block,nothing", "a: [3 1 6]\nprint sort a                  ; 1 3 6print sort.descending a       ; 6 3 1b: [\"one\" \"two\" \"three\"]\nsort 'b\nprint b                       ; one three two; Creating a Priority Queue\ntasks: []\n\n; add tasks with priorities\n'tasks ++ #[priority: 3 task: \"Low priority\"]\n'tasks ++ #[priority: 1 task: \"Urgent!\"]\n'tasks ++ #[priority: 2 task: \"Important\"]\n\n; sort by priority\nsorted: sort.by: 'priority tasks\nloop sorted 'item ->\n    print [item\\priority \":\" item\\task]\n; 1 : Urgent!\n; 2 : Important\n; 3 : Low priorityspanishWords: [\"uno\",\"dos\",\"tres\",\"Uno\",\"perversión\",\"ábaco\",\"abismo\", \"aberración\"]\nsort.as: 'es spanishWords\n; => [\"ábaco\" \"aberración\" \"abismo\" \"dos\" \"perversión\" \"tres\" \"uno\" \"Uno\"]sort.sensitive [\"c\" \"C\" \"CoffeeScript\" \"nim\" \"Arturo\" \"coffeescript\" \"arturo\" \"Nim\"]\n; => [\"Arturo\" \"C\" \"CoffeeScript\" \"Nim\" \"arturo\" \"c\" \"coffeescript\" \"nim\"]sort.values #[ name: \"John\" surname: \"Doe\" age: 35 income: 5000]\n; => #[age: 35 income: 5000 surname: \"Doe\" name: \"John\" ]", "name address type description module args attrs returns example line source ", "sort given collection in ascending order", "", "aslocalized by ISO 639-1 language codesensitivecase-sensitive sortingdescendingsort in descending ordervaluessort dictionary by valuesbysort array of dictionaries by given key", "          usage  sort collection :literal :pathliteral :dictionary :block", "        returns  :block :nothing", ""},
  {"sortable", "create a sort descriptor method automatically using given type field", "Types", "function", 303, "https://github.com/arturo-lang/arturo/blob/v0.9.83/src/library/Types.nim#L303", "field=literal", "", "method", "define :cat [\n    init: constructor [name :string age :integer]\n    compare: sortable 'age\n]\n\nsnowflake: to :cat [\"Snowflake\" 3]\nsmith: to :cat [\"Smith\" 6]\n\ncompare snowflake smith\n; => -1\nsnowflake < smith\n; => true", "name address type description module args attrs returns example line source ", "create a sort descriptor method automatically\nusing given type field", "", "", "          usage  sortable field :literal", "        returns  :method", ""},
  {"sorted?", "check if given collection is already sorted", "Collections", "function", 2999, "https://github.com/arturo-lang/arturo/blob/v0.9.83/src/library/Collections.nim#L2999", "collection=block", "descending=logical:check for sorting in ascending order", "logical", "sorted? [1 2 3 4 5]         ; => true\nsorted? [4 3 2 1 5]         ; => false\nsorted? [5 4 3 2 1]         ; => falsesorted?.descending [5 4 3 2 1]      ; => true\nsorted?.descending [4 3 2 1 5]      ; => false\nsorted?.descending [1 2 3 4 5]      ; => false", "name address type description module args attrs returns example line source ", "check if given collection is already sorted", "", "descendingcheck for sorting in ascending order", "          usage  sorted? collection :block", "        returns  :logical", ""},
  {"specify", "define new user unit", "Quantities", "function", 177, "https://github.com/arturo-lang/arturo/blob/v0.9.83/src/library/Quantities.nim#L177", "name=string,literal;value=unit,quantity", "symbol=string:define main unit symbol;describes=string:set corresponding property for new unit;property=logical:define a new property", "literal", "specify 'nauMile 1.1508`mi\n\nprint 2`nauMile                ; 2 nauMile\nprint 3`nauMile --> `km        ; 5.5560992256 kmspecify.symbol:\"NM\" 'nauMile 1.1508`mi\n\nprint 2`nauMile                ; 2 NMspecify.describes:\"coding speed\" 'lph `lines/h\n\nprint 100`lph                   ; 100 lph\nprint property 100`lph          ; coding speedspecify.property \"sweetness\" `tspSugar\n\nprint property 3`tspSugar       ; sweetness", "name address type description module args attrs returns example line source ", "define new user unit", "", "symboldefine main unit symboldescribesset corresponding property for new unitpropertydefine a new property", "          usage  specify name :string :literal\n                         value :unit :quantity", "        returns  :literal", ""},
