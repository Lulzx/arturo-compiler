  {"blend", "blend given colors and get result", "Colors", "function", 39, "https://github.com/arturo-lang/arturo/blob/v0.9.83/src/library/Colors.nim#L39", "colorA=literal,pathliteral,color;colorB=color", "balance=floating:use different mix of color (0.0-1.0, default:0.5)", "color", "blend #red #CCCCCC                  ; => #E66666blend .balance: 0.75 #red #CCCCCC   \n; => #D99999", "name address type description module args attrs returns example line source ", "blend given colors and get result", "", "balanceuse different mix of color (0.0-1.0, default:0.5)", "          usage  blend colorA :literal :pathliteral :color\n                       colorB :color", "        returns  :color", ""},
  {"block?", "checks if given value is of type :block", "Types", "function", 523, "https://github.com/arturo-lang/arturo/blob/v0.9.83/src/library/Types.nim#L523", "value=any", "", "logical", "print block? [1 2 3]            ; true\nprint block? #[name: \"John\"]    ; false\nprint block? \"hello\"            ; false\nprint block? 123                ; false", "name address type description module args attrs returns example line source ", "checks if given value is of type :block", "", "", "          usage  block? value :any", "        returns  :logical", ""},
  {"break", "break out of current block or loop", "Core", "function", 122, "https://github.com/arturo-lang/arturo/blob/v0.9.83/src/library/Core.nim#L122", "", "", "nothing", "loop 1..5 'x [\n    print [\"x:\" x]\n    if x=3 -> break\n    print \"after check\"\n]\nprint \"after loop\"\n\n; x: 1\n; after check\n; x: 2\n; after check\n; x: 3\n; after loop", "name address type description module args attrs returns example line source ", "break out of current block or loop", "", "", "          usage  break :nothing", "        returns  :nothing", ""},
