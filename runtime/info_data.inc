  {"connect", "create new socket connection to given server port", "Sockets", "function", 74, "https://github.com/arturo-lang/arturo/blob/v0.9.83/src/library/Sockets.nim#L74", "port=integer", "to=string:set socket address;udp=logical:use UDP instead of TCP", "socket", "; connect to local server on port 18966\nserver: connect 18966; \"connect\" to a udp server on port 12345\nserver: connect.udp 12345; connect to a remote server on port 18966\nserver: connect.to:\"123.456.789.123\" 18966", "name address type description module args attrs returns example line source ", "create new socket connection to given server port", "", "toset socket addressudpuse UDP instead of TCP", "          usage  connect port :integer", "        returns  :socket", ""},
  {"constructor", "create a type constructor method automatically using given arguments", "Types", "function", 53, "https://github.com/arturo-lang/arturo/blob/v0.9.83/src/library/Types.nim#L53", "arguments=literal,block", "", "method", "define :cat [\n    init: constructor [nick :string]\n\n    meow: method [][\n        print [this\\nick \":\" \"'meow!'\"\n    ]\n]\n\nsnowflake: to :cat [15]\n; Assertion | [is? :string nick]\n;     error |\n\nsnowflake: to :cat [\"Snowflake\"]\nsnowflake\\meow\n; Snowflake: 'meow!'", "name address type description module args attrs returns example line source ", "create a type constructor method\nautomatically using given arguments", "", "", "          usage  constructor arguments :literal :block", "        returns  :method", ""},
  {"contains?", "check if collection contains given value", "Collections", "function", 2645, "https://github.com/arturo-lang/arturo/blob/v0.9.83/src/library/Collections.nim#L2645", "collection=string,dictionary,object,block,range;value=any", "at=integer:check at given location within collection;deep=logical:search for a value recursively", "logical", "arr: [1 2 3 4]\n\ncontains? arr 5             ; => false\ncontains? arr 2             ; => trueuser: #[\n    name: \"John\"\n    surname: \"Doe\"\n]\n\ncontains? dict \"John\"       ; => true\ncontains? dict \"Paul\"       ; => false\n\ncontains? keys dict \"name\"  ; => truecontains? \"hello\" \"x\"       ; => false\ncontains? \"hello\" `h`       ; => truecontains?.at:1 \"hello\" \"el\" ; => true\ncontains?.at:4 \"hello\" `o`  ; => trueprint contains?.at:2 [\"one\" \"two\" \"three\"] \"two\"\n; false\n\nprint contains?.at:1 [\"one\" \"two\" \"three\"] \"two\"\n; trueprint contains?.deep [1 2 4 [3 4 [5 6] 7] 8 [9 10]] 6\n; trueuser: #[ \n    name: \"John\" surname: \"Doe\"\n    mom: #[ name: \"Jane\" surname: \"Doe\" ]\n]\n\nprint contains?.deep user \"Jane\"\n; true", "name address type description module args attrs returns example line source ", "check if collection contains given value", "", "atcheck at given location within collectiondeepsearch for a value recursively", "          usage  contains? collection :string :dictionary :object :block :range\n                           value :any", "        returns  :logical", ""},
  {"continue", "immediately continue with next iteration", "Core", "function", 374, "https://github.com/arturo-lang/arturo/blob/v0.9.83/src/library/Core.nim#L374", "", "", "nothing", "loop 1..5 'x [\n    print [\"x:\" x]\n    if x=3 -> continue\n    print \"after check\"\n]\nprint \"after loop\"\n\n; x: 1 \n; after check\n; x: 2 \n; after check\n; x: 3 \n; x: 4 \n; after check\n; x: 5 \n; after check\n; after loop", "name address type description module args attrs returns example line source ", "immediately continue with next iteration", "", "", "          usage  continue :nothing", "        returns  :nothing", ""},
