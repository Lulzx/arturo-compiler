  {"attrs", "get dictionary of set attributes", "Reflection", "function", 91, "https://github.com/arturo-lang/arturo/blob/v0.9.83/src/library/Reflection.nim#L91", "", "", "dictionary", "greet: function [x][\n    print [\"Hello\" x \"!\"]\n    print attrs\n]\n\ngreet.later \"John\"\n\n; Hello John!\n; [\n;    later:    true\n; ]", "name address type description module args attrs returns example line source ", "get dictionary of set attributes", "", "", "          usage  attrs :nothing", "        returns  :dictionary", ""},
  {"average", "get average from given collection of numbers", "Statistics", "function", 43, "https://github.com/arturo-lang/arturo/blob/v0.9.83/src/library/Statistics.nim#L43", "collection=block,range", "", "floating", "print average [2 4 5 6 7 2 3]\n; 4.142857142857143", "name address type description module args attrs returns example line source ", "get average from given collection of numbers", "", "", "          usage  average collection :block :range", "        returns  :floating", ""},
  {"before", "get date before given one using interval", "Dates", "function", 100, "https://github.com/arturo-lang/arturo/blob/v0.9.83/src/library/Dates.nim#L100", "date=literal,pathliteral,date", "nanoseconds=integer:subtract given number of nanoseconds;milliseconds=integer:subtract given number of milliseconds;seconds=integer:subtract given number of seconds;minutes=integer:subtract given number of minutes;hours=integer:subtract given number of hours;days=integer:subtract given number of days;weeks=integer:subtract given number of weeks;months=integer:subtract given number of months;years=integer:subtract given number of years", "date", "print now\n; 2021-03-22T11:27:00+01:00\n\nprint before.weeks:2 now\n; 2021-03-08T11:27:14+01:00\n\nprint before.years:1 now\n; 2020-03-22T11:27:23+01:00", "name address type description module args attrs returns example line source ", "get date before given one using interval", "", "nanosecondssubtract given number of nanosecondsmillisecondssubtract given number of millisecondssecondssubtract given number of secondsminutessubtract given number of minuteshourssubtract given number of hoursdayssubtract given number of daysweekssubtract given number of weeksmonthssubtract given number of monthsyearssubtract given number of years", "          usage  before date :literal :pathliteral :date", "        returns  :date", ""},
  {"benchmark", "benchmark given code", "Reflection", "function", 115, "https://github.com/arturo-lang/arturo/blob/v0.9.83/src/library/Reflection.nim#L115", "action=block,bytecode", "get=logical:get benchmark time", "floating,nothing", "benchmark [ \n    ; some process that takes some time\n    loop 1..10000 => prime? \n]\n\n; [benchmark] time: 0.065sbenchmark.get [\n    loop 1..10000 => prime?\n]\n; => 0.3237628936767578", "name address type description module args attrs returns example line source ", "benchmark given code", "", "getget benchmark time", "          usage  benchmark action :block :bytecode", "        returns  :floating :nothing", ""},
  {"between?", "check if given value is between the given values (inclusive)", "Comparison", "function", 82, "https://github.com/arturo-lang/arturo/blob/v0.9.83/src/library/Comparison.nim#L82", "value=any;rangeFrom=any;rangeTo=any", "", "logical", "between? 1 2 3      ; => false\nbetween? 2 0 3      ; => true\nbetween? 3 2 3      ; => true\nbetween? 3 3 2      ; => true\n\n1 <=> 2 3           ; => false\n1 <=> 3 2           ; => false\n2 <=> 0 3           ; => true\n2 <=> 3 0           ; => true\n3 <=> 2 3           ; => true", "name address type description module args attrs returns alias infix? example line source ", "check if given value is between\nthe given values (inclusive)", "<=>", "", "          usage  between? value :any\n                          rangeFrom :any\n                          rangeTo :any", "        returns  :logical", "true"},
