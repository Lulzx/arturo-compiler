  {"sech", "calculate the hyperbolic secant of given angle", "Numbers", "function", 1150, "https://github.com/arturo-lang/arturo/blob/v0.9.83/src/library/Numbers.nim#L1150", "angle=integer,floating,complex,rational,quantity", "", "floating,complex", "print sech 0                ; 1.0\nprint sech 0.3              ; 0.9566279119002483\nprint sech 1.0              ; 0.6480542736638855sech to :complex [1 1]\n; => 0.4983370305551868-0.5910838417210451i", "name address type description module args attrs returns example line source ", "calculate the hyperbolic secant of given angle", "", "", "          usage  sech angle :integer :floating :complex :rational :quantity", "        returns  :floating :complex", ""},
  {"select", "get items in collection that satisfy given condition", "Iterators", "function", 1245, "https://github.com/arturo-lang/arturo/blob/v0.9.83/src/library/Iterators.nim#L1245", "collection=integer,string,literal,dictionary,object,inline,block,range;params=null,literal,block;condition=block,bytecode", "with=literal:use given index;first=logical,integer:only return first element/s;last=logical,integer:only return last element/s;n=integer:only return n-th element", "block,nothing,any", "print select 1..10 [x][\n    even? x\n]\n; 2 4 6 8 10arr: 1..10\nselect 'arr 'x -> even? x\nprint arr\n; 2 4 6 8 10select [1 1 2 3 5 8 13 21] [x y]-> odd? x+y\n; => [2 3 5 8]select.with:'i [\"zero\" \"one\" \"two\" \"three\" \"four\" \"five\"] []-> even? i\n; => [\"zero\" \"two\" \"four\"]select.first 1..10 => odd?\n=> [1]\n\nselect.first:3 1..10 => odd?\n=> [1 3 5]select.last 1..10 => odd?\n=> [9]\n\nselect.last:3 1..10 => odd?\n=> [5 7 9]", "name address type description module args attrs returns example line source ", "get items in collection that\nsatisfy given condition", "", "withuse given indexfirstonly return first element/slastonly return last element/snonly return n-th element", "          usage  select collection :integer :string :literal :dictionary :object\n                                   :inline :block :range\n                        params :null :literal :block\n                        condition :block :bytecode", "        returns  :block :nothing :any", ""},
