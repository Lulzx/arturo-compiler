import ./"../src/ir.art"
import ./"../src/front.art"
zzprobe: function [][
    ir: fold (compileToIR (read "src/front.art"))
    loop ir [n][
        if :dictionary = type n [
            if "call" = n\op [
                if :dictionary = type n\fn [
                    if "intrinsic" = n\fn\op [
                        if "loop" = n\fn\name [
                            act: n\args\2
                            print "action op: " ++ (to :string act\op)
                            loop act\items [i][
                                print (to :string (type i))
                            ]
                        ]
                    ]
                ]
            ]
        ]
    ]
]
zzprobe
