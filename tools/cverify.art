import ./"../src/cbackend.art"
verify: function [path num][
    out: "/tmp/cv" ++ num
    compileToNativeC (read path) out
    native: execute (out ++ " 2>&1")
    host: execute ("arturo --no-color " ++ path ++ " 2>&1")
    match: (native = host)
    print [(match ? "PASS" : "FAIL") path]
    if not? match [
        print ["  native:" native]
        print ["  host:  " host]
    ]
]
verify "corpus/05_functions.art" "05"
verify "corpus/06_if.art" "06"
verify "corpus/13_while.art" "13"
verify "corpus/27_call.art" "27"
