; build the self-contained compiler as a NATIVE CLI: reads an .art input and
; an output path, compiles the input to a native binary via the C backend.
; The host runs this once (the oracle step); the resulting `tmp/ncomp` is the
; self-hosting native compiler.
;
; `args` the builtin is shadowed once the frontend sees `args: n\args` in the
; C backend's cCall/cFunction/cIf (a deliberate hygiene rename to
; `_shadow_args`). The MAIN is compiled last, so its `args` word would become a
; load of the unbound `_shadow_args` and crash. Capture the command line in a
; helper that is compiled FIRST, before the shadowing fires.
import ./"../src/cbackend.art"

PRE: "cliArgs: function [][ args\\values ]\n"

buildSelfCompiler: function [][
    out: @[PRE]
    files: ["intrinsics.art" "semantics.art" "front.art" "kernel.art" "ir.art" "backend.art" "cbackend.art"]
    loop files [f][
        src: read ("src/" ++ f)
        loop files [g][ src: replace src ("import ./\"" ++ g ++ "\"\n") "" ]
        addItem out src
    ]
    joinWith out "\n"
]
NMAIN: "\nvals: cliArgs\nif 1 < size vals [\n    inPath: vals\\0\n    outPath: vals\\1\n    src: read inPath\n    compileToNativeC src outPath\n    print \"compiled: \" ++ outPath\n]\n"
doit: function [src outName][ compileToNativeC src outName ]
src: buildSelfCompiler ++ NMAIN
write src "tmp/ncomp_src.art"
print "source bytes: " ++ (to :string (size src))
doit src "tmp/ncomp"
print "built"
