import ./"../src/ir.art"
import ./"../src/front.art"
zzprobe: function [path][
    ir: fold (compileToIR (read path))
    loop ir [n][
        if and? :dictionary = type n "call" = n\op [
            if and? :dictionary = type n\fn "intrinsic" = n\fn\op [
                if "loop" = n\fn\name [
                    act: n\args\2
                    print "=== ACTION BLOCK ITEMS ==="
                    loop act\items [i][ print (to :string (type i)) ++ "  " ++ (to :string i) ]
                ]
            ]
        ]
    ]
]
zzprobe (args\values\0)
