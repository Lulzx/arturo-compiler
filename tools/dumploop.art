import ./"../src/ir.art"
import ./"../src/front.art"
zzprobe: function [path][
    ir: fold (compileToIR (read path))
    loop ir [n][
        if and? :dictionary = type n "call" = n\op [
            if and? :dictionary = type n\fn "intrinsic" = n\fn\op [
                if "loop" = n\fn\name [
                    act: n\args\2
                    print "ACTION ITEMS (" ++ (to :string (size act\items)) ++ "):"
                    loop act\items [i][
                        print "  type=" ++ (to :string (type i))
                    ]
                ]
            ]
        ]
    ]
]
zzprobe "tmp/oracle/o1.art"
